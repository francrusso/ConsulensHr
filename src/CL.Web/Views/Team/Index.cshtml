@model OrganigrammaViewModel
@{
    ViewData["Title"] = "Team";
    // Ricerca per nome del team o di una persona che ne fa parte.
    var q = ViewBag.Ricerca as string;
    bool Corrisponde(CL.Domain.Organizzazione.Team t) => string.IsNullOrEmpty(q)
        || t.Nome.Contains(q, StringComparison.CurrentCultureIgnoreCase)
        || Model.Dipendenti.Any(d => d.TeamId == t.Id && d.Nome.Contains(q, StringComparison.CurrentCultureIgnoreCase));
    var elenco = Model.Albero().Where(x => Corrisponde(x.Team)).ToList();
    // Foto della persona o, se manca, l'immagine segnaposto scelta per lei.
    string? Avatar(MembroTeam m) => m.HaFoto ? Url.Action("Foto", "Dipendenti", new { id = m.Id }) : Url.Content($"~/assets/images/avatar/{m.Segnaposto}.png");
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        @if (Model.PerConto)
        {
            <a asp-controller="Aziende" asp-action="Dettaglio" asp-route-id="@Model.AziendaId" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @Model.Azienda</a>
        }
        <h1 class="titolo-pagina mb-0">Team</h1>
    </div>
</div>

<form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
    @if (Model.PerConto) { <input type="hidden" name="aziendaId" value="@Model.AziendaId" /> }
    <div class="invoice-filter-toolbar">
        <div class="invoice-filter-client">
            <div class="input-group">
                <span class="input-group-text"><i class="ri-search-line" aria-hidden="true"></i></span>
                <input type="search" name="q" value="@q" class="form-control" placeholder="Cerca per nome del team o della persona" aria-label="Cerca per nome del team o della persona" />
            </div>
        </div>
        <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
    </div>
</form>
<partial name="_ChipRicerca" />

<div class="collapse mb-3" id="nuovoTeam">
    <section class="card radius-15 p-3 p-md-4" aria-label="Nuovo team"><partial name="_FormTeam" model="(Model, (CL.Domain.Organizzazione.Team?)null)" /></section>
</div>

<div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th scope="col">Team</th>
                <th scope="col">Dentro il team</th>
                <th scope="col">Responsabile</th>
                <th scope="col">Membri</th>
                <th scope="col">In presenza</th>
                <th scope="col">Da remoto</th>
                <th scope="col" class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @if (elenco.Count == 0)
            {
                <tr><td colspan="7" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-team-line"></i></span><div>@(Model.Team.Count == 0 ? "Nessun team: crea il primo con \"Nuovo team\"" : "Nessun team trovato")</div></td></tr>
            }
            @foreach (var (t, livello) in elenco)
            {
                var membri = Model.Dipendenti.Where(d => d.TeamId == t.Id).ToList();
                var padre = t.PadreId is { } p ? Model.Team.FirstOrDefault(x => x.Id == p) : null;
                <tr>
                    <td data-label="Team">
                        <a asp-action="Dettaglio" asp-route-id="@t.Id" class="team-elenco nome-team" style="padding-left:@(Math.Min(livello, 4) * 18)px">
                            @if (livello > 0) { <i class="ri-corner-down-right-line text-body-secondary" aria-hidden="true"></i> }
                            <span class="org-pallino" style="--colore-team:@Model.ColoreDi(t)" aria-hidden="true"></span>
                            @if (t.Emoji is not null) { <span aria-hidden="true">@t.Emoji</span> }
                            <span>@t.Nome</span>
                        </a>
                    </td>
                    <td data-label="Dentro il team">@(padre?.Nome ?? "—")</td>
                    <td data-label="Responsabile">
                        @if (t.ResponsabileId is { } rid && Model.Dipendenti.FirstOrDefault(d => d.Id == rid) is { } resp)
                        {
                            <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@resp.Id" class="customer-name">
                                <img class="avatar-elenco" src="@Avatar(resp)" alt="" loading="lazy" />
                                <span>@resp.Nome</span>
                            </a>
                        }
                        else { <span class="text-body-secondary">—</span> }
                    </td>
                    <td data-label="Membri">
                        @* Foto sovrapposte (al massimo 5) e numero dei membri. *@
                        <div class="membri-team">
                            @if (membri.Count > 0)
                            {
                                <div class="avatar-sovrapposti" aria-hidden="true">
                                    @foreach (var m in membri.Take(5))
                                    {
                                        <img src="@Avatar(m)" alt="" title="@m.Nome" loading="lazy" />
                                    }
                                    @if (membri.Count > 5) { <span class="avatar-altri">+@(membri.Count - 5)</span> }
                                </div>
                            }
                            <span class="numero-membri">@membri.Count</span>
                        </div>
                    </td>
                    @foreach (var (etichetta, gruppo) in new[] { ("In presenza", membri.Where(m => m.InForza && !m.Remoto).ToList()), ("Da remoto", membri.Where(m => m.InForza && m.Remoto).ToList()) })
                    {
                        <td data-label="@etichetta">
                            @* Chi lavora in sede e chi in smart working, ibrido o full-remote (dal contratto): numero e foto. *@
                            <div class="membri-team" title="@string.Join(", ", gruppo.Select(m => m.Nome))">
                                @if (gruppo.Count > 0)
                                {
                                    <div class="avatar-sovrapposti" aria-hidden="true">
                                        @foreach (var m in gruppo.Take(4))
                                        {
                                            <img src="@Avatar(m)" alt="" loading="lazy" />
                                        }
                                        @if (gruppo.Count > 4) { <span class="avatar-altri">+@(gruppo.Count - 4)</span> }
                                    </div>
                                }
                                <span class="numero-membri">@gruppo.Count</span>
                            </div>
                        </td>
                    }
                    <td data-label="Azioni">
                        <div class="customer-actions">
                            <a asp-action="Dettaglio" asp-route-id="@t.Id" title="Apri" aria-label="Apri il team @t.Nome"><i class="ri-eye-line" aria-hidden="true"></i></a>
                            <a asp-action="Dettaglio" asp-route-id="@t.Id" asp-route-modifica="true" title="Modifica" aria-label="Modifica il team @t.Nome"><i class="ri-pencil-line" aria-hidden="true"></i></a>
                            <form asp-action="Elimina" method="post" class="m-0" onsubmit="return confirm('Eliminare il team @t.Nome?');">
                                <input type="hidden" name="aziendaId" value="@Model.AziendaId" /><input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" title="Elimina" aria-label="Elimina il team @t.Nome"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ScriptTeam" />
}
