@model (CL.Web.Controllers.OrganigrammaViewModel Vm, CL.Domain.Organizzazione.Team? Team)
@{
    var (vm, team) = Model;
    var chiave = team?.Id.ToString("N") ?? "nuovo";
    var coloreAttuale = team?.Colore;
    var emojiSuggerite = new[] { "🏢", "💼", "🛒", "📦", "🧾", "💻", "🎨", "📣", "🔧", "🚚", "🧪", "🍽️", "🏭", "🤝", "📊", "⭐" };
}
<form asp-action="Salva" method="post" class="row g-2 align-items-end form-team">
    <input type="hidden" name="aziendaId" value="@vm.AziendaId" />
    @if (team is not null) { <input type="hidden" name="id" value="@team.Id" /> }
    <div class="col-md-4">
        <label class="form-label small" for="nome-@chiave">Nome del team</label>
        <input class="form-control" id="nome-@chiave" name="nome" value="@team?.Nome" maxlength="100" required placeholder="es. Vendite" />
    </div>
    <div class="col-md-3">
        <label class="form-label small" for="padre-@chiave">Dentro il team</label>
        <select class="form-select" id="padre-@chiave" name="padreId" data-nascondi-colore="colore-@chiave">
            <option value="">— (primo livello)</option>
            @foreach (var (t, livello) in vm.Albero().Where(x => x.Team.Id != team?.Id))
            {
                <option value="@t.Id" selected="@(t.Id == team?.PadreId)">@(livello > 0 ? new string('—', livello) + " " : "")@t.Nome</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small" for="resp-@chiave">Responsabile</label>
        <select class="form-select" id="resp-@chiave" name="responsabileId">
            <option value="">Nessuno</option>
            @foreach (var d in vm.Dipendenti.Where(d => d.InForza)) { <option value="@d.Id" selected="@(d.Id == team?.ResponsabileId)">@d.Nome</option> }
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">@(team is null ? "Crea" : "Salva")</button></div>

    @* I sotto-team prendono il colore del team madre, più chiaro: la scelta serve solo al primo livello. *@
    <fieldset class="col-12 mt-3" id="colore-@chiave" hidden="@(team?.PadreId is not null)">
        <legend class="form-label small mb-1">Colore</legend>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @foreach (var (nome, hex) in CL.Domain.Organizzazione.Team.Palette)
            {
                var scelto = string.Equals(hex, coloreAttuale, StringComparison.OrdinalIgnoreCase);
                <label class="campione-colore" style="--colore-team:@hex" title="@nome">
                    <input type="radio" name="colore" value="@hex" checked="@scelto" class="visually-hidden" />
                    <span aria-hidden="true"></span><span class="visually-hidden">@nome</span>
                </label>
            }
            <label class="small d-inline-flex align-items-center gap-1 ms-1" title="Colore personalizzato">
                <input type="color" class="form-control form-control-color colore-libero" value="@(coloreAttuale ?? CL.Domain.Organizzazione.Team.ColorePredefinito)" aria-label="Colore personalizzato" />
                altro
            </label>
        </div>
    </fieldset>
    <fieldset class="col-12 mt-3">
        <legend class="form-label small mb-1">Emoji <span class="text-body-secondary">(facoltativa)</span></legend>
        @* Griglia di emoji pronte: un clic per sceglierla; "altra" per incollarne una diversa. *@
        <input type="hidden" name="emoji" value="@team?.Emoji" class="campo-emoji" />
        <div class="scelta-emoji" role="group" aria-label="Emoji del team">
            <button type="button" class="tessera-emoji nessuna @(string.IsNullOrEmpty(team?.Emoji) ? "attiva" : "")" data-emoji="" title="Nessuna emoji" aria-label="Nessuna emoji"><i class="ri-forbid-line" aria-hidden="true"></i></button>
            @foreach (var e in emojiSuggerite)
            {
                <button type="button" class="tessera-emoji @(e == team?.Emoji ? "attiva" : "")" data-emoji="@e" aria-label="Usa @e">@e</button>
            }
            <input type="text" class="tessera-emoji altra-emoji @(!string.IsNullOrEmpty(team?.Emoji) && !emojiSuggerite.Contains(team!.Emoji) ? "attiva" : "")"
                   value="@(!string.IsNullOrEmpty(team?.Emoji) && !emojiSuggerite.Contains(team!.Emoji) ? team.Emoji : "")" maxlength="16" placeholder="altra" aria-label="Altra emoji" autocomplete="off" />
        </div>
    </fieldset>
</form>
