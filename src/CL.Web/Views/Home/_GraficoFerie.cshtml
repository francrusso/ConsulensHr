@model (List<FerieDipendente> Righe, int Anno, bool MostraAzienda)
@*
    Barre orizzontali impilate (ApexCharts): ore di ferie godute e disponibili per dipendente in forza,
    ordinate per ore disponibili. Le prime 15 nel grafico, tutte nella tabella. Clic su una barra = scheda del dipendente.
*@
@{
    var (righe, anno, mostraAzienda) = Model;
    var visibili = righe.Take(15).ToList();
    var dati = new
    {
        nomi = visibili.Select(r => r.Nome).ToArray(),
        aziende = visibili.Select(r => r.Azienda).ToArray(),
        link = visibili.Select(r => Url.Action("Dettaglio", "Dipendenti", new { id = r.DipendenteId })).ToArray(),
        inAttesa = visibili.Select(r => (double)Math.Round(r.InAttesa, 1)).ToArray(),
        mostraAzienda,
        serie = new[]
        {
            new { name = "Godute", data = visibili.Select(r => (double)Math.Round(r.Godute, 1)).ToArray() },
            new { name = "Disponibili", data = visibili.Select(r => (double)Math.Round(r.Disponibili, 1)).ToArray() },
        },
    };
    string H(decimal v) => v.ToString("0.#");
}
<figure class="card radius-15 p-4 h-100 grafico mb-0">
    <figcaption class="mb-2">
        <h2 class="h6 mb-1">Ferie @anno per dipendente</h2>
        <p class="small text-body-secondary mb-0">Ore godute e ore ancora disponibili (maturate a oggi, più il residuo dell'anno precedente). In alto chi ha più ferie da smaltire.</p>
    </figcaption>
    @if (visibili.Count == 0)
    {
        <p class="text-body-secondary small mb-0 py-4 text-center">Nessun dipendente in forza.</p>
    }
    else
    {
        <div id="graficoFerie" role="img" aria-label="Grafico a barre delle ferie godute e disponibili per dipendente; i valori sono nella tabella sotto"></div>
        <script type="application/json" id="datiGraficoFerie">@Json.Serialize(dati)</script>
        @if (righe.Count > visibili.Count) { <p class="small text-body-secondary mb-0">e altri @(righe.Count - visibili.Count) dipendenti, nella tabella.</p> }
    }
    <details class="mt-2 tabella-grafico">
        <summary class="small">Mostra i dati in tabella</summary>
        <div class="table-responsive mt-2">
            <table class="table table-sm mb-0">
                <thead><tr><th scope="col">Dipendente</th>@if (mostraAzienda) { <th scope="col">Azienda</th> }<th scope="col" class="text-end">Godute (h)</th><th scope="col" class="text-end">Disponibili (h)</th><th scope="col" class="text-end">In attesa (h)</th></tr></thead>
                <tbody>
                    @foreach (var r in righe)
                    {
                        <tr><th scope="row" class="fw-normal"><a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@r.DipendenteId">@r.Nome</a></th>@if (mostraAzienda) { <td>@r.Azienda</td> }<td class="text-end">@H(r.Godute)</td><td class="text-end">@H(r.Disponibili)</td><td class="text-end">@H(r.InAttesa)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</figure>
