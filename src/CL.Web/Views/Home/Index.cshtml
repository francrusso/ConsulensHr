@model DatiPanoramica
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Panoramica";
    string H(decimal v) => v.ToString("#,0");
    var (consegnati, pubblicati) = Model.Cedolini;
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">Ciao, @Utente.Nome</h1>
    @if (Model.Aziende is not null)
    {
        <form asp-action="Index" method="get" class="m-0">
            <label for="filtroAzienda" class="visually-hidden">Azienda</label>
            <select id="filtroAzienda" name="aziendaId" class="form-select" onchange="this.form.submit()">
                <option value="">Tutte le aziende</option>
                @foreach (var a in Model.Aziende) { <option value="@a.Value" selected="@a.Selected">@a.Text</option> }
            </select>
            <noscript><button type="submit" class="btn btn-outline-secondary">Filtra</button></noscript>
        </form>
    }
</div>

<div class="row g-3 mb-3">
    @if (Utente.IsConsulente && Model.AziendaId is null)
    {
        <partial name="_Indicatore" model='("Aziende attive", Model.AziendeAttive.ToString(), "ri-building-line", Url.Action("Index", "Aziende"), (string?)null)' />
    }
    <partial name="_Indicatore" model='("Dipendenti in forza", Model.DipendentiInForza.ToString(), "ri-team-line", Url.Action("Index", "Dipendenti"), (string?)null)' />
    <partial name="_Indicatore" model='(Utente.IsConsulente ? "Richieste in attesa delle aziende" : "Richieste da approvare", Model.RichiesteInAttesa.ToString(), "ri-calendar-check-line", Url.Action("Index", "Assenze"), (string?)null)' />
    @if (Model.Presenze is { } p)
    {
        <partial name="_Indicatore" model='("Presenze di " + ServizioBustePaga.NomeMese(p.Item4).ToLower(), $"{p.Item1} su {p.Item2}", "ri-time-line", Url.Action("Index", "Presenze", new { anno = p.Item3, mese = p.Item4 }), "aziende hanno inviato")' />
    }
    else
    {
        <partial name="_Indicatore" model='("Ferie disponibili " + Model.Anno, H(Model.FerieDisponibili) + " h", "ri-sun-line", (string?)null, $"{H(Model.FerieGoduteAnno)} h già godute")' />
    }
    <partial name="_Indicatore" model='("Cedolini consegnati", pubblicati == 0 ? "—" : $"{consegnati * 100 / pubblicati}%", "ri-file-list-3-line", Url.Action("Index", "BustePaga"), pubblicati == 0 ? "nessuno negli ultimi 3 mesi" : $"{consegnati} di {pubblicati} aperti, ultimi 3 mesi")' />
</div>

<div class="row g-3">
    <div class="col-xl-7"><partial name="_GraficoAssenze" model="Model.AssenzePerMese" /></div>
    <div class="col-xl-5"><partial name="_GraficoFerie" model="(Model.FeriePerDipendente, Model.Anno, Utente.IsConsulente && Model.AziendaId is null)" /></div>
</div>

@section Scripts {
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script src="~/js/grafici-panoramica.js" asp-append-version="true"></script>
}
