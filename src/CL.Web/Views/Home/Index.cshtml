@model CL.Web.Controllers.PanoramicaViewModel
@inject CL.Web.Infrastruttura.UtenteCorrente Utente
@{
    ViewData["Title"] = "Panoramica";
}

<div class="breadcrumb-titolo">
    <h1 class="titolo-pagina mb-3">Ciao, @Utente.Nome</h1>
</div>

@if (Utente.IsConsulente || Utente.IsAzienda)
{
    <div class="row g-3">
        @if (Utente.IsConsulente)
        {
            <div class="col-sm-6 col-xl-4">
                <a asp-controller="Aziende" asp-action="Index" class="card radius-15 h-100 text-decoration-none">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="ri-building-line ri-2x icona-card" aria-hidden="true"></i>
                        <div>
                            <div class="etichetta mb-1">Aziende attive</div>
                            <div class="card-numero">@Model.Aziende</div>
                        </div>
                    </div>
                </a>
            </div>
        }
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Dipendenti" asp-action="Index" class="card radius-15 h-100 text-decoration-none">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="ri-team-line ri-2x icona-card" aria-hidden="true"></i>
                    <div>
                        <div class="etichetta mb-1">Dipendenti in forza</div>
                        <div class="card-numero">@Model.DipendentiInForza</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Assenze" asp-action="Index" class="card radius-15 h-100 text-decoration-none">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="ri-calendar-check-line ri-2x icona-card" aria-hidden="true"></i>
                    <div>
                        <div class="etichetta mb-1">Richieste di assenza da approvare</div>
                        <div class="card-numero">@Model.RichiesteInAttesa</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
}
else
{
    <div class="card radius-15 p-4">
        <p class="mb-3">Da qui puoi richiedere ferie e permessi e controllare i tuoi saldi. A breve troverai anche le buste paga.</p>
        <div><a asp-controller="Assenze" asp-action="Index" class="btn btn-primary"><i class="ri-calendar-event-line" aria-hidden="true"></i> Le mie ferie e permessi</a></div>
    </div>
}
