@model DatiPanoramica
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Panoramica";
    string H(decimal v) => v.ToString("#,0");
    var (consegnati, pubblicati) = Model.Cedolini;
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">Ciao, @Utente.Nome</h1>
    @if (Model.Aziende is not null)
    {
        <form asp-action="Index" method="get" class="m-0">
            <label for="filtroAzienda" class="visually-hidden">Azienda</label>
            <select id="filtroAzienda" name="aziendaId" class="form-select" onchange="this.form.submit()">
                <option value="">Tutte le aziende</option>
                @foreach (var a in Model.Aziende) { <option value="@a.Value" selected="@a.Selected">@a.Text</option> }
            </select>
            <noscript><button type="submit" class="btn btn-outline-secondary">Filtra</button></noscript>
        </form>
    }
</div>

@if (Model.DaFare.Count > 0) { <partial name="_DaFare" model="Model.DaFare" /> }

<div class="row g-3 mb-3">
    @if (Utente.IsConsulente && Model.AziendaId is null)
    {
        <partial name="_Indicatore" model='("Aziende attive", Model.AziendeAttive.ToString(), "ri-building-line", Url.Action("Index", "Aziende"), (string?)null)' />
    }
    <partial name="_Indicatore" model='("Personale in forza", Model.DipendentiInForza.ToString(), "ri-team-line", Url.Action("Index", "Dipendenti"), (string?)null)' />
    <partial name="_Indicatore" model='(Utente.IsConsulente ? "Richieste in attesa delle aziende" : "Richieste da approvare", Model.RichiesteInAttesa.ToString(), "ri-calendar-check-line", Url.Action("Index", "Assenze"), (string?)null)' />
    @if (Model.Presenze is { } p)
    {
        <partial name="_Indicatore" model='("Presenze di " + ServizioBustePaga.NomeMese(p.Item4).ToLower(), $"{p.Item1} su {p.Item2}", "ri-time-line", Url.Action("Index", "Presenze", new { anno = p.Item3, mese = p.Item4 }), "aziende hanno inviato")' />
    }
    else
    {
        <partial name="_Indicatore" model='("Ferie disponibili " + Model.Anno, H(Model.FerieDisponibili) + " h", "ri-sun-line", (string?)null, $"{H(Model.FerieGoduteAnno)} h già godute")' />
    }
    <partial name="_Indicatore" model='("Cedolini consegnati", pubblicati == 0 ? "—" : $"{consegnati * 100 / pubblicati}%", "ri-file-list-3-line", Url.Action("Index", "BustePaga"), pubblicati == 0 ? "nessuno negli ultimi 3 mesi" : $"{consegnati} di {pubblicati} aperti, ultimi 3 mesi")' />
</div>

@if (Model.Oggi is { } oggi)
{
    var ritorno = Context.Request.Path + Context.Request.QueryString;
    <div class="row g-3 mb-3">
        @* Chi c'è oggi: in ufficio, da remoto e assenti. *@
        <section class="col-xl-7" aria-labelledby="titoloOggi">
            <div class="card radius-15 p-4 h-100 card-panoramica">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="titolo-card-panoramica mb-0" id="titoloOggi"><i class="ri-sun-line" aria-hidden="true"></i> @(oggi.EOggi ? "Oggi" : "Prossimo giorno lavorativo") · @oggi.Giorno.ToString("dddd d MMMM")</h2>
                    <a asp-controller="Assenze" asp-action="Calendario" asp-route-aziendaId="@Model.AziendaId" class="small">Apri il calendario <i class="ri-arrow-right-s-line" aria-hidden="true"></i></a>
                </div>
                <div class="gruppi-oggi">
                    @foreach (var (titolo, icona, colore, persone) in new[]
                    {
                        ("In ufficio", "ri-building-line", "#2FBA6C", oggi.InUfficio),
                        ("Da remoto", "ri-home-wifi-line", "#7C9CD6", oggi.DaRemoto),
                        ("Assenti", "ri-user-unfollow-line", "#F08A4B", oggi.Assenti),
                    })
                    {
                        <div class="gruppo-oggi" style="--colore-gruppo:@colore">
                            <div class="intestazione-gruppo"><i class="@icona" aria-hidden="true"></i> @titolo <span class="numero-gruppo">@persone.Count</span></div>
                            @if (persone.Count == 0) { <div class="small text-body-secondary">Nessuno</div> }
                            <ul class="persone-oggi">
                                @foreach (var persona in persone.Take(6))
                                {
                                    <li>
                                        <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@persona.Id" class="customer-name">
                                            <img class="avatar-elenco" src="@(persona.HaFoto ? Url.Action("Foto", "Dipendenti", new { id = persona.Id }) : Url.Content($"~/assets/images/avatar/{persona.Segnaposto}.png"))" alt="" loading="lazy" />
                                            <span class="text-truncate">@persona.Nome</span>
                                        </a>
                                        @if (persona.Dettaglio is not null) { <span class="dettaglio-oggi">@persona.Dettaglio</span> }
                                    </li>
                                }
                            </ul>
                            @if (persone.Count > 6) { <div class="small text-body-secondary">e altri @(persone.Count - 6)</div> }
                        </div>
                    }
                </div>
            </div>
        </section>

        @* Richieste in attesa: il referente approva da qui, il resto nella pagina Richieste. *@
        <section class="col-xl-5" aria-labelledby="titoloAttesa">
            <div class="card radius-15 p-4 h-100 card-panoramica @(Model.RichiesteInAttesa > 0 ? "card-avviso" : "card-ok")">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="titolo-card-panoramica mb-0" id="titoloAttesa"><i class="ri-calendar-check-line" aria-hidden="true"></i> @(Utente.IsConsulente ? "In attesa delle aziende" : "Da approvare") <span class="numero-gruppo">@Model.RichiesteInAttesa</span></h2>
                    <a asp-controller="Assenze" asp-action="Index" asp-route-stato="InAttesa" asp-route-aziendaId="@Model.AziendaId" class="small">Tutte le richieste <i class="ri-arrow-right-s-line" aria-hidden="true"></i></a>
                </div>
                @if (Model.DaApprovare.Count == 0)
                {
                    <partial name="_CardVuota" model='"Nessuna richiesta in attesa"' />
                }
                <ul class="elenco-panoramica">
                    @foreach (var r in Model.DaApprovare)
                    {
                        <li>
                            <img class="avatar-elenco" src="@(r.Persona.HaFoto ? Url.Action("Foto", "Dipendenti", new { id = r.Persona.Id }) : Url.Content($"~/assets/images/avatar/{r.Persona.Segnaposto}.png"))" alt="" loading="lazy" />
                            <div class="flex-grow-1 min-w-0">
                                <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@r.Persona.Id" class="nome-panoramica">@r.Persona.Nome</a>
                                <div class="small text-body-secondary">
                                    @r.Tipo ·
                                    @if (r.Dal == r.Al) { @r.Dal.ToString("ddd d MMM") } else { @($"{r.Dal:d MMM} – {r.Al:d MMM}") }
                                    @if (r.AOre) { @($" · {r.Ore:0.##} h") }
                                </div>
                            </div>
                            @if (Utente.IsAzienda)
                            {
                                <form asp-controller="Assenze" asp-action="@(r.SmartWorking ? "DecidiSmartWorking" : r.Straordinario ? "DecidiStraordinario" : "Approva")" asp-route-id="@r.Id" asp-route-approva="@(r.SmartWorking || r.Straordinario ? "true" : null)" method="post" class="m-0">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" class="btn btn-sm btn-primary">Approva</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12"><partial name="_GraficoAssenze" model="Model.AssenzePerMese" /></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-7"><partial name="_GraficoFerie" model="(Model.FeriePerDipendente, Model.Anno, Utente.IsConsulente && Model.AziendaId is null)" /></div>
    @* Contratti a termine in scadenza nei prossimi 60 giorni. *@
    <section class="col-xl-5" aria-labelledby="titoloScadenze">
        <div class="card radius-15 p-4 h-100 card-panoramica">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="titolo-card-panoramica mb-0" id="titoloScadenze"><i class="ri-file-warning-line" aria-hidden="true"></i> Contratti in scadenza <span class="numero-gruppo">@Model.Scadenze.Count</span></h2>
                <span class="small text-body-secondary">prossimi 60 giorni</span>
            </div>
            @if (Model.Scadenze.Count == 0)
            {
                <partial name="_CardVuota" model='"Nessun contratto in scadenza"' />
            }
            <ul class="elenco-panoramica">
                @foreach (var sc in Model.Scadenze.Take(8))
                {
                    <li>
                        <img class="avatar-elenco" src="@(sc.Persona.HaFoto ? Url.Action("Foto", "Dipendenti", new { id = sc.Persona.Id }) : Url.Content($"~/assets/images/avatar/{sc.Persona.Segnaposto}.png"))" alt="" loading="lazy" />
                        <div class="flex-grow-1 min-w-0">
                            <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@sc.Persona.Id" asp-route-sezione="contratto" class="nome-panoramica">@sc.Persona.Nome</a>
                            <div class="small text-body-secondary">@sc.Tipo · scade il @sc.DataFine.ToString("dd/MM/yyyy")</div>
                        </div>
                        <span class="giorni-scadenza @(sc.Giorni <= 15 ? "vicina" : "")">@(sc.Giorni == 0 ? "oggi" : sc.Giorni == 1 ? "domani" : $"tra {sc.Giorni} giorni")</span>
                    </li>
                }
            </ul>
        </div>
    </section>
</div>

<partial name="_CalendarioScadenze" model="(Model.Eventi, Model.DataOggi)" />

@section Scripts {
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script src="~/js/grafici-panoramica.js" asp-append-version="true"></script>
}
