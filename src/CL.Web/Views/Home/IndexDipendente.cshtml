@inject UtenteCorrente Utente
@*
    Benvenuto per un accesso da dipendente non ancora collegato a una persona (chi è collegato va al suo calendario):
    nessun dato da mostrare, solo le voci vuote e il pulsante per le richieste.
*@
@{ ViewData["Title"] = "Panoramica"; }
<div class="breadcrumb-titolo mb-3"><h1 class="titolo-pagina mb-0">Ciao, @Utente.Nome</h1></div>

<div class="row g-3 mt-1">
    <partial name="_Indicatore" model='("Dove lavoro", "Non inserito", "ri-building-line", (string?)null, (string?)null)' />
    <partial name="_Indicatore" model='("Mie richieste in attesa", "0", "ri-calendar-event-line", Url.Action("Index", "Assenze"), (string?)"in attesa di approvazione")' />
    <partial name="_Indicatore" model='("Ultima busta paga", "—", "ri-file-list-3-line", Url.Action("Index", "BustePaga"), (string?)"nessuna ancora pubblicata")' />
    <div class="col-sm-6 col-xl d-flex align-items-center">
        <a asp-controller="Assenze" asp-action="Nuova" class="btn btn-primary w-100"><i class="ri-calendar-event-line" aria-hidden="true"></i> Chiedi ferie o permessi</a>
    </div>
</div>
