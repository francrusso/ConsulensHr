@model List<MeseAssenze>
@*
    Colonne impilate (ApexCharts): ore di assenza approvate per mese, per tipo.
    I dati arrivano in un blocco JSON; legenda, tooltip e tabella dei valori sempre disponibili.
*@
@{
    var serie = new (string Nome, Func<AssenzeDelMese, decimal> Valore)[]
    {
        ("Ferie", a => a.Ferie),
        ("Malattia", a => a.Malattia),
        ("ROL e permessi", a => a.Rol),
        ("Altre assenze", a => a.Altre),
    };
    var vuoto = Model.All(m => m.Ore.Totale == 0);
    var dati = new
    {
        mesi = Model.Select(m => m.Etichetta).ToArray(),
        periodi = Model.Select(m => m.Periodo).ToArray(),
        serie = serie.Select(s => new { name = s.Nome, data = Model.Select(m => (double)Math.Round(s.Valore(m.Ore), 1)).ToArray() }).ToArray(),
    };
}
<figure class="card radius-15 p-4 h-100 grafico mb-0">
    <figcaption class="mb-2">
        <h2 class="titolo-card-panoramica mb-0 d-flex align-items-center justify-content-between w-100"><span>Assenze negli ultimi 12 mesi</span>
            <i class="ri-information-line info-grafico" tabindex="0" title="Ore di assenza approvate per mese; le assenze a cavallo di due mesi sono ripartite sui giorni lavorativi." aria-label="Ore di assenza approvate per mese; le assenze a cavallo di due mesi sono ripartite sui giorni lavorativi."></i></h2>
    </figcaption>
    @if (vuoto)
    {
        <partial name="_GraficoVuoto" model="Model.Select(m => m.Etichetta).ToArray()" />
    }
    else
    {
        <div id="graficoAssenze" role="img" aria-label="Grafico a colonne delle ore di assenza per mese"></div>
        <script type="application/json" id="datiGraficoAssenze">@Json.Serialize(dati)</script>
    }
</figure>
