@model List<MeseAssenze>
@*
    Colonne impilate (ApexCharts): ore di assenza approvate per mese, per tipo.
    I dati arrivano in un blocco JSON; legenda, tooltip e tabella dei valori sempre disponibili.
*@
@{
    var serie = new (string Nome, Func<AssenzeDelMese, decimal> Valore)[]
    {
        ("Ferie", a => a.Ferie),
        ("Malattia", a => a.Malattia),
        ("ROL e permessi", a => a.Rol + a.ExFestivita),
        ("Altre assenze", a => a.Altre),
    };
    var vuoto = Model.All(m => m.Ore.Totale == 0);
    var dati = new
    {
        mesi = Model.Select(m => m.Etichetta).ToArray(),
        periodi = Model.Select(m => m.Periodo).ToArray(),
        serie = serie.Select(s => new { name = s.Nome, data = Model.Select(m => (double)Math.Round(s.Valore(m.Ore), 1)).ToArray() }).ToArray(),
    };
    string H(decimal v) => v.ToString("0.#");
}
<figure class="card radius-15 p-4 h-100 grafico mb-0">
    <figcaption class="mb-2">
        <h2 class="h6 mb-1">Assenze negli ultimi 12 mesi</h2>
        <p class="small text-body-secondary mb-0">Ore di assenza approvate per mese; le assenze a cavallo di due mesi sono ripartite sui giorni lavorativi.</p>
    </figcaption>
    @if (vuoto)
    {
        <p class="text-body-secondary small mb-0 py-4 text-center">Nessuna assenza approvata negli ultimi 12 mesi.</p>
    }
    else
    {
        <div id="graficoAssenze" role="img" aria-label="Grafico a colonne delle ore di assenza per mese; i valori sono nella tabella sotto"></div>
        <script type="application/json" id="datiGraficoAssenze">@Json.Serialize(dati)</script>
    }
    <details class="mt-2 tabella-grafico">
        <summary class="small">Mostra i dati in tabella</summary>
        <div class="table-responsive mt-2">
            <table class="table table-sm mb-0">
                <thead><tr><th scope="col">Mese</th>@foreach (var s in serie) { <th scope="col" class="text-end">@s.Nome (h)</th> }<th scope="col" class="text-end">Totale (h)</th></tr></thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr><th scope="row" class="fw-normal">@m.Periodo</th>@foreach (var s in serie) { <td class="text-end">@H(s.Valore(m.Ore))</td> }<td class="text-end">@H(m.Ore.Totale)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</figure>
