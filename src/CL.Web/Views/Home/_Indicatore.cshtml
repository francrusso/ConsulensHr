@model (string Etichetta, string Valore, string Icona, string? Link, string? Nota)
@* Indicatore come nella dashboard: icona in un riquadro, etichetta in maiuscolo, valore grande. *@
@{ var (etichetta, valore, icona, link, nota) = Model; }
<div class="col-sm-6 col-xl">
    <a href="@(link ?? "#")" class="card radius-15 h-100 text-decoration-none indicatore @(link is null ? "pe-none" : "")">
        <div class="card-body d-flex align-items-center gap-3">
            <span class="icona-indicatore" aria-hidden="true"><i class="@icona"></i></span>
            <div class="min-w-0">
                <div class="etichetta-indicatore">@etichetta</div>
                <div class="valore-indicatore">@valore</div>
                @if (nota is not null) { <div class="nota-indicatore">@nota</div> }
            </div>
        </div>
    </a>
</div>
