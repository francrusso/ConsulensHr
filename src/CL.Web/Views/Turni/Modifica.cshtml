@model TurnoForm
@{ ViewData["Title"] = Model.Id is null ? "Nuovo turno" : "Modifica turno"; }
<h1 class="titolo-pagina mb-3">@ViewData["Title"]</h1>
<div class="card radius-15"><div class="card-body">
<form asp-action="Modifica" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" />
<div class="row g-3">
@if (Model.Id is null)
{
    <input type="hidden" name="Pianifica" value="true" />
    <div class="col-12 turni-selezione"><label asp-for="DipendentiIds" class="form-label">Dipendenti</label><select asp-for="DipendentiIds" asp-items="Model.Persone" multiple class="form-select" data-placeholder="Seleziona uno o più dipendenti" required></select></div>
    <div class="col-md-6"><label asp-for="Dal" class="form-label">Dal</label><input asp-for="Dal" type="date" class="form-control" required /></div>
    <div class="col-md-6"><label asp-for="Al" class="form-label">Al</label><input asp-for="Al" type="date" class="form-control" required /></div>
    <div class="col-12"><label asp-for="Personalizzato" class="form-label">Assegnazione</label><select asp-for="Personalizzato" class="form-select"><option value="false">Scegli un turno salvato</option><option value="true">Crea un turno personalizzato</option></select></div>
    <div class="col-12" id="daSalvati"><label asp-for="TurnoSalvatoId" class="form-label">Turno salvato</label><select asp-for="TurnoSalvatoId" class="form-select"><option value="">Seleziona turno</option>@foreach (var t in Model.Salvati) { <option value="@t.Id" data-azienda="@t.AziendaId">@t.Nome @(t.Ciclico ? "· Rotazione giornaliera" : $"· {t.Inizio:HH:mm} – {t.Fine:HH:mm}")</option> }</select><div id="riepilogoTurno" class="small text-muted mt-2"></div></div>
    <div class="col-12" id="personalizzato" hidden><div class="row g-3">
    <partial name="_GiorniTurno" model="Model.Giorni" />
    <div class="col-md-6"><label asp-for="OraInizio" class="form-label">Ora di inizio</label><input asp-for="OraInizio" type="time" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="OraFine" class="form-label">Ora di fine</label><input asp-for="OraFine" type="time" class="form-control" /></div>
    </div></div>
}
else
{
    <input asp-for="DipendenteId" type="hidden" />
    <div class="col-12"><label class="form-label">Dipendente</label><p>@Model.Persone.FirstOrDefault(x => x.Value == Model.DipendenteId.ToString())?.Text</p></div>
    @if (Model.Tipo != TipoGiornataTurno.Lavoro) { <div class="col-12"><span class="badge bg-light text-dark">@Model.Tipo</span></div> }
    <div class="col-md-6"><label asp-for="Inizio" class="form-label">Inizio</label><input asp-for="Inizio" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required /></div>
    <div class="col-md-6"><label asp-for="Fine" class="form-label">Fine</label><input asp-for="Fine" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required readonly="@(Model.Tipo != TipoGiornataTurno.Lavoro)" /></div>
}
<div class="col-12"><label asp-for="Note" class="form-label">Note per il dipendente</label><textarea asp-for="Note" class="form-control" rows="3" maxlength="500"></textarea></div>
</div>
<div class="d-flex gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Annulla</a><button type="submit" class="btn btn-primary">Salva turno</button></div>
</form></div></div>
@if (Model.Id is not null)
{ <form asp-action="Elimina" method="post" class="mt-3" onsubmit="return confirm('Eliminare questo turno?');"><input name="id" type="hidden" value="@Model.Id" /><button class="btn btn-outline-danger" type="submit">Elimina turno</button></form> }
@section Scripts {
<script>
(() => {
    const persone = document.getElementById('DipendentiIds'); if (!persone) return;
    if (window.jQuery && jQuery.fn.select2) jQuery(persone).select2({ width: '100%', placeholder: 'Seleziona uno o più dipendenti', closeOnSelect: false });
    const aziende = @Json.Serialize(Model.AziendePersone);
    const turni = @Json.Serialize(Model.Salvati.Select(t => new { id = t.Id, giorni = Enum.GetValues<DayOfWeek>().Where(t.Previsto).Select(g => System.Globalization.CultureInfo.GetCultureInfo("it-IT").DateTimeFormat.GetDayName(g)), fasi = t.Fasi.OrderBy(f => f.Ordine).Select(f => f.Tipo == TipoGiornataTurno.Lavoro ? $"{f.Nome} {f.Inizio:HH:mm}–{f.Fine:HH:mm}" : f.Nome), teamId = t.TeamId }));
    const modo = document.getElementById('Personalizzato'), salvato = document.getElementById('TurnoSalvatoId');
    function aggiorna() {
        const custom = modo.value === 'true';
        document.getElementById('personalizzato').hidden = !custom; document.getElementById('daSalvati').hidden = custom;
        const selezionati = Array.from(persone.selectedOptions).map(o => aziende[o.value]);
        Array.from(salvato.options).forEach(o => { if (o.value) o.disabled = o.hidden = selezionati.length > 0 && selezionati.some(a => a !== o.dataset.azienda); });
        if (salvato.selectedOptions[0]?.disabled) salvato.value = '';
        const t = turni.find(t => t.id === salvato.value);
        document.getElementById('riepilogoTurno').textContent = t ? t.giorni.join(', ') + (t.fasi.length ? ' · ' + t.fasi.join(' → ') : '') : '';
    }
    modo.addEventListener('change', aggiorna); salvato.addEventListener('change', aggiorna);
    persone.addEventListener('change', aggiorna); if (window.jQuery) jQuery(persone).on('change', aggiorna);
    aggiorna();
})();
</script>
}
