@model List<CL.Web.Infrastruttura.UtenteRiga>
@{
    ViewData["Title"] = "Referenti con accesso";
    var aziendaId = (Guid?)ViewBag.AziendaId;
}
<div class="breadcrumb-titolo mb-3">
    <div>
        <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
        <p class="text-body-secondary mb-0">Colleghi che gestiscono il personale della tua azienda. I dipendenti si invitano dalla loro scheda.</p>
    </div>
</div>
<section class="card radius-15 p-3 mb-3">
    <h2 class="h6 mb-2">Invita un collega</h2>
    <partial name="~/Views/Utenti/_FormInvito.cshtml" model='("InvitaReferente", aziendaId, "Invita")' />
</section>
<partial name="~/Views/Utenti/_TabellaAccessi.cshtml" model='(Model, Context.Request.Path.ToString(), false)' />
