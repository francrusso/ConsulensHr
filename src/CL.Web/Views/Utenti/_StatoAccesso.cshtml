@model StatoAccesso
@switch (Model)
{
    case StatoAccesso.Attivo: <span class="badge bg-success">Attivo</span> break;
    case StatoAccesso.InvitoInAttesa: <span class="badge bg-warning text-dark">Invito in attesa</span> break;
    default: <span class="badge bg-secondary">Disattivato</span> break;
}
