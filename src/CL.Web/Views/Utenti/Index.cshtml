@model CL.Web.Controllers.UtentiViewModel
@{
    ViewData["Title"] = "Utenti";
    var ritorno = Context.Request.Path + Context.Request.QueryString;
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
    @if (User.IsInRole(CL.Infrastructure.Identity.Ruoli.Amministratore))
    {
        <a asp-controller="Consulenti" asp-action="Index" class="btn btn-primary"><i class="ri-user-star-line" aria-hidden="true"></i> Gestisci i consulenti</a>
    }
</div>

<section class="card radius-15 p-3 mb-3 d-flex flex-row flex-wrap align-items-center justify-content-between gap-2">
    <div>
        <h2 class="h6 mb-1">Invio delle email</h2>
        @if (ViewBag.EmailConfigurata == true)
        {
            <p class="small mb-0"><span class="badge bg-success">Attivo</span> Inviti e link per la password partono in automatico.</p>
        }
        else
        {
            <p class="small mb-0"><span class="badge bg-secondary">Non configurato</span> Dopo ogni invito il link compare a schermo e lo mandi tu.</p>
        }
    </div>
    <form asp-action="EmailProva" method="post" class="m-0">
        <button type="submit" class="btn btn-outline-secondary"><i class="ri-mail-check-line" aria-hidden="true"></i> Invia un'email di prova a me</button>
    </form>
</section>


<section class="customer-directory">
    <form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
        <div class="invoice-filter-toolbar">
            <div class="invoice-filter-client">
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="ri-search-line" aria-hidden="true"></i></span>
                    <input type="text" name="q" class="form-control" placeholder="Cerca per nome, email o azienda" aria-label="Cerca utenti" value="@Model.Ricerca" />
                </div>
            </div>
            <div>
                <select name="ruolo" class="form-select" aria-label="Filtra per ruolo">
                    <option value="">Tutti i ruoli</option>
                    <option value="Consulente" selected="@(Model.Ruolo == "Consulente")">Consulenti</option>
                    <option value="Azienda" selected="@(Model.Ruolo == "Azienda")">Referenti azienda</option>
                    <option value="Dipendente" selected="@(Model.Ruolo == "Dipendente")">Personale</option>
                </select>
            </div>
            <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
        </div>
    </form>
    <partial name="_ChipRicerca" />

    <partial name="_TabellaAccessi" model="(Model.Utenti, ritorno, true)" />
</section>
