@model CL.Web.Controllers.ImpostazioniNotificheViewModel
@using CL.Domain.Notifiche
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Impostazioni notifiche";
    ViewData["Percorso"] = new List<(string Nome, string? Link)> { ("Notifiche", Url.Action("Index")) };
    var tutte = Model.Gruppi.SelectMany(g => g.Tipi).ToList();
    var emailAttive = tutte.Count(t => t.Email);
    var wa = Model.WhatsApp;
    var whatsAppAttive = wa.Collegato ? tutte.Count(t => t.WhatsApp) : 0;
    var daNumero = wa.Mittente is { } mittente ? $"dal numero Consulens {NumeroWhatsApp.Leggibile(mittente)}" : "dal numero di Consulens";
}
@*
    Come le impostazioni notifiche di ConsulensNew: canali di ricezione in alto, poi una scheda per sezione.
    Le notifiche in piattaforma sono sempre attive; email e WhatsApp si accendono e si spengono per tipologia e si
    salvano subito (js/notifiche.js). WhatsApp si attiva collegando il proprio numero (consenso + codice di verifica).
*@
<div class="impostazioni-notifiche" data-salva="@Url.Action("Scelta")">
    @Html.AntiForgeryToken()
    <h1 class="titolo-pagina mb-3">@ViewData["Title"]</h1>

    @if (Utente.IsConsulente && (!Model.EmailConfigurata || !wa.Disponibile))
    {
        <div class="alert alert-warning radius-15" role="status">
            <i class="ri-error-warning-line" aria-hidden="true"></i>
            @if (!Model.EmailConfigurata)
            {
                <span>L'invio delle email non è configurato sul server (<code>Email:Host</code> e <code>Email:Mittente</code>).</span>
            }
            @if (!wa.Disponibile)
            {
                <span>WhatsApp non è configurato sul server (<code>WhatsApp:PhoneNumberId</code> e <code>WhatsApp:Token</code>).</span>
            }
            Finché non lo sono, quei canali non inviano nulla.
        </div>
    }

    <section class="card radius-15 p-3" aria-labelledby="titolo-canali">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center">
                <i class="ri-notification-line icon-canale notifiche-canale-icona" aria-hidden="true"></i>
                <div class="ms-3">
                    <h2 class="titolo-sezione-notifiche mb-1" id="titolo-canali">Canali di ricezione</h2>
                    <p class="mb-0">
                        Le notifiche in piattaforma sono sempre attive.
                        @(wa.Disponibile ? "Per ogni tipologia scegli se ricevere anche l'email o un messaggio WhatsApp." : "Per ogni tipologia scegli se ricevere anche l'email.")
                    </p>
                </div>
            </div>
            <div class="canali-notifiche">
                <div class="card radius-15 card-canale attivo">
                    <div class="d-flex justify-content-between">
                        <i class="ri-computer-line icon-canale" aria-hidden="true"></i>
                        <div class="form-check form-switch m-0">
                            <input type="checkbox" class="form-check-input" role="switch" checked disabled aria-label="Notifiche in piattaforma: sempre attive" />
                        </div>
                    </div>
                    <h3 class="h6 fw-medium text-primary mb-0">In piattaforma</h3>
                    <span class="canale-stato">Sempre attive</span>
                </div>
                <div class="card radius-15 card-canale @(emailAttive > 0 ? "attivo" : "")" data-canale="email">
                    <div class="d-flex justify-content-between">
                        <i class="ri-mail-line icon-canale" aria-hidden="true"></i>
                        <div class="form-check form-switch m-0">
                            <input type="checkbox" class="form-check-input chk-canale-tutte" data-canale="email" role="switch" checked="@(emailAttive > 0)"
                                   aria-label="Email per tutte le tipologie" aria-describedby="conteggio-email" />
                        </div>
                    </div>
                    <h3 class="h6 fw-medium text-primary mb-0">Email</h3>
                    <span class="canale-stato conteggio-canale" id="conteggio-email">@emailAttive di @tutte.Count attive</span>
                </div>
                <div class="card radius-15 card-canale @(whatsAppAttive > 0 ? "attivo" : "") @(wa.Disponibile ? "" : "disabilitato")" data-canale="whatsapp">
                    <div class="d-flex justify-content-between">
                        <i class="ri-whatsapp-line icon-canale text-success" aria-hidden="true"></i>
                        <div class="form-check form-switch m-0">
                            <input type="checkbox" class="form-check-input chk-canale-tutte" data-canale="whatsapp" role="switch"
                                   checked="@(whatsAppAttive > 0)" disabled="@(!wa.Collegato)"
                                   aria-label="WhatsApp per tutte le tipologie" aria-describedby="conteggio-whatsapp" />
                        </div>
                    </div>
                    <h3 class="h6 fw-medium text-primary mb-0">WhatsApp</h3>
                    @if (!wa.Disponibile)
                    {
                        <span class="canale-stato">Presto disponibile</span>
                    }
                    else if (!wa.Collegato)
                    {
                        <button type="button" class="btn btn-link p-0 canale-azione" data-bs-toggle="collapse" data-bs-target="#collega-whatsapp"
                                aria-expanded="@(Model.NumeroInVerifica is not null ? "true" : "false")" aria-controls="collega-whatsapp">Collega il tuo numero</button>
                    }
                    else
                    {
                        <span class="canale-stato conteggio-canale" id="conteggio-whatsapp">@whatsAppAttive di @tutte.Count attive</span>
                        <span class="canale-stato canale-numero" title="@(wa.Mittente is { } da ? $"I messaggi arrivano dal numero Consulens {NumeroWhatsApp.Leggibile(da)}" : null)">@NumeroWhatsApp.Leggibile(wa.Numero!)</span>
                        <form asp-action="WhatsAppScollega" method="post" class="m-0"
                              onsubmit="return confirm('Scollegare il numero WhatsApp? Non riceverai più notifiche su WhatsApp.');">
                            <button type="submit" class="btn btn-link p-0 canale-azione">Scollega</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @if (wa.Disponibile && !wa.Collegato)
        {
            <div class="collapse @(Model.NumeroInVerifica is not null ? "show" : "")" id="collega-whatsapp">
                <div class="collega-whatsapp">
                    @if (Model.NumeroInVerifica is { } inVerifica)
                    {
                        <form asp-action="WhatsAppVerifica" method="post" class="collega-passo">
                            <input type="hidden" name="numero" value="@inVerifica" />
                            <p class="mb-2">Inserisci il codice che ti abbiamo inviato su WhatsApp al <strong>@NumeroWhatsApp.Leggibile(inVerifica)</strong>: vale pochi minuti.</p>
                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div>
                                    <label for="codice-whatsapp" class="form-label">Codice</label>
                                    <input id="codice-whatsapp" name="codice" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="10" required autofocus />
                                </div>
                                <button type="submit" class="btn btn-primary">Conferma il numero</button>
                            </div>
                        </form>
                        <p class="small text-body-secondary mb-2">Il codice non è arrivato o il numero è sbagliato? Chiedine un altro qui sotto.</p>
                    }
                    <form asp-action="WhatsAppCodice" method="post" class="collega-passo">
                        <p class="mb-2">
                            Riceverai su WhatsApp, @daNumero, solo le notifiche che
                            accenderai qui sotto. Per essere sicuri che il numero sia tuo ti mandiamo un codice da inserire in questa pagina.
                        </p>
                        <div>
                            <label for="numero-whatsapp" class="form-label">Numero di cellulare</label>
                            <input id="numero-whatsapp" name="numero" type="tel" class="form-control campo-numero-whatsapp" value="@(Model.NumeroInVerifica ?? wa.Suggerito)"
                                   placeholder="+39 333 1234567" autocomplete="tel" required />
                        </div>
                        <div class="form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="consenso-whatsapp" name="consenso" value="true" required />
                            <label class="form-check-label small" for="consenso-whatsapp">
                                Acconsento a ricevere su WhatsApp le notifiche di Consulens HR che sceglierò. Posso scollegare il numero in qualsiasi momento.
                            </label>
                        </div>
                        <button type="submit" class="btn btn-outline-primary mt-2">@(Model.NumeroInVerifica is null ? "Invia il codice" : "Invia un nuovo codice")</button>
                    </form>
                </div>
            </div>
        }
    </section>

    <section class="card radius-15 p-3 card-categorie-wrapper card-tinted" aria-labelledby="titolo-categorie">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="titolo-sezione-notifiche mb-0" id="titolo-categorie"><i class="ri-list-check-3 icon-canale notifiche-canale-icona" aria-hidden="true"></i> Categorie di notifica</h2>
            <span class="stato-salvataggio" role="status" aria-live="polite"></span>
        </div>

        @foreach (var g in Model.Gruppi)
        {
            var idSezione = $"sezione-{g.Categoria}";
            var qualcosaAttivo = g.Tipi.Any(t => t.Email || (wa.Collegato && t.WhatsApp));
            <section class="card p-3 radius-15 card-categoria-notifica" aria-labelledby="@idSezione">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <h3 class="titolo-sezione-notifiche mb-0" id="@idSezione"><i class="@IconeNotifiche.Di(g.Categoria)" aria-hidden="true"></i> @g.Categoria.Descrizione()</h3>
                    <button type="button" class="btn btn-link text-info fw-medium p-0 toggle-categoria">@(qualcosaAttivo ? "Disattiva tutte" : "Attiva tutte")</button>
                </div>
                <div class="notifiche-tipi @(wa.Disponibile ? "con-whatsapp" : "")">
                    <div class="notifiche-tipo notifiche-intestazione" aria-hidden="true">
                        <span>Tipologia</span><span>In piattaforma</span><span>Email</span>@if (wa.Disponibile) { <span>WhatsApp</span> }
                    </div>
                    @foreach (var t in g.Tipi)
                    {
                        var id = $"email-{t.Definizione.Tipo}";
                        <div class="notifiche-tipo">
                            <div>
                                <label class="fw-medium mb-0" for="@id">@t.Definizione.Nome</label>
                                <p class="notifiche-tipo-descrizione mb-0">@t.Definizione.Descrizione</p>
                            </div>
                            <span class="notifiche-sempre"><i class="ri-check-line" aria-hidden="true"></i> Sempre attiva</span>
                            <div class="form-check form-switch m-0">
                                <input type="checkbox" class="form-check-input chk-canale" data-canale="email" role="switch" id="@id" value="@t.Definizione.Tipo"
                                       checked="@t.Email" aria-label="Email per «@t.Definizione.Nome»" />
                            </div>
                            @if (wa.Disponibile)
                            {
                                <div class="form-check form-switch m-0" title="@(wa.Collegato ? null : "Collega il tuo numero WhatsApp per attivarla")">
                                    <input type="checkbox" class="form-check-input chk-canale" data-canale="whatsapp" role="switch" id="whatsapp-@t.Definizione.Tipo"
                                           value="@t.Definizione.Tipo" checked="@(wa.Collegato && t.WhatsApp)" disabled="@(!wa.Collegato)"
                                           aria-label="WhatsApp per «@t.Definizione.Nome»" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <section class="card p-3 radius-15 card-categoria-notifica mb-0" aria-labelledby="sezione-accesso">
            <h3 class="titolo-sezione-notifiche mb-0" id="sezione-accesso"><i class="ri-shield-keyhole-line" aria-hidden="true"></i> Accesso e sicurezza</h3>
            <div class="notifiche-tipi">
                @foreach (var a in CatalogoNotifiche.SempreAttivi)
                {
                    <div class="notifiche-tipo notifiche-tipo-fisso">
                        <div>
                            <p class="fw-medium mb-0">@a.Nome</p>
                            <p class="notifiche-tipo-descrizione mb-0">@a.Descrizione</p>
                        </div>
                        <span class="notifiche-solo-email">Solo email · sempre attiva</span>
                    </div>
                }
            </div>
        </section>
    </section>
</div>

@section Scripts { <script src="~/js/notifiche.js" asp-append-version="true"></script> }
