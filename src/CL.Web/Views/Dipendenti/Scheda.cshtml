@section Scripts {
    <script>
        $(function () { if ($.fn.select2) $('.select-multipla').select2({ width: '100%', placeholder: 'Nessun team', closeOnSelect: false }); });
    </script>
    <script>
        // Schede senza ricaricare; "Modifica dati" apre i campi. L'indirizzo ricorda scheda e modalità.
        (function () {
            const scheda = document.getElementById('scheda');
            const link = document.querySelectorAll('[data-scheda]');
            const aggiornaIndirizzo = () => {
                const attiva = document.querySelector('[data-scheda].active')?.dataset.scheda ?? 'anagrafica';
                const p = new URLSearchParams();
                if (attiva !== 'anagrafica') p.set('sezione', attiva);
                if (scheda.classList.contains('in-modifica')) p.set('modifica', 'true');
                history.replaceState(null, '', location.pathname + (p.size ? '?' + p : ''));
                document.querySelectorAll('#formFotoSubito [name=sezione], #formTogliFoto [name=sezione]').forEach(i => i.value = attiva);
            };
            const mostra = k => {
                link.forEach(x => { const on = x.dataset.scheda === k; x.classList.toggle('active', on); x.setAttribute('aria-selected', String(on)); });
                document.querySelectorAll('.pannello-scheda').forEach(p => p.hidden = p.id !== 'scheda-' + k);
                aggiornaIndirizzo();
            };
            link.forEach(a => a.addEventListener('click', e => { e.preventDefault(); mostra(a.dataset.scheda); }));
            document.getElementById('apriModifica')?.addEventListener('click', e => {
                e.preventDefault();
                scheda.classList.add('in-modifica');
                const attiva = document.querySelector('[data-scheda].active')?.dataset.scheda;
                if (attiva !== 'contratto') mostra('anagrafica'); else aggiornaIndirizzo();
                document.getElementById(attiva === 'contratto' ? 'scheda-contratto' : 'Nome')?.focus();
            });
        })();

        // Dati per le paghe: "Modifica" apre i campi nella card, "Annulla" li richiude.
        (function () {
            const card = document.getElementById('cardPaghe');
            if (!card) return;
            const segna = () => { document.getElementById('salvaPaghe').value = 'true'; };
            // Con "Modifica dati" la card si apre insieme agli altri campi: si salva solo se è stata toccata (o se i dati ci sono già).
            card.querySelector('.modulo-paghe')?.addEventListener('input', segna);
            card.querySelector('.modulo-paghe')?.addEventListener('change', segna);
            if (card.dataset.compilati === 'true') document.getElementById('apriModifica')?.addEventListener('click', segna);
            if (document.getElementById('scheda').classList.contains('in-modifica') && card.dataset.compilati === 'true') segna();
            document.getElementById('apriPaghe')?.addEventListener('click', () => {
                segna();
                card.classList.add('in-modifica-paghe');
                card.querySelector('.modulo-paghe input:not([type=hidden])')?.focus();
            });
            card.querySelector('.annulla-paghe')?.addEventListener('click', () => location.reload());
            const fam = card.querySelector('.aggiungi-familiare');
            fam?.addEventListener('click', () => {
                const nascosta = card.querySelector('.riga-familiare[hidden]');
                if (nascosta) { nascosta.hidden = false; nascosta.querySelector('input')?.focus(); }
                if (!card.querySelector('.riga-familiare[hidden]')) fam.hidden = true;
            });
            card.querySelectorAll('.togli-familiare').forEach(b => b.addEventListener('click', () => {
                const riga = b.closest('.riga-familiare');
                riga.querySelectorAll('input:not([type=checkbox])').forEach(i => i.value = '');
                riga.querySelectorAll('input[type=checkbox]').forEach(i => i.checked = false);
                riga.hidden = true;
                if (fam) fam.hidden = false;
            }));
            card.querySelectorAll('[data-mostra]').forEach(c => {
                const bersaglio = document.getElementById(c.dataset.mostra);
                const aggiorna = () => bersaglio.hidden = c.type === 'checkbox' ? !c.checked : c.value !== c.dataset.valore;
                c.addEventListener('change', aggiorna); aggiorna();
            });
        })();

        // Nuova persona: "Modifica immagine" sceglie la foto e ne mostra l'anteprima; si salva con "Salva".
        (function () {
            const img = document.getElementById('anteprimaFoto'), file = document.getElementById('Foto'), nota = document.getElementById('notaFoto');
            if (!file) return;
            document.getElementById('scegliFoto').addEventListener('click', () => file.click());
            file.addEventListener('change', () => {
                const f = file.files[0];
                if (!f) return;
                img.src = URL.createObjectURL(f);
                nota.textContent = 'Nuova immagine: ' + f.name + ' (verrà salvata con "Salva").';
                nota.classList.remove('d-none');
            });
        })();
    </script>
}
