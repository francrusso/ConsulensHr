                    <div><label for="residuoRol" class="form-label">ROL al 1° gennaio @oggi.Year (ore)</label><input id="residuoRol" name="rol" value="@residuoRol.ToString("0.##")" inputmode="decimal" class="form-control" /></div>
                    <div class="d-flex align-items-end"><button type="submit" class="btn btn-primary">Salva residui</button></div>
                </div>
            </form>
        </section>
    }

    @{
        var presenze = (List<CL.Web.Controllers.PresenzeMese>)ViewBag.Presenze;
        var totUfficio = presenze.Sum(x => x.InUfficio);
        var totRemoto = presenze.Sum(x => x.Remoto);
        var totAssente = presenze.Sum(x => x.Assente);
        string Date(List<DateOnly> g) => string.Join(", ", g.Select(x => x.ToString("ddd d")));
    }
    @* Giorni lavorati da inizio anno: in ufficio o da remoto, con il dettaglio mese per mese. *@
    <div class="row g-3 mt-1">
        <partial name="~/Views/Home/_Indicatore.cshtml" model='("Giorni in ufficio", totUfficio.ToString(), "ri-building-line", (string?)null, $"da inizio {oggi.Year}")' />
        <partial name="~/Views/Home/_Indicatore.cshtml" model='("Giorni da remoto", totRemoto.ToString(), "ri-home-wifi-line", (string?)null, $"da inizio {oggi.Year}")' />
        <partial name="~/Views/Home/_Indicatore.cshtml" model='("Giorni di assenza", totAssente.ToString(), "ri-user-unfollow-line", (string?)null, "giornate intere approvate")' />
    </div>
    <div class="card radius-15 table-responsive p-1 mt-3 customer-results">
        <table class="table mb-0 align-middle tabella-presenze">
