            <dl class="valori-profilo residui-lettura solo-lettura mb-0">
                <div><dt>Ferie al 1° gennaio @oggi.Year</dt><dd>@Ore(residuoFerie)</dd></div>
                <div><dt>ROL al 1° gennaio @oggi.Year</dt><dd>@Ore(residuoRol)</dd></div>
            </dl>
            <form asp-controller="Assenze" asp-action="ImpostaResidui" method="post" class="solo-modifica">
