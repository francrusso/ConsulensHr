                        <td data-label="In ufficio" class="text-end">@p.InUfficio</td>
                        <td data-label="Da remoto" class="text-end">@p.Remoto</td>
                        <td data-label="Assenze" class="text-end">@p.Assente</td>
                        <td data-label="Dettaglio" class="small">
                            @if (p.SmartWorking.Count > 0) { <div><span class="voce-giorno voce-smart"><i class="ri-home-wifi-line" aria-hidden="true"></i> Smart working</span> @Date(p.SmartWorking)</div> }
                            @if (p.SegnatiUfficio.Count > 0) { <div><span class="voce-giorno voce-ufficio"><i class="ri-building-line" aria-hidden="true"></i> In ufficio</span> @Date(p.SegnatiUfficio)</div> }
