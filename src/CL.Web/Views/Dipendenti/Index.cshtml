@model List<CL.Web.Controllers.DipendenteRiga>
@inject CL.Web.Infrastruttura.UtenteCorrente Utente
@{
    // Per il referente dell'azienda la sezione si chiama "Personale".
    var p = true; // "Personale" per tutti (consulente e azienda)
    var consulentiAziende = ViewBag.ConsulentiAziende as Dictionary<Guid, string> ?? new();
    ViewData["Title"] = p ? "Personale" : "Dipendenti";
    var aziende = ViewBag.Aziende as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var conteggi = (Dictionary<CL.Web.Controllers.StatoPersonale, int>)ViewBag.Conteggi;
    var statoScelto = ViewBag.Stato as CL.Web.Controllers.StatoPersonale?;
    var esterni = (bool)ViewBag.Esterni;
    var oggi = (DateOnly)ViewBag.Oggi;
    var it = System.Globalization.CultureInfo.GetCultureInfo("it-IT");
}

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
</div>

@* Switch lavoro dipendente / professionisti esterni (in base al contratto più recente): stesso componente delle categorie di ConsulensNew. *@
<nav class="invoice-filter-categories mb-3" aria-label="Tipo di rapporto">
    <a class="badge-filtro-categoria @(esterni ? "" : "active")" aria-current="@(esterni ? null : "page")"
       asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-aziendaId="@ViewBag.AziendaId">
        <i class="ri-team-line" aria-hidden="true"></i> Personale dipendente <span>(@ViewBag.NumeroDipendenti)</span>
    </a>
    <a class="badge-filtro-categoria @(esterni ? "active" : "")" aria-current="@(esterni ? "page" : null)"
       asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-aziendaId="@ViewBag.AziendaId" asp-route-esterni="true">
        <i class="ri-briefcase-4-line" aria-hidden="true"></i> Professionisti esterni <span>(@ViewBag.NumeroEsterni)</span>
    </a>
</nav>

<section class="customer-directory">
    <form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
        <div class="invoice-filter-toolbar">
            <div class="invoice-filter-client">
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="ri-search-line" aria-hidden="true"></i></span>
                    <input type="text" name="q" class="form-control" placeholder="Cerca per nome, cognome o codice fiscale" aria-label="@(p ? "Cerca nel personale" : "Cerca dipendenti")" value="@ViewBag.Ricerca" />
                </div>
            </div>
            @if (aziende is not null)
            {
                <div>
                    <select name="aziendaId" class="form-select" aria-label="Filtra per azienda" asp-items="aziende">
                        <option value="">Tutte le aziende</option>
                    </select>
                </div>
            }

            @if (esterni) { <input type="hidden" name="esterni" value="true" /> }
            @if (statoScelto is { } sc) { <input type="hidden" name="stato" value="@sc.Chiave()" /> }
            <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
        </div>
    </form>
    <partial name="_ChipRicerca" />

    @* Stato del rapporto: stesso componente delle categorie, voci tonde con pallino colorato e conteggio. *@
    <nav class="invoice-filter-categories filtro-stati mb-3" aria-label="Stato del rapporto">
        <a class="badge-filtro-categoria @(statoScelto is null ? "active" : "")" aria-current="@(statoScelto is null ? "page" : null)"
           asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-aziendaId="@ViewBag.AziendaId" asp-route-esterni="@(esterni ? true : (bool?)null)">
            Tutti <span>(@ViewBag.Totale)</span>
        </a>
        @foreach (var st in CL.Web.Controllers.StatoPersonaleExtensions.Filtri)
        {
            <a class="badge-filtro-categoria @(statoScelto == st ? "active" : "")" aria-current="@(statoScelto == st ? "page" : null)"
               asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-aziendaId="@ViewBag.AziendaId" asp-route-esterni="@(esterni ? true : (bool?)null)" asp-route-stato="@st.Chiave()">
                <span class="pallino-stato" style="--colore-stato:@st.Colore()" aria-hidden="true"></span> @st.Descrizione(plurale: true) <span>(@conteggi[st])</span>
            </a>
        }
    </nav>

    <div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th scope="col">@(esterni ? "Professionista" : p ? "Persona" : "Dipendente")</th>
                    <th scope="col">Profilo</th>
                    <th scope="col">Team</th>
                    <th scope="col">Codice fiscale</th>
                    @if (Utente.IsConsulente) { <th scope="col">Azienda</th> }
                    @if (Utente.IsAmministratore) { <th scope="col">Consulente</th> }
                    @if (esterni) { <th scope="col">Rapporto</th> }
                    <th scope="col" class="text-end">@(esterni ? "Compenso annuo" : "RAL")</th>
                    <th scope="col" class="text-end">Mensile lordo</th>
                    <th scope="col">Contratto</th>
                    <th scope="col">Scadenza contratto</th>
                    <th scope="col">Stato</th>
                    <th scope="col" class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="@(10 + (Utente.IsConsulente ? 1 : 0) + (Utente.IsAmministratore ? 1 : 0) + (esterni ? 1 : 0))" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-team-line"></i></span><div>@(esterni ? "Nessun professionista esterno" : p ? "Nessuna persona trovata" : "Nessun dipendente trovato")</div></td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr class="customer-result-row">
                        <td data-label="@(p ? "Persona" : "Dipendente")"><a class="customer-name" asp-action="Dettaglio" asp-route-id="@d.Id"><img class="avatar-elenco" src="@(d.HaFoto ? Url.Action("Foto", new { id = d.Id }) : Url.Content($"~/assets/images/avatar/{d.Segnaposto}.png"))" alt="" loading="lazy" /><span>@d.NomeCompleto</span></a></td>
                        <td data-label="Profilo">@(d.Profilo ?? "—")</td>
                        <td data-label="Team">
                            @if (d.Team is { } tm)
                            {
                                <span class="team-elenco"><span class="org-pallino" style="--colore-team:@tm.Colore" aria-hidden="true"></span>@if (tm.Emoji is not null) { <span aria-hidden="true">@tm.Emoji</span> }@tm.Nome</span>
                            }
                            else { <span class="text-body-secondary">—</span> }
                        </td>
                        <td data-label="Codice fiscale">@d.CodiceFiscale</td>
                        @if (Utente.IsConsulente) { <td data-label="Azienda">@d.Azienda</td> }
                        @if (Utente.IsAmministratore) { <td data-label="Consulente">@(consulentiAziende.GetValueOrDefault(d.AziendaId) ?? "Nessuno")</td> }
                        @if (esterni) { <td data-label="Rapporto">@(d.Inquadramento ?? "—")</td> }
                        <td data-label="@(esterni ? "Compenso annuo" : "RAL")" class="text-end text-nowrap">@(d.Ral is > 0 ? d.Ral.Value.ToString("C0", it) : "—")</td>
                        <td data-label="Mensile lordo" class="text-end text-nowrap" title="@(d.Mensilita is > 0 ? $"RAL divisa per {d.Mensilita} mensilità" : null)">@(d.MensileLordo is { } ml ? ml.ToString("C0", it) : "—")</td>
                        <td data-label="Contratto" class="text-nowrap">
                            @if (d.ContrattoId is { } cid && d.HaDocumentoContratto)
                            {
                                <a asp-action="DocumentoContratto" asp-route-id="@d.Id" asp-route-contrattoId="@cid" target="_blank" rel="noopener" class="link-contratto"><i class="ri-file-pdf-2-line" aria-hidden="true"></i> Apri</a>
                            }
                            else if (d.ContrattoId is not null)
                            {
                                <a asp-action="Modifica" asp-route-id="@d.Id" asp-route-sezione="contratto" class="contratto-mancante" title="Carica il PDF del contratto"><i class="ri-upload-2-line" aria-hidden="true"></i> Da caricare</a>
                            }
                            else { <span class="text-body-secondary">—</span> }
                        </td>
                        <td data-label="Scadenza contratto" class="text-nowrap">
                            @if (d.Scadenza is { } sc)
                            {
                                var giorni = sc.DayNumber - oggi.DayNumber;
                                <span class="@(giorni is >= 0 and <= 30 ? "scadenza-vicina" : giorni < 0 ? "text-body-secondary" : "")" title="@(giorni is >= 0 and <= 30 ? $"Scade tra {giorni} giorni" : null)">@sc.ToString("dd/MM/yyyy")</span>
                            }
                            else if (d.Stato != StatoPersonale.SenzaContratto) { <span class="text-body-secondary">Indeterminato</span> }
                            else { <span class="text-body-secondary">—</span> }
                        </td>
                        <td data-label="Stato">
                            <span class="badge badge-stato" style="--colore-stato:@d.Stato.Colore()"><span class="pallino-stato" aria-hidden="true"></span>@d.Stato.Descrizione()</span>
                        </td>
                        <td data-label="Azioni">
                            <div class="customer-actions">
                                <a asp-action="Dettaglio" asp-route-id="@d.Id" aria-label="Visualizza scheda" title="Visualizza scheda"><i class="ri-eye-line" aria-hidden="true"></i></a>
                                <a asp-action="Modifica" asp-route-id="@d.Id" aria-label="Modifica" title="Modifica"><i class="ri-pencil-line" aria-hidden="true"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
