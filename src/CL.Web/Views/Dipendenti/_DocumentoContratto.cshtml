@model (Guid DipendenteId, CL.Domain.Dipendenti.Contratto Contratto, bool Completo)
@using CL.Domain.Dipendenti
@*
    Documenti del contratto: il contratto (lettera di assunzione) e le lettere di variazione (proroga, trasformazione, orario,
    livello…). Completo = contratto in corso: si sceglie il tipo di documento quando si carica; nello storico solo il contratto.
*@
@{
    var (idDip, c, completo) = Model;
    var idCampo = "documento-" + c.Id.ToString("N");
}
<div class="documento-contratto">
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (c.DocumentoChiave is not null)
        {
            <a asp-action="DocumentoContratto" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" class="documento-file" target="_blank" rel="noopener">
                <i class="ri-file-pdf-2-line" aria-hidden="true"></i>
                <span>@c.DocumentoNome</span>
            </a>
            @if (c.DocumentoCaricatoIl is { } il) { <span class="small text-body-secondary">caricato il @il.ToLocalTime().ToString("dd/MM/yyyy")</span> }
            <form asp-action="RimuoviContratto" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" method="post" class="m-0 ms-auto solo-modifica" onsubmit="return confirm('Rimuovere il documento del contratto?');">
                <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Rimuovi il documento"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
            </form>
        }
        else
        {
            <span class="text-body-secondary small">Nessun contratto caricato.</span>
        }
        @if (!completo)
        {
            <form asp-action="CaricaContratto" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" method="post" enctype="multipart/form-data" class="m-0 ms-auto solo-modifica">
                <input type="file" name="documento" id="@idCampo" accept="application/pdf" class="d-none" onchange="this.form.requestSubmit()" />
                <label for="@idCampo" class="btn btn-outline-primary btn-sm mb-0">@(c.DocumentoChiave is null ? "Carica PDF" : "Sostituisci") <i class="ri-upload-2-line" aria-hidden="true"></i></label>
            </form>
        }
    </div>

    @foreach (var l in c.Lettere.OrderByDescending(x => x.DataEffetto))
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <a asp-action="ApriLettera" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" asp-route-letteraId="@l.Id" class="documento-file" target="_blank" rel="noopener">
                <i class="ri-file-pdf-2-line" aria-hidden="true"></i>
                <span>@l.Tipo.Descrizione()</span>
            </a>
            <span class="small text-body-secondary">dal @l.DataEffetto.ToString("dd/MM/yyyy")</span>
            <form asp-action="RimuoviLettera" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" asp-route-letteraId="@l.Id" method="post" class="m-0 ms-auto solo-modifica" onsubmit="return confirm('Rimuovere questa lettera?');">
                <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Rimuovi @l.Tipo.Descrizione()"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
            </form>
        </div>
    }

    @if (completo)
    {
        <form asp-action="CaricaContratto" asp-route-id="@idDip" asp-route-contrattoId="@c.Id" method="post" enctype="multipart/form-data" class="campi-presenza mt-3 solo-modifica carica-documento-contratto">
            <div>
                <label for="tipo-@idCampo" class="form-label">Tipo di documento</label>
                <select id="tipo-@idCampo" name="tipo" class="form-select tipo-documento-contratto">
                    @foreach (var t in Enum.GetValues<TipoLettera>()) { <option value="@t">@t.Descrizione()</option> }
                </select>
            </div>
            <div class="campo-data-effetto" hidden>
                <label for="data-@idCampo" class="form-label">Valida dal</label>
                <input id="data-@idCampo" name="dataEffetto" type="date" class="form-control" />
            </div>
            <div class="campo-note">
                <label for="@idCampo" class="form-label">PDF</label>
                <div class="input-group">
                    <input id="@idCampo" name="documento" type="file" accept="application/pdf" class="form-control" required />
                    <button type="submit" class="btn btn-outline-primary">Carica <i class="ri-upload-2-line" aria-hidden="true"></i></button>
                </div>
            </div>
        </form>
        <script>
            document.querySelectorAll('.carica-documento-contratto').forEach(f => {
                const tipo = f.querySelector('.tipo-documento-contratto');
                const data = f.querySelector('.campo-data-effetto');
                const aggiorna = () => { const variazione = tipo.value !== 'Assunzione'; data.hidden = !variazione; data.querySelector('input').required = variazione; };
                tipo.addEventListener('change', aggiorna);
                aggiorna();
            });
        </script>
    }
</div>
