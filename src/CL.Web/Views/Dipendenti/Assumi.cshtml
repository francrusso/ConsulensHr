@model CL.Web.Controllers.ContrattoForm
@{
    ViewData["Title"] = "Nuovo contratto";
}

<a asp-action="Dettaglio" asp-route-id="@Model.DipendenteId" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @Model.NomeDipendente</a>
<h1 class="titolo-pagina mb-3">Nuovo contratto · @Model.NomeDipendente</h1>

<div class="card radius-15 p-4">
    <form asp-action="Assumi" method="post" class="row g-3" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger radius-15" role="alert"></div>
        <input type="hidden" asp-for="DipendenteId" />

        <h2 class="h6 col-12 mb-0">Rapporto</h2>
        <div class="col-md-4">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" asp-items="CL.Web.Controllers.ContrattoForm.Tipi" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="DataInizio" class="form-label"></label>
            <input asp-for="DataInizio" type="date" class="form-control" aria-required="true" />
        </div>
        <div class="col-md-4">
            <label asp-for="DataFine" class="form-label"></label>
            <input asp-for="DataFine" type="date" class="form-control" />
            <div class="form-text">Obbligatoria per il tempo determinato.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Ccnl" class="form-label"></label>
            <input asp-for="Ccnl" class="form-control" placeholder="es. Commercio – Terziario Confcommercio" aria-required="true" />
        </div>
        <div class="col-md-2">
            <label asp-for="Livello" class="form-label"></label>
            <input asp-for="Livello" class="form-control" aria-required="true" />
        </div>
        <div class="col-md-4">
            <label asp-for="Mansione" class="form-label"></label>
            <input asp-for="Mansione" class="form-control" />
        </div>

        <h2 class="h6 col-12 mt-4 mb-0">Retribuzione e orario</h2>
        <div class="col-md-4">
            <label asp-for="RetribuzioneLordaAnnua" class="form-label"></label>
            <input asp-for="RetribuzioneLordaAnnua" type="text" inputmode="decimal" class="form-control" placeholder="es. 28000,00" aria-required="true" />
        </div>
        <div class="col-md-2">
            <label asp-for="MensilitaAnnue" class="form-label"></label>
            <input asp-for="MensilitaAnnue" type="number" min="12" max="16" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="OreSettimanaliFullTime" class="form-label"></label>
            <input asp-for="OreSettimanaliFullTime" type="text" inputmode="decimal" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="PercentualePartTime" class="form-label"></label>
            <input asp-for="PercentualePartTime" type="text" inputmode="decimal" class="form-control" />
            <div class="form-text">100 = full-time.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="GiorniLavorativiSettimana" class="form-label"></label>
            <select asp-for="GiorniLavorativiSettimana" class="form-select">
                <option value="5">5 (lun–ven)</option>
                <option value="6">6 (lun–sab)</option>
            </select>
        </div>

        <h2 class="h6 col-12 mt-4 mb-0">Spettanze annue da CCNL</h2>
        <p class="col-12 text-body-secondary small mb-0">Valori riferiti al full-time: per i part-time vengono riproporzionati automaticamente.</p>
        <div class="col-md-4">
            <label asp-for="OreFerieAnnue" class="form-label"></label>
            <input asp-for="OreFerieAnnue" type="text" inputmode="decimal" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="OreRolAnnue" class="form-label"></label>
            <input asp-for="OreRolAnnue" type="text" inputmode="decimal" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="OreExFestivitaAnnue" class="form-label"></label>
            <input asp-for="OreExFestivitaAnnue" type="text" inputmode="decimal" class="form-control" />
        </div>

        <div class="col-12 d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Registra contratto</button>
            <a asp-action="Dettaglio" asp-route-id="@Model.DipendenteId" class="btn btn-outline-secondary">Annulla</a>
        </div>
    </form>
</div>
