@model CL.Web.Controllers.DipendenteForm
@{
    var nuovo = Model.Id is null;
    ViewData["Title"] = nuovo ? "Nuovo dipendente" : "Modifica dipendente";
    var aziende = ViewBag.Aziende as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<h1 class="titolo-pagina mb-3">@ViewData["Title"]</h1>

<div class="card radius-15 p-4">
    <form asp-action="Salva" method="post" class="row g-3" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger radius-15" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <h2 class="h6 col-12 mb-0">Anagrafica</h2>
        <div class="col-md-6">
            <label asp-for="AziendaId" class="form-label"></label>
            @if (aziende is not null && nuovo)
            {
                <select asp-for="AziendaId" asp-items="aziende" class="form-select" aria-required="true">
                    <option value="">Seleziona…</option>
                </select>
            }
            else
            {
                <input type="hidden" asp-for="AziendaId" />
                <input class="form-control" value="@(ViewBag.NomeAzienda ?? aziende?.FirstOrDefault(a => a.Selected)?.Text)" readonly aria-label="Azienda" />
            }
            <span asp-validation-for="AziendaId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Matricola" class="form-label"></label>
            <input asp-for="Matricola" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" aria-required="true" autocomplete="off" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cognome" class="form-label"></label>
            <input asp-for="Cognome" class="form-control" aria-required="true" autocomplete="off" />
            <span asp-validation-for="Cognome" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CodiceFiscale" class="form-label"></label>
            <input asp-for="CodiceFiscale" class="form-control text-uppercase" maxlength="16" aria-required="true" autocomplete="off" />
            <span asp-validation-for="CodiceFiscale" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DataNascita" class="form-label"></label>
            <input asp-for="DataNascita" class="form-control" type="date" aria-required="true" />
            <span asp-validation-for="DataNascita" class="text-danger"></span>
        </div>

        <h2 class="h6 col-12 mt-4 mb-0">Recapiti e pagamento</h2>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" type="tel" />
        </div>
        <div class="col-12">
            <label asp-for="Indirizzo" class="form-label"></label>
            <input asp-for="Indirizzo" class="form-control" />
        </div>
        <div class="col-md-8">
            <label asp-for="Iban" class="form-label"></label>
            <input asp-for="Iban" class="form-control text-uppercase" placeholder="IT60 X054 2811 1010 0000 0123 456" autocomplete="off" />
            <span asp-validation-for="Iban" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Genere" class="form-label"></label>
            <select asp-for="Genere" class="form-select" asp-items="CL.Web.Controllers.DatiPersonaliController.Generi"><option value="">—</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Pronomi" class="form-label"></label>
            <select asp-for="Pronomi" class="form-select" asp-items="CL.Web.Controllers.DatiPersonaliController.ElencoPronomi"><option value="">—</option></select>
            <div class="form-text">Come li indica la persona; il dipendente può aggiornarli da "I miei dati".</div>
        </div>
        <div class="col-md-8">
            <label asp-for="Foto" class="form-label"></label>
            <div class="d-flex align-items-center gap-3">
                @if (Model.HaFoto && Model.Id is { } idFoto) { <img src="@Url.Action("Foto", new { id = idFoto })" alt="Foto attuale" class="foto-dipendente" /> }
                <input asp-for="Foto" type="file" class="form-control" accept="@CL.Web.Infrastruttura.Immagini.FormatiAccettati" />
            </div>
            <span asp-validation-for="Foto" class="text-danger"></span>
            @if (Model.HaFoto)
            {
                <div class="form-check mt-2"><input asp-for="RimuoviFoto" class="form-check-input" /><label asp-for="RimuoviFoto" class="form-check-label"></label></div>
            }
        </div>

        <div class="col-12 d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(nuovo ? "Salva e registra l'assunzione" : "Salva")</button>
            <a asp-action="@(nuovo ? "Index" : "Dettaglio")" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Annulla</a>
        </div>
    </form>
</div>
