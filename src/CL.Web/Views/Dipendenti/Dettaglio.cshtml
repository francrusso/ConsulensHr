@model Dipendente
@{
    ViewData["Title"] = Model.NomeCompleto;
    var oggi = (DateOnly)ViewBag.Oggi;
    var attivo = Model.ContrattoAttivo(oggi);
    var contratti = Model.Contratti.OrderByDescending(c => c.DataInizio).ToList();
    var saldi = (IReadOnlyList<SaldoAssenza>)ViewBag.Saldi;
    var richieste = (List<CL.Web.Controllers.RichiestaRiga>)ViewBag.Richieste;
    var ritorno = Context.Request.Path.ToString();
    var accesso = ViewBag.Accesso as CL.Web.Infrastruttura.UtenteRiga;
    var buste = (List<BustaRiga>)ViewBag.Buste;
    var mesePrecedente = oggi.AddMonths(-1);
}
@inject UtenteCorrente Utente

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <a asp-action="Index" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @(Utente.IsAzienda ? "Personale" : "Dipendenti")</a>
        <h1 class="titolo-pagina mb-0 d-flex align-items-center gap-2 flex-wrap">
            <img src="@(Model.FotoChiave is not null ? Url.Action("Foto", new { id = Model.Id }) : Url.Content($"~/assets/images/avatar/{Model.Segnaposto}.png"))" alt="" class="foto-dipendente" />
            @Model.NomeCompleto
            @if (attivo is not null) { <span class="badge bg-success align-middle fs-6">In forza</span> }
            else { <span class="badge bg-secondary align-middle fs-6">Non in forza</span> }
        </h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Modifica" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="ri-pencil-line" aria-hidden="true"></i> Modifica</a>
        <a asp-action="Assumi" asp-route-id="@Model.Id" class="btn btn-primary"><i class="ri-file-add-line" aria-hidden="true"></i> Nuovo contratto</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <section class="card radius-15 p-4 h-100 d-flex flex-column">
            <h2 class="h6 mb-3">Anagrafica</h2>
            <dl class="scheda mb-0">
                <dt>Azienda</dt><dd><a asp-controller="Aziende" asp-action="Dettaglio" asp-route-id="@Model.AziendaId">@ViewBag.Azienda</a></dd>
                <dt>Codice fiscale</dt><dd>@Model.CodiceFiscale</dd>
                <dt>Data di nascita</dt><dd>@Model.DataNascita.ToString("dd/MM/yyyy")</dd>
                <dt>Matricola</dt><dd>@(Model.Matricola ?? "—")</dd>
                <dt>Email</dt><dd>@(Model.Email ?? "—")</dd>
                <dt>Telefono</dt><dd>@(Model.Telefono ?? "—")</dd>
                <dt>Indirizzo</dt><dd>@(Model.Indirizzo ?? "—")</dd>
                <dt>IBAN</dt><dd>@(Model.Iban?.Valore ?? "—")</dd>
            </dl>
            @{ dynamic org = ViewBag.Organizzazione; }
            <div class="border-top pt-3 mt-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h2 class="h6 mb-2">Organizzazione</h2>
                    <a asp-controller="Team" asp-action="Organigramma" asp-route-aziendaId="@(Utente.IsConsulente ? Model.AziendaId : (Guid?)null)" class="small"><i class="ri-organization-chart" aria-hidden="true"></i> Organigramma</a>
                </div>
                <dl class="scheda mb-0">
                    <dt>Team</dt><dd>@(org.Team ?? "—")</dd>
                    <dt>Posizione</dt><dd>@(Model.Posizione ?? "—")</dd>
                    <dt>Approva ferie e permessi</dt><dd>@(org.Approvatore ?? "Referente dell'azienda")</dd>
                </dl>
            </div>
            @{ dynamic? dati = ViewBag.ProfiloPersonale; }
            <div class="border-top pt-3 mt-3">
                <h2 class="h6 mb-2">Dati personali per le paghe</h2>
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <div class="small">
                        @if (dati is null) { <span class="badge bg-secondary">Non iniziati</span> }
                        else if (dati.CompletatoIl is null) { <span class="badge bg-warning text-dark">Al passo @dati.Passo di 6</span> }
                        else { <span class="badge bg-success">Completi</span> <span class="text-body-secondary">agg. @(((DateTime)dati.AggiornatoIl).ToLocalTime().ToString("dd/MM/yyyy"))</span> }
                    </div>
                    <a asp-controller="DatiPersonali" asp-action="Index" asp-route-dipendenteId="@Model.Id" class="small"><i class="ri-file-user-line" aria-hidden="true"></i> @(dati?.CompletatoIl is null ? "Apri" : "Vedi")</a>
                </div>
            </div>
            <div class="border-top pt-3 mt-auto">
                <h2 class="h6 mb-2">Accesso al portale</h2>
                @if (accesso is null)
                {
                    <p class="small text-body-secondary mb-2">Con l'accesso il dipendente vede i propri saldi e chiede ferie e permessi.</p>
                    @if (string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <p class="small mb-0">Per invitarlo serve la sua email: <a asp-action="Modifica" asp-route-id="@Model.Id">aggiungila all'anagrafica</a>.</p>
                    }
                    else
                    {
                        <form asp-controller="Utenti" asp-action="InvitaDipendente" method="post" class="m-0">
                            <input type="hidden" name="dipendenteId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-primary"><i class="ri-mail-send-line" aria-hidden="true"></i> Invita a @Model.Email</button>
                        </form>
                    }
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="small"><partial name="~/Views/Utenti/_StatoAccesso.cshtml" model="accesso.Stato" /> <span class="text-body-secondary">@accesso.Email</span></div>
                        <partial name="~/Views/Utenti/_AzioniAccesso.cshtml" model="(accesso, ritorno)" />
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-8 d-flex flex-column gap-3">
        @if (attivo is not null && !attivo.Tipo.IsSubordinato())
        {
            <section class="card radius-15 p-4">
                <h2 class="h6 mb-3">Incarico in corso <span class="badge bg-info align-middle ms-1">Professionista esterno</span></h2>
                <dl class="scheda mb-0 row">
                    <div class="col-sm-6"><dt>Tipo di rapporto</dt><dd>@attivo.Tipo.Descrizione()</dd></div>
                    <div class="col-sm-6"><dt>Attività</dt><dd>@(attivo.Mansione ?? "—")</dd></div>
                    <div class="col-sm-6"><dt>Periodo</dt><dd>dal @attivo.DataInizio.ToString("dd/MM/yyyy")@(attivo.DataFine is { } fe ? $" al {fe:dd/MM/yyyy}" : "")</dd></div>
                    <div class="col-sm-6"><dt>Compenso annuo lordo previsto</dt><dd>@(attivo.RetribuzioneLordaAnnua > 0 ? attivo.RetribuzioneLordaAnnua.ToString("C0") : "—")</dd></div>
                </dl>
                <form asp-action="Cessa" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap align-items-end gap-2 border-top pt-3 mt-2"
                      onsubmit="return confirm('Confermi la chiusura dell\'incarico?');">
                    <div>
                        <label for="dataCessazioneEst" class="form-label small mb-1">Chiudi l'incarico al</label>
                        <input type="date" id="dataCessazioneEst" name="dataCessazione" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-danger">Chiudi incarico</button>
                </form>
            </section>
        }
        else if (attivo is not null)
        {
            <section class="card radius-15 p-4">
                <h2 class="h6 mb-3">Contratto in corso</h2>
                <div class="row">
                    <dl class="scheda col-sm-6 mb-0">
                        <dt>Tipo</dt><dd>@attivo.Tipo.Descrizione()</dd>
                        <dt>CCNL e livello</dt><dd>@attivo.Ccnl · livello @attivo.Livello</dd>
                        <dt>Mansione</dt><dd>@(attivo.Mansione ?? "—")</dd>
                        <dt>Periodo</dt><dd>dal @attivo.DataInizio.ToString("dd/MM/yyyy")@(attivo.DataFine is { } f ? $" al {f:dd/MM/yyyy}" : "")</dd>
                    </dl>
                    <dl class="scheda col-sm-6 mb-0">
                        <dt>Retribuzione</dt><dd>@attivo.RetribuzioneLordaAnnua.ToString("C0") annui · @attivo.MensilitaAnnue mensilità (@attivo.RetribuzioneMensileLorda.ToString("C") lordi al mese)</dd>
                        <dt>Orario</dt><dd>@attivo.OreSettimanali.ToString("0.##") ore settimanali su @attivo.GiorniLavorativiSettimana giorni@(attivo.PercentualePartTime < 100 ? $" · part-time {attivo.PercentualePartTime:0.##}%" : "")</dd>
                        <dt>Spettanze annue</dt>
                        <dd>Ferie @attivo.SpettanzaAnnua(TipoAssenza.Ferie).ToString("0.##") h · ROL @attivo.SpettanzaAnnua(TipoAssenza.Rol).ToString("0.##") h · Ex-festività @attivo.SpettanzaAnnua(TipoAssenza.ExFestivita).ToString("0.##") h</dd>
                    </dl>
                </div>
                <form asp-action="Cessa" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap align-items-end gap-2 border-top pt-3 mt-2"
                      onsubmit="return confirm('Confermi la cessazione del rapporto di lavoro?');">
                    <div>
                        <label for="dataCessazione" class="form-label small mb-1">Registra cessazione al</label>
                        <input type="date" id="dataCessazione" name="dataCessazione" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-danger">Registra cessazione</button>
                </form>
            </section>
        }

        <section class="card radius-15 p-1">
            <h2 class="h6 px-3 pt-3 pb-2 mb-0">Storico contratti</h2>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th scope="col">Periodo</th><th scope="col">Tipo</th><th scope="col">CCNL · livello</th><th scope="col" class="text-end">RAL</th></tr></thead>
                    <tbody>
                        @if (contratti.Count == 0)
                        {
                            <tr><td colspan="4" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-file-text-line"></i></span><div>Nessun contratto registrato. <a asp-action="Assumi" asp-route-id="@Model.Id">Registra l'assunzione</a></div></td></tr>
                        }
                        @foreach (var c in contratti)
                        {
                            <tr>
                                <td>@c.DataInizio.ToString("dd/MM/yyyy") – @(c.DataFine?.ToString("dd/MM/yyyy") ?? "in corso")</td>
                                <td>@c.Tipo.Descrizione()</td>
                                <td>@c.Ccnl · @c.Livello</td>
                                <td class="text-end">@c.RetribuzioneLordaAnnua.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<section class="mt-4" aria-labelledby="titoloAssenze">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0" id="titoloAssenze">Ferie e permessi @oggi.Year</h2>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#residui" aria-expanded="false" aria-controls="residui">
                <i class="ri-history-line" aria-hidden="true"></i> Residui anno precedente
            </button>
            <a asp-controller="Assenze" asp-action="Nuova" asp-route-dipendenteId="@Model.Id" class="btn btn-primary"><i class="ri-calendar-event-line" aria-hidden="true"></i> Registra assenza</a>
        </div>
    </div>

    <div class="collapse mb-3" id="residui">
        <form asp-controller="Assenze" asp-action="ImpostaResidui" method="post" class="card radius-15 p-3">
            <input type="hidden" name="dipendenteId" value="@Model.Id" />
            <input type="hidden" name="anno" value="@oggi.Year" />
            <p class="small text-body-secondary mb-2">Ore residue al 1° gennaio @oggi.Year (dal cedolino di dicembre o dal gestionale paghe). Possono essere negative.</p>
            <div class="row g-2 align-items-end">
                @foreach (var s in saldi)
                {
                    var nome = s.Tipo switch { TipoAssenza.Ferie => "ferie", TipoAssenza.Rol => "rol", _ => "exFestivita" };
                    <div class="col-sm-3">
                        <label class="form-label small" for="residuo-@nome">@s.Tipo.Descrizione() (ore)</label>
                        <input class="form-control" id="residuo-@nome" name="@nome" type="text" inputmode="decimal" value="@s.ResiduoPrecedente.ToString("0.##")" />
                    </div>
                }
                <div class="col-sm-3"><button type="submit" class="btn btn-primary w-100">Salva residui</button></div>
            </div>
        </form>
    </div>

    <partial name="~/Views/Assenze/_Saldi.cshtml" model="saldi" />
    <p class="small text-body-secondary mt-2">Maturato calcolato fino a @oggi.ToString("MMMM yyyy") in dodicesimi (il mese matura con almeno 15 giorni di rapporto).</p>

    <div class="mt-3">
        <partial name="~/Views/Assenze/_TabellaRichieste.cshtml" model="(richieste, Utente.IsAzienda, false, false, oggi, ritorno)" />
    </div>
</section>

<section class="mt-4" aria-labelledby="titoloBuste">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0" id="titoloBuste">Buste paga</h2>
        @if (Utente.IsConsulente)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#nuovaBusta" aria-expanded="false" aria-controls="nuovaBusta">
                <i class="ri-upload-2-line" aria-hidden="true"></i> Carica cedolino
            </button>
        }
    </div>
    @if (Utente.IsConsulente)
    {
        <div class="collapse mb-3" id="nuovaBusta">
            <form asp-controller="BustePaga" asp-action="CaricaPerDipendente" method="post" enctype="multipart/form-data" class="card radius-15 p-3">
                <input type="hidden" name="dipendenteId" value="@Model.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-sm-2">
                        <label class="form-label small" for="busta-mese">Mese</label>
                        <select class="form-select" id="busta-mese" name="mese">
                            @for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(m == mesePrecedente.Month)">@ServizioBustePaga.NomeMese(m)</option> }
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label small" for="busta-anno">Anno</label>
                        <input class="form-control" id="busta-anno" name="anno" type="number" min="2000" max="2100" value="@mesePrecedente.Year" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label small" for="busta-tipo">Tipo</label>
                        <select class="form-select" id="busta-tipo" name="tipo" asp-items="CL.Web.Controllers.CaricaBusteForm.Tipi"></select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label small" for="busta-netto">Netto (€, facoltativo)</label>
                        <input class="form-control" id="busta-netto" name="netto" type="text" inputmode="decimal" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small" for="busta-file">PDF</label>
                        <input class="form-control" id="busta-file" name="file" type="file" accept="application/pdf,.pdf" required />
                    </div>
                    <div class="col-sm-8">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="busta-pubblica" name="pubblica" value="true" checked />
                            <label class="form-check-label" for="busta-pubblica">Pubblica subito e avvisa il dipendente</label>
                        </div>
                    </div>
                    <div class="col-sm-4"><button type="submit" class="btn btn-primary w-100">Carica</button></div>
                </div>
            </form>
        </div>
    }
    <partial name="~/Views/BustePaga/_TabellaBuste.cshtml" model="(buste, true, Utente.IsConsulente, false, false, ritorno)" />
</section>
