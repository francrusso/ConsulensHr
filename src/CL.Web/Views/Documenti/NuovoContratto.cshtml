@model CL.Web.Controllers.NuovoContrattoForm
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Nuovo contratto";
    ViewData["Percorso"] = new List<(string, string?)> { ("Documenti", null), ("Contratti", Url.Action("Contratti", "Documenti")) };
    var persone = (List<SelectListItem>)ViewBag.Persone;
    var aziende = ViewBag.Aziende as List<SelectListItem>;
}
<div class="breadcrumb-titolo mb-3"><h1 class="titolo-pagina mb-0">Nuovo contratto</h1></div>

@* Prima la persona: una già presente (con ricerca) oppure una nuova, creata qui. Poi si compila il contratto. *@
<form asp-action="NuovoContratto" method="post" novalidate class="card radius-15 p-4 card-panoramica modulo-nuovo-contratto">
    <div asp-validation-summary="All" class="alert alert-danger radius-15" role="alert"></div>

    <div class="invoice-filter-categories filtro-stati scelta-persona mb-4" role="radiogroup" aria-label="Per chi è il contratto">
        <input type="radio" class="btn-check" name="NuovaPersona" id="personaEsistente" value="false" checked="@(!Model.NuovaPersona)" />
        <label class="badge-filtro-categoria" for="personaEsistente"><i class="ri-user-search-line" aria-hidden="true"></i> Persona già presente</label>
        <input type="radio" class="btn-check" name="NuovaPersona" id="personaNuova" value="true" checked="@Model.NuovaPersona" />
        <label class="badge-filtro-categoria" for="personaNuova"><i class="ri-user-add-line" aria-hidden="true"></i> Nuova persona</label>
    </div>

    <div id="campiEsistente" class="campi-presenza">
        <div class="campo-note">
            <label for="DipendenteId" class="form-label">Persona</label>
            <select id="DipendenteId" name="DipendenteId" class="form-select select-persona" data-placeholder="Cerca per nome">
                <option value="">Cerca per nome</option>
                @foreach (var p in persone) { <option value="@p.Value" selected="@(p.Value == Model.DipendenteId?.ToString())">@p.Text</option> }
            </select>
        </div>
    </div>

    <div id="campiNuova" class="campi-presenza" hidden>
        @if (aziende is not null)
        {
            <div class="campo-note">
                <label for="AziendaId" class="form-label">Azienda</label>
                <select id="AziendaId" name="AziendaId" class="form-select" asp-items="aziende"><option value="">Scegli l'azienda</option></select>
            </div>
        }
        <div><label for="Nome" class="form-label">Nome</label><input id="Nome" name="Nome" value="@Model.Nome" class="form-control" maxlength="100" /></div>
        <div><label for="Cognome" class="form-label">Cognome</label><input id="Cognome" name="Cognome" value="@Model.Cognome" class="form-control" maxlength="100" /></div>
        <div><label for="CodiceFiscale" class="form-label">Codice fiscale</label><input id="CodiceFiscale" name="CodiceFiscale" value="@Model.CodiceFiscale" class="form-control text-uppercase" maxlength="16" /></div>
        <div><label for="DataNascita" class="form-label">Data di nascita</label><input id="DataNascita" name="DataNascita" type="date" value="@Model.DataNascita?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Contratti" class="btn btn-outline-secondary">Annulla</a>
        <button type="submit" class="btn btn-primary">Continua con il contratto <i class="ri-arrow-right-line" aria-hidden="true"></i></button>
    </div>
</form>

@section Scripts {
    <script>
        $(function () {
            const nuova = document.getElementById('personaNuova');
            const aggiorna = () => {
                document.getElementById('campiNuova').hidden = !nuova.checked;
                document.getElementById('campiEsistente').hidden = nuova.checked;
            };
            document.querySelectorAll('input[name="NuovaPersona"]').forEach(r => r.addEventListener('change', aggiorna));
            aggiorna();
            if ($.fn.select2) $('.select-persona').select2({ width: '100%', placeholder: 'Cerca per nome', allowClear: true });
        });
    </script>
}
