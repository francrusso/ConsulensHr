@model CL.Domain.Aziende.Azienda
@{
    ViewData["Title"] = Model.RagioneSociale;
    var dipendenti = (List<Dipendente>)ViewBag.Dipendenti;
    var referenti = (List<CL.Web.Infrastruttura.UtenteRiga>)ViewBag.Referenti;
    var profilo = ViewBag.Profilo as CL.Domain.Aziende.ProfiloAzienda;
    var oggi = DateOnly.FromDateTime(DateTime.Today);
}

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <a asp-action="Index" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> Aziende</a>
        <h1 class="titolo-pagina mb-0 d-flex align-items-center gap-2">
            @if (Model.LogoChiave is not null) { <img src="@Url.Action("Logo", new { id = Model.Id })" alt="" class="logo-azienda" /> }
            @Model.RagioneSociale
            @if (!Model.Attiva) { <span class="badge bg-secondary align-middle fs-6">Disattivata</span> }
        </h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Modifica" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="ri-pencil-line" aria-hidden="true"></i> Modifica</a>
        <form asp-action="CambiaStato" asp-route-id="@Model.Id" method="post" class="m-0">
            <button type="submit" class="btn btn-outline-secondary">@(Model.Attiva ? "Disattiva" : "Riattiva")</button>
        </form>
    </div>
</div>

<section class="card radius-15 p-3 mb-3 d-flex flex-row flex-wrap align-items-center justify-content-between gap-2" aria-label="Profilo azienda per lo studio">
    <div>
        <h2 class="h6 mb-1">Profilo per lo studio</h2>
        @if (profilo?.Completato == true)
        {
            <p class="small mb-0"><span class="badge bg-success">Completo</span> Compilato il @profilo.CompletatoIl!.Value.ToLocalTime().ToString("dd/MM/yyyy") da @profilo.CompletatoDa: dati societari, sedi, legale rappresentante, INPS/INAIL e referente paghe.</p>
        }
        else if (profilo is not null)
        {
            <p class="small mb-0"><span class="badge bg-warning text-dark">In compilazione</span> L'azienda è al passo @profilo.Passo di 6. Lo completa il referente al primo accesso, oppure puoi compilarlo tu.</p>
        }
        else
        {
            <p class="small mb-0"><span class="badge bg-secondary">Non iniziato</span> Il referente lo compila al primo accesso al portale; puoi anche compilarlo tu per conto dell'azienda.</p>
        }
    </div>
    <a asp-controller="Onboarding" asp-action="Index" asp-route-aziendaId="@Model.Id" class="btn btn-outline-secondary">
        <i class="ri-file-list-2-line" aria-hidden="true"></i> @(profilo?.Completato == true ? "Vedi profilo" : "Apri il profilo")
    </a>
</section>

<div class="row g-3">
    <div class="col-lg-4">
        <section class="card radius-15 p-4 h-100">
            <h2 class="h6 mb-3">Dati aziendali</h2>
            <dl class="scheda mb-0">
                <dt>Partita IVA</dt><dd>@Model.PartitaIva</dd>
                <dt>Codice fiscale</dt><dd>@(Model.CodiceFiscale ?? "—")</dd>
                <dt>Sede</dt><dd>@(Model.SedeCompleta ?? "—")</dd>
                <dt>Email</dt><dd>@(Model.Email ?? "—")</dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-8">
        <section class="card radius-15 p-1 h-100">
            <div class="d-flex align-items-center justify-content-between px-3 pt-3 pb-2">
                <h2 class="h6 mb-0">Dipendenti (@dipendenti.Count)</h2>
                <a asp-controller="Dipendenti" asp-action="Nuovo" asp-route-aziendaId="@Model.Id" class="btn btn-sm btn-primary"><i class="ri-user-add-line" aria-hidden="true"></i> Nuovo dipendente</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th scope="col">Dipendente</th><th scope="col">Codice fiscale</th><th scope="col">Stato</th></tr></thead>
                    <tbody>
                        @if (dipendenti.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted p-4">Nessun dipendente</td></tr>
                        }
                        @foreach (var d in dipendenti)
                        {
                            <tr>
                                <td><a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@d.Id">@d.NomeCompleto</a></td>
                                <td>@d.CodiceFiscale</td>
                                <td>
                                    @if (d.InForzaIl(oggi)) { <span class="badge bg-success">In forza</span> }
                                    else { <span class="badge bg-secondary">Non in forza</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<section class="mt-4" aria-labelledby="titoloAccessi">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="h5 mb-0" id="titoloAccessi">Referenti con accesso al portale</h2>
            <p class="small text-body-secondary mb-0">Gestiscono anagrafiche, ferie e permessi dei dipendenti di @Model.RagioneSociale.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#nuovoReferente" aria-expanded="false" aria-controls="nuovoReferente">
            <i class="ri-user-add-line" aria-hidden="true"></i> Invita un referente
        </button>
    </div>
    <div class="collapse mb-3" id="nuovoReferente">
        <section class="card radius-15 p-3">
            <partial name="~/Views/Utenti/_FormInvito.cshtml" model='("InvitaReferente", (Guid?)Model.Id, "Invita")' />
        </section>
    </div>
    <partial name="~/Views/Utenti/_TabellaAccessi.cshtml" model='(referenti, Context.Request.Path.ToString(), false)' />
</section>
