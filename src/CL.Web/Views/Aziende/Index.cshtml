@model List<AziendaRiga>
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Aziende";
    // Solo il super amministratore vede la colonna con i consulenti di ogni azienda.
    var colonnaConsulente = Utente.IsAmministratore;
    var consulentiAziende = ViewBag.ConsulentiAziende as Dictionary<Guid, string> ?? new();
    // Pillole per stato, come nell'elenco del personale: di default tutte, anche le disattivate.
    var statoScelto = ViewBag.Stato as StatoAzienda?;
    var conteggi = (Dictionary<StatoAzienda, int>)ViewBag.Conteggi;
    var consulenteId = Context.Request.Query["consulenteId"].FirstOrDefault();
    var colonne = colonnaConsulente ? 7 : 6;
}

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
    <partial name="_FiltroConsulente" />
</div>

<section class="customer-directory">
    <form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
        <div class="invoice-filter-toolbar">
            <div class="invoice-filter-client">
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="ri-search-line" aria-hidden="true"></i></span>
                    <input type="text" name="q" class="form-control" placeholder="Cerca per ragione sociale o partita IVA" aria-label="Cerca aziende" value="@ViewBag.Ricerca" />
                </div>
            </div>
            <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
        </div>
    </form>
    <partial name="_ChipRicerca" />

    <nav class="invoice-filter-categories filtro-stati mb-3" aria-label="Stato dell'azienda">
        <a class="badge-filtro-categoria @(statoScelto is null ? "active" : "")" aria-current="@(statoScelto is null ? "page" : null)"
           asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-consulenteId="@consulenteId">
            Tutte <span>(@ViewBag.Totale)</span>
        </a>
        @foreach (var st in Enum.GetValues<StatoAzienda>())
        {
            <a class="badge-filtro-categoria @(statoScelto == st ? "active" : "")" aria-current="@(statoScelto == st ? "page" : null)"
               asp-action="Index" asp-route-q="@ViewBag.Ricerca" asp-route-consulenteId="@consulenteId" asp-route-stato="@st.Chiave()">
                <span class="pallino-stato" style="--colore-stato:@st.Colore()" aria-hidden="true"></span> @st.Descrizione(plurale: true) <span>(@conteggi[st])</span>
            </a>
        }
    </nav>

    <div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th scope="col">Azienda</th>
                    <th scope="col">Partita IVA</th>
                    <th scope="col">Comune</th>
                    <th scope="col" class="text-end">Personale</th>
                    @if (colonnaConsulente) { <th scope="col">Consulente</th> }
                    <th scope="col">Stato</th>
                    <th scope="col" class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="@colonne" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-building-line"></i></span><div>Nessuna azienda trovata</div></td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr class="customer-result-row">
                        <td data-label="Azienda">
                            <a class="customer-name" asp-action="Dettaglio" asp-route-id="@a.Id"><i class="ri-building-line" aria-hidden="true"></i><span>@a.RagioneSociale</span></a>
                        </td>
                        <td data-label="Partita IVA">@a.PartitaIva</td>
                        <td data-label="Comune">@(string.IsNullOrWhiteSpace(a.Comune) ? "—" : a.Comune)</td>
                        <td data-label="Personale" class="text-end">@a.Dipendenti</td>
                        @if (colonnaConsulente) { <td data-label="Consulente">@(consulentiAziende.GetValueOrDefault(a.Id) ?? "Nessuno")</td> }
                        <td data-label="Stato"><span class="badge badge-stato" style="--colore-stato:@a.Stato.Colore()"><span class="pallino-stato" aria-hidden="true"></span>@a.Stato.Descrizione()</span></td>
                        <td data-label="Azioni">
                            <div class="customer-actions">
                                <a asp-action="Dettaglio" asp-route-id="@a.Id" aria-label="Visualizza azienda" title="Visualizza azienda"><i class="ri-eye-line" aria-hidden="true"></i></a>
                                <a asp-action="Modifica" asp-route-id="@a.Id" aria-label="Modifica azienda" title="Modifica azienda"><i class="ri-pencil-line" aria-hidden="true"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
