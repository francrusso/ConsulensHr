@model CL.Web.Controllers.DatiPersonaliViewModel
@using CL.Web.Controllers
@{
    var p = Model.Profilo;
    ViewData["Title"] = Model.PerConto ? "Dati personali" : p.Completato ? "I miei dati" : "Benvenuto in Consulens HR";
    Guid? dipendenteId = Model.PerConto ? Model.Dipendente.Id : null;
    if (dipendenteId is not null) ViewData["DipendenteIdDati"] = dipendenteId;
    ViewData["FotoUrl"] = Url.Action("Foto", "Dipendenti", new { id = Model.Dipendente.Id });
    ViewData["Completo"] = p.Completato; // i pulsanti delle sezioni: "Salva" invece di "Salva e continua"
}
<div class="breadcrumb-titolo mb-3">
    <div>
        @if (Model.PerConto)
        {
            <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@Model.Dipendente.Id" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @Model.Dipendente.NomeCompleto</a>
            <h1 class="titolo-pagina mb-0">Dati personali di @Model.Dipendente.NomeCompleto</h1>
        }
        else
        {
            <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
            @if (!p.Completato)
            {
                <p class="text-body-secondary mb-0">Per preparare correttamente le tue buste paga il consulente ha bisogno di alcuni dati. Ci vogliono circa 5 minuti; puoi interrompere quando vuoi, ogni passo resta salvato.</p>
            }
        }
    </div>
</div>

@{
    var completo = p.Completato;
    var d = Model.Dipendente;
    var icone = new[] { "ri-user-line", "ri-home-4-line", "ri-bank-card-line", "ri-parent-line", "ri-file-list-3-line" };
}
@* Intestazione come nella scheda della persona: foto (si cambia subito), nome e stato dei dati. *@
<div class="scheda-profilo">
    <div class="card radius-15 p-3 p-md-4 mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <img src="@(d.FotoChiave is not null ? Url.Action("Foto", "Dipendenti", new { id = d.Id }) : Url.Content($"~/assets/images/avatar/{d.Segnaposto}.png"))" class="foto-profilo" alt="Foto di @d.NomeCompleto" />
                <div>
                    <h2 class="fs-5 mb-0 text-breadcrumb nome-profilo d-flex align-items-center gap-2 flex-wrap">
                        @d.NomeCompleto.ToUpperInvariant()
                        <span class="badge badge-stato" style="--colore-stato:@(completo ? "#2FBA6C" : "#F2B544")"><span class="pallino-stato" aria-hidden="true"></span>@(completo ? "Dati completi" : "Da completare")</span>
                    </h2>
                    <div class="azienda-profilo">@d.CodiceFiscale.Valore</div>
                    @if (completo && p.CompletatoIl is { } il) { <div class="mansione-profilo">Completati il @il.ToLocalTime().ToString("dd/MM/yyyy")</div> }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form asp-action="CaricaFoto" method="post" enctype="multipart/form-data" class="m-0">
                    @if (dipendenteId is { } idF) { <input type="hidden" name="dipendenteId" value="@idF" /> }
                    <input type="hidden" name="passo" value="@Model.Passo" />
                    <label for="fotoSubito" class="btn btn-outline-primary btn-sm mb-0">@(d.FotoChiave is null ? "Carica foto" : "Modifica foto") <i class="ri-pencil-line" aria-hidden="true"></i></label>
                    <input type="file" id="fotoSubito" name="immagine" class="d-none" accept="@CL.Web.Infrastruttura.Immagini.FormatiAccettati" onchange="this.form.requestSubmit()" />
                </form>
                @if (d.FotoChiave is not null)
                {
                    <form asp-action="TogliFoto" method="post" class="m-0" onsubmit="return confirm('Rimuovere la foto?');">
                        @if (dipendenteId is { } idT) { <input type="hidden" name="dipendenteId" value="@idT" /> }
                        <input type="hidden" name="passo" value="@Model.Passo" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Rimuovi <i class="ri-delete-bin-line" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (completo)
{
    @* Dati completi: sezioni come schede, con le pillole della scheda della persona. *@
    <nav class="invoice-filter-categories mb-3 schede-profilo-azienda" aria-label="Sezioni dei dati">
        @for (var i = 1; i < DatiPersonaliViewModel.Titoli.Length; i++)
        {
            <a class="badge-filtro-categoria @(Model.Passo == i ? "active" : "")" aria-current="@(Model.Passo == i ? "page" : null)"
               asp-action="Index" asp-route-dipendenteId="@dipendenteId" asp-route-passo="@i"><i class="@icone[i - 1]" aria-hidden="true"></i> @DatiPersonaliViewModel.Titoli[i - 1]</a>
        }
    </nav>
}
else
{
    <nav aria-label="Passi" class="mb-4">
        <ol class="passi-onboarding">
            @for (var i = 1; i <= DatiPersonaliViewModel.Titoli.Length; i++)
            {
                var stato = i == Model.Passo ? "corrente" : i < p.Passo ? "fatto" : "da-fare";
                <li class="passo-@stato">
                    @if (stato != "da-fare" && i != Model.Passo)
                    {
                        <a asp-action="Index" asp-route-dipendenteId="@dipendenteId" asp-route-passo="@i"><span class="numero">@(stato == "fatto" ? "✓" : i.ToString())</span><span class="titolo">@DatiPersonaliViewModel.Titoli[i - 1]</span></a>
                    }
                    else
                    {
                        <span aria-current="@(i == Model.Passo ? "step" : null)"><span class="numero">@i</span><span class="titolo">@DatiPersonaliViewModel.Titoli[i - 1]</span></span>
                    }
                </li>
            }
        </ol>
    </nav>
}

<section class="card radius-15 p-3 p-md-4 modulo-profilo-azienda" aria-labelledby="titoloPasso">
    <h2 class="titolo-sezione-profilo d-flex align-items-center gap-2" id="titoloPasso">
        @if (completo && Model.Passo < DatiPersonaliViewModel.Titoli.Length) { <i class="@icone[Model.Passo - 1]" aria-hidden="true"></i> @DatiPersonaliViewModel.Titoli[Model.Passo - 1] }
        else { @($"{Model.Passo}. {DatiPersonaliViewModel.Titoli[Model.Passo - 1]}") }
    </h2>
    @switch (Model.Passo)
    {
        case 1: <partial name="_Anagrafica" model="(AnagraficaForm)Model.Form!" view-data="ViewData" /> break;
        case 2: <partial name="_Residenza" model="(ResidenzaForm)Model.Form!" view-data="ViewData" /> break;
        case 3: <partial name="_Pagamento" model="(PagamentoForm)Model.Form!" view-data="ViewData" /> break;
        case 4: <partial name="_Famiglia" model="(FamigliaForm)Model.Form!" view-data="ViewData" /> break;
        case 5: <partial name="_Altri" model="(AltriDatiForm)Model.Form!" view-data="ViewData" /> break;
        default: <partial name="_Riepilogo" model="Model" /> break;
    }
</section>

@section Scripts {
    <script>
        // Campi che compaiono solo quando servono (domicilio diverso, fondo pensione).
        document.querySelectorAll('[data-mostra]').forEach(function (controllo) {
            const blocco = document.getElementById(controllo.dataset.mostra);
            const aggiorna = () => blocco.hidden = controllo.type === 'checkbox' ? !controllo.checked : controllo.value !== controllo.dataset.valore;
            controllo.addEventListener('change', aggiorna); aggiorna();
        });
        // Familiari: una riga vuota alla volta.
        document.getElementById('aggiungiFamiliare')?.addEventListener('click', function () {
            const nascosta = document.querySelector('.riga-familiare[hidden]');
            if (nascosta) { nascosta.hidden = false; nascosta.querySelector('input')?.focus(); }
            if (!document.querySelector('.riga-familiare[hidden]')) this.hidden = true;
        });
        document.querySelectorAll('.togli-familiare').forEach(b => b.addEventListener('click', function () {
            const riga = this.closest('.riga-familiare');
            riga.querySelectorAll('input:not([type=checkbox])').forEach(i => i.value = '');
            riga.querySelectorAll('input[type=checkbox]').forEach(i => i.checked = false);
            riga.hidden = true;
            document.getElementById('aggiungiFamiliare').hidden = false;
        }));
    </script>
}
