@model CL.Web.Controllers.OnboardingViewModel
@using CL.Web.Controllers
@{
    ViewData["Title"] = Model.Profilo.Completato || Model.PerContoAzienda ? "Profilo azienda" : "Benvenuto in Consulens HR";
    var p = Model.Profilo;
    var aziendaId = Model.PerContoAzienda ? Model.AziendaId : (Guid?)null;
    if (aziendaId is not null) ViewData["AziendaIdOnboarding"] = aziendaId; // i form del consulente indicano l'azienda
    ViewData["AziendaLogoUrl"] = Url.Action("Logo", "Aziende", new { id = Model.AziendaId });
}
<div class="breadcrumb-titolo mb-3">
    <div>
        @if (Model.PerContoAzienda)
        {
            <a asp-controller="Aziende" asp-action="Dettaglio" asp-route-id="@Model.AziendaId" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @Model.Azienda.RagioneSociale</a>
        }
        <h1 class="titolo-pagina mb-0">@(Model.PerContoAzienda ? "Profilo di " + Model.Azienda.RagioneSociale : ViewData["Title"])</h1>
        @if (!p.Completato && !Model.PerContoAzienda)
        {
            <p class="text-body-secondary mb-0">Prima di iniziare servono alcune informazioni sull'azienda: il consulente le usa per gestire assunzioni, paghe e adempimenti. Ci vogliono circa 10 minuti e puoi interrompere quando vuoi: i dati di ogni passo restano salvati.</p>
        }
    </div>
</div>

<nav aria-label="Passi del profilo" class="mb-4">
    <ol class="passi-onboarding">
        @for (var i = 1; i <= OnboardingViewModel.Titoli.Length; i++)
        {
            var stato = i == Model.Passo ? "corrente" : i < p.Passo || p.Completato ? "fatto" : "da-fare";
            <li class="passo-@stato">
                @if (stato != "da-fare" && i != Model.Passo)
                {
                    <a asp-action="Index" asp-route-aziendaId="@aziendaId" asp-route-passo="@i"><span class="numero">@(stato == "fatto" ? "✓" : i.ToString())</span><span class="titolo">@OnboardingViewModel.Titoli[i - 1]</span></a>
                }
                else
                {
                    <span aria-current="@(i == Model.Passo ? "step" : null)"><span class="numero">@i</span><span class="titolo">@OnboardingViewModel.Titoli[i - 1]</span></span>
                }
            </li>
        }
    </ol>
</nav>

<section class="card radius-15 p-4" aria-labelledby="titoloPasso">
    <h2 class="h5 mb-1" id="titoloPasso">@Model.Passo. @OnboardingViewModel.Titoli[Model.Passo - 1]</h2>
    @switch (Model.Passo)
    {
        case 1: <partial name="_Societari" model="(SocietariForm)Model.Form!" view-data="ViewData" /> break;
        case 2: <partial name="_Sedi" model="(SediForm)Model.Form!" view-data="ViewData" /> break;
        case 3: <partial name="_Legale" model="(LegaleForm)Model.Form!" view-data="ViewData" /> break;
        case 4: <partial name="_Posizioni" model="(PosizioniForm)Model.Form!" view-data="ViewData" /> break;
        case 5: <partial name="_Paghe" model="(PagheForm)Model.Form!" view-data="ViewData" /> break;
        default: <partial name="_Riepilogo" model="Model" /> break;
    }
</section>

@if (p.Completato || Model.PerContoAzienda)
{
    @* Quali richieste l'azienda offre: quelle spente non compaiono a nessuno (moduli, calendari, azioni rapide). *@
    <section class="card radius-15 p-4 mt-3 card-panoramica" id="richiesteAbilitate" aria-labelledby="titoloRichieste">
        <h2 class="titolo-card-panoramica mb-3" id="titoloRichieste"><i class="ri-toggle-line" aria-hidden="true"></i> Tipi di richiesta</h2>
        <form asp-action="RichiesteAbilitate" method="post">
            @if (aziendaId is { } idAz) { <input type="hidden" name="aziendaId" value="@idAz" /> }
            <div class="gruppi-richieste">
                @foreach (var gruppo in CL.Domain.Aziende.TipiRichiesta.Tutti.GroupBy(t => t.Gruppo))
                {
                    <fieldset>
                        <legend class="sottotitolo-presenza">@gruppo.Key</legend>
                        @foreach (var t in gruppo)
                        {
                            var attivo = Model.Azienda.Abilitata(t.Chiave);
                            <div class="form-check form-switch voce-richiesta">
                                <input class="form-check-input" type="checkbox" role="switch" id="tipo-@t.Chiave" name="abilitate" value="@t.Chiave"
                                       checked="@(attivo || t.Obbligatorio)" disabled="@t.Obbligatorio" />
                                <label class="form-check-label" for="tipo-@t.Chiave">@t.Nome @if (t.Obbligatorio) { <span class="nota-campo d-inline">sempre attiva</span> }</label>
                            </div>
                        }
                    </fieldset>
                }
            </div>
            <div class="d-flex justify-content-end mt-3"><button type="submit" class="btn btn-primary">Salva</button></div>
        </form>
    </section>
}

@section Scripts {
    <script>
        // Sede operativa: i campi compaiono solo se diversa dalla legale.
        const diversa = document.getElementById('OperativaDiversa');
        if (diversa) {
            const campi = document.getElementById('campiOperativa');
            const aggiorna = () => campi.hidden = !diversa.checked;
            diversa.addEventListener('change', aggiorna); aggiorna();
        }
    </script>
}
