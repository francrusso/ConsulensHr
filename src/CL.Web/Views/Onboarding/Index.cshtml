@model OnboardingViewModel
@*
    Percorso guidato (profilo da completare): passi numerati, si torna solo a quelli già fatti.
    Profilo completo: le stesse sezioni come schede, più "Tipi di richiesta".
*@
@{
    var p = Model.Profilo;
    var completo = p.Completato;
    ViewData["Title"] = completo || Model.PerContoAzienda ? "Profilo azienda" : "Benvenuto in Consulens HR";
    ViewData["Completo"] = completo; // i pulsanti delle sezioni: "Salva" invece di "Salva e continua"
    ViewData["Subentro"] = Model.Profilo.Subentro; // chi cambia consulente ha già le posizioni
    var aziendaId = Model.PerContoAzienda ? Model.AziendaId : (Guid?)null;
    // Numero mostrato: per una nuova attività il passo "Cambio consulente" non c'è e il riepilogo diventa il 6.
    int Numero(int passo) => !p.Subentro && passo > CL.Domain.Aziende.ProfiloAzienda.PassoSubentro ? passo - 1 : passo;
    if (aziendaId is not null) ViewData["AziendaIdOnboarding"] = aziendaId; // i form del consulente indicano l'azienda (_AziendaId)
    var titoliSchede = new (int Passo, string Titolo, string Icona)[]
    {
        (1, "Dati societari", "ri-building-2-line"), (2, "Sedi", "ri-map-pin-line"), (3, "Legale rappresentante", "ri-user-star-line"),
        (4, "Contratto e posizioni", "ri-file-text-line"), (5, "Paghe e referenti", "ri-bank-card-line"),
        (CL.Domain.Aziende.ProfiloAzienda.PassoSubentro, "Cambio consulente", "ri-exchange-line"),
        (OnboardingController.PassoRichieste, "Tipi di richiesta", "ri-toggle-line"),
    };
}
<div class="breadcrumb-titolo mb-3">
    @if (Model.PerContoAzienda)
    {
        <a asp-controller="Aziende" asp-action="Dettaglio" asp-route-id="@Model.AziendaId" class="small text-body-secondary"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> @Model.Azienda.RagioneSociale</a>
    }
    <h1 class="titolo-pagina mb-0">@(Model.PerContoAzienda ? "Profilo di " + Model.Azienda.RagioneSociale : ViewData["Title"])</h1>
    @if (!completo && !Model.PerContoAzienda)
    {
        <p class="text-body-secondary mb-0">Prima di iniziare servono alcune informazioni sull'azienda: il consulente le usa per gestire assunzioni, paghe e adempimenti. Ci vogliono circa 10 minuti e puoi interrompere quando vuoi: i dati di ogni passo restano salvati.</p>
    }
</div>

@* Intestazione come nella scheda della persona: logo (si cambia subito), nome e stato del profilo. *@
<div class="scheda-profilo">
    <div class="card radius-15 p-3 p-md-4 mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                @if (Model.Azienda.LogoChiave is not null)
                {
                    <img src="@Url.Action("Logo", "Aziende", new { id = Model.AziendaId })" class="foto-profilo logo-profilo" alt="Logo di @Model.Azienda.RagioneSociale" />
                }
                else
                {
                    <span class="foto-profilo logo-profilo logo-vuoto" aria-hidden="true"><i class="ri-building-2-line"></i></span>
                }
                <div>
                    <h2 class="fs-5 mb-0 text-breadcrumb nome-profilo d-flex align-items-center gap-2 flex-wrap">
                        @Model.Azienda.RagioneSociale.ToUpperInvariant()
                        <span class="badge badge-stato" style="--colore-stato:@(completo ? "#2FBA6C" : "#F2B544")"><span class="pallino-stato" aria-hidden="true"></span>@(completo ? "Profilo completo" : "Da completare")</span>
                    </h2>
                    <div class="azienda-profilo">@string.Join(" · ", new[] { p.FormaGiuridica, "P.IVA " + Model.Azienda.PartitaIva.Valore, Model.Azienda.Comune }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                    @if (completo && p.CompletatoIl is { } il) { <div class="mansione-profilo">Completato il @il.ToLocalTime().ToString("dd/MM/yyyy")</div> }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form asp-action="CaricaLogo" method="post" enctype="multipart/form-data" class="m-0">
                    <partial name="_AziendaId" />
                    <input type="hidden" name="passo" value="@Model.Passo" />
                    <label for="logoSubito" class="btn btn-outline-primary btn-sm mb-0">@(Model.Azienda.LogoChiave is null ? "Carica logo" : "Modifica logo") <i class="ri-pencil-line" aria-hidden="true"></i></label>
                    <input type="file" id="logoSubito" name="immagine" class="d-none" accept="@LoghiAziende.FormatiAccettati" onchange="this.form.requestSubmit()" />
                </form>
                @if (Model.Azienda.LogoChiave is not null)
                {
                    <form asp-action="TogliLogo" method="post" class="m-0" onsubmit="return confirm('Rimuovere il logo?');">
                        <partial name="_AziendaId" />
                        <input type="hidden" name="passo" value="@Model.Passo" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Rimuovi <i class="ri-delete-bin-line" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (completo)
{
    @* Profilo completo: sezioni come schede, con le stesse pillole della scheda della persona. *@
    <nav class="invoice-filter-categories mb-3 schede-profilo-azienda" aria-label="Sezioni del profilo">
        @foreach (var (passo, titolo, icona) in titoliSchede.Where(t => t.Passo != CL.Domain.Aziende.ProfiloAzienda.PassoSubentro || p.Subentro))
        {
            <a class="badge-filtro-categoria @(Model.Passo == passo ? "active" : "")" aria-current="@(Model.Passo == passo ? "page" : null)"
               asp-action="Index" asp-route-aziendaId="@aziendaId" asp-route-passo="@passo"><i class="@icona" aria-hidden="true"></i> @titolo</a>
        }
    </nav>
}
else
{
    <nav aria-label="Passi del profilo" class="mb-4">
        <ol class="passi-onboarding">
            @for (var i = 1; i <= OnboardingViewModel.Titoli.Length; i++)
            {
                if (i == CL.Domain.Aziende.ProfiloAzienda.PassoSubentro && !p.Subentro) { continue; } // solo per chi cambia consulente
                var stato = i == Model.Passo ? "corrente" : i < p.Passo ? "fatto" : "da-fare";
                <li class="passo-@stato">
                    @if (stato != "da-fare" && i != Model.Passo)
                    {
                        <a asp-action="Index" asp-route-aziendaId="@aziendaId" asp-route-passo="@i"><span class="numero">@(stato == "fatto" ? "✓" : Numero(i).ToString())</span><span class="titolo">@OnboardingViewModel.Titoli[i - 1]</span></a>
                    }
                    else
                    {
                        <span aria-current="@(i == Model.Passo ? "step" : null)"><span class="numero">@Numero(i)</span><span class="titolo">@OnboardingViewModel.Titoli[i - 1]</span></span>
                    }
                </li>
            }
        </ol>
    </nav>
}

@{
    var titoloSezione = titoliSchede.FirstOrDefault(t => t.Passo == Model.Passo);
}
<section class="card radius-15 p-3 p-md-4 modulo-profilo-azienda" aria-labelledby="titoloPasso">
    <h2 class="titolo-sezione-profilo d-flex align-items-center gap-2" id="titoloPasso">
        @if (completo && titoloSezione.Titolo is not null) { <i class="@titoloSezione.Icona" aria-hidden="true"></i> @titoloSezione.Titolo }
        else { @($"{Numero(Model.Passo)}. {OnboardingViewModel.Titoli[Model.Passo - 1]}") }
    </h2>
    @switch (Model.Passo)
    {
        case 1: <partial name="_Societari" model="(SocietariForm)Model.Form!" view-data="ViewData" /> break;
        case 2: <partial name="_Sedi" model="(SediForm)Model.Form!" view-data="ViewData" /> break;
        case 3: <partial name="_Legale" model="(LegaleForm)Model.Form!" view-data="ViewData" /> break;
        case 4: <partial name="_Posizioni" model="(PosizioniForm)Model.Form!" view-data="ViewData" /> break;
        case CL.Domain.Aziende.ProfiloAzienda.PassoSubentro: <partial name="_Subentro" model="(SubentroForm)Model.Form!" view-data="ViewData" /> break;
        case 5:
            @* Il referente paghe si sceglie nella scheda della persona (dipendente o professionista). *@
            <div class="referente-paghe mb-3">
                <i class="ri-user-star-line" aria-hidden="true"></i>
                @if (Model.ReferentePaghe is { } rp)
                {
                    <div><div class="sottotitolo-presenza mb-0">Referente paghe</div>
                        <a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@rp.Id" class="nome-panoramica">@rp.Nome</a>
                        <span class="dettaglio-presenza">@string.Join(" · ", new[] { rp.Email, rp.Telefono }.Where(x => !string.IsNullOrWhiteSpace(x)))</span></div>
                }
                else
                {
                    <div><div class="sottotitolo-presenza mb-0">Referente paghe</div><span class="dettaglio-presenza">Non indicato: sceglilo nella scheda della persona (Organizzazione › Referente paghe).</span></div>
                }
            </div>
            <partial name="_Paghe" model="(PagheForm)Model.Form!" view-data="ViewData" />
            break;
        case OnboardingController.PassoRichieste: <partial name="_TipiRichiesta" model="Model" /> break;
        default: <partial name="_Riepilogo" model="Model" /> break;
    }
</section>

@section Scripts {
    <script>
        // Righe ripetibili (unità locali, titolari, voci INAIL): "Aggiungi" mostra la prossima riga nascosta, "Togli" la svuota e la nasconde.
        document.querySelectorAll('[data-aggiungi-riga]').forEach(b => b.addEventListener('click', () => {
            const riga = document.querySelector('#' + b.dataset.aggiungiRiga + ' > .riga-ripetibile[hidden]');
            if (riga) { riga.hidden = false; riga.querySelector('input:not([type=hidden])')?.focus(); }
        }));
        document.querySelectorAll('.togli-riga').forEach(b => b.addEventListener('click', () => {
            const riga = b.closest('.riga-ripetibile');
            riga.querySelectorAll('input').forEach(i => i.value = '');
            riga.hidden = true;
        }));
        // Titolari: si compilano solo se il legale rappresentante non è l'unico.
        const unico = document.getElementById('LegaleUnicoTitolare');
        if (unico) {
            const blocco = document.getElementById('blocTitolari');
            const aggiorna = () => blocco.hidden = unico.checked;
            unico.addEventListener('change', aggiorna); aggiorna();
        }
    </script>
}
