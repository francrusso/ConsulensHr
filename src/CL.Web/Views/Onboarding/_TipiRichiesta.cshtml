@model CL.Web.Controllers.OnboardingViewModel
@* Quali richieste l'azienda offre: quelle spente non compaiono a nessuno (moduli, calendari, azioni rapide). *@
@{ var aziendaId = Model.PerContoAzienda ? Model.AziendaId : (Guid?)null; }
<form asp-action="RichiesteAbilitate" method="post">
    @if (aziendaId is { } idAz) { <input type="hidden" name="aziendaId" value="@idAz" /> }
    <div class="gruppi-richieste">
        @foreach (var gruppo in CL.Domain.Aziende.TipiRichiesta.Tutti.GroupBy(t => t.Gruppo))
        {
            <fieldset>
                <legend class="sottotitolo-presenza">@gruppo.Key</legend>
                @foreach (var t in gruppo)
                {
                    var attivo = Model.Azienda.Abilitata(t.Chiave);
                    <div class="form-check form-switch voce-richiesta">
                        <input class="form-check-input" type="checkbox" role="switch" id="tipo-@t.Chiave" name="abilitate" value="@t.Chiave"
                               checked="@(attivo || t.Obbligatorio)" disabled="@t.Obbligatorio" />
                        <label class="form-check-label" for="tipo-@t.Chiave">@t.Nome @if (t.Obbligatorio) { <span class="nota-campo d-inline">sempre attiva</span> }</label>
                    </div>
                }
            </fieldset>
        }
    </div>
    <div class="d-flex justify-content-end mt-4"><button type="submit" class="btn btn-primary">Salva</button></div>
</form>
