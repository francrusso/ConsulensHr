@model CL.Web.Controllers.PagheForm
<form asp-action="Paghe" method="post" novalidate>
    <partial name="_AziendaId" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Iban" class="form-label"></label><input asp-for="Iban" class="form-control text-uppercase" placeholder="IT60X0542811101000000123456" /><span asp-validation-for="Iban" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="GiornoPagamento" class="form-label"></label><input asp-for="GiornoPagamento" type="number" min="1" max="31" class="form-control" placeholder="27" /><span asp-validation-for="GiornoPagamento" class="text-danger"></span></div>
    </div>
    <h3 class="h6 mt-4">Chi segue le paghe in azienda</h3>
    <p class="small text-body-secondary mb-2">La persona a cui il consulente chiederà presenze, variazioni e documenti ogni mese.</p>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="ReferenteNome" class="form-label"></label><input asp-for="ReferenteNome" class="form-control" /><span asp-validation-for="ReferenteNome" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="ReferenteEmail" class="form-label"></label><input asp-for="ReferenteEmail" type="email" class="form-control" /><span asp-validation-for="ReferenteEmail" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="ReferenteTelefono" class="form-label"></label><input asp-for="ReferenteTelefono" type="tel" class="form-control" /></div>
        <div class="col-12"><label asp-for="NoteStudio" class="form-label"></label><textarea asp-for="NoteStudio" class="form-control" rows="3" placeholder="Premi di produzione, buoni pasto, trasferte, accordi aziendali…"></textarea></div>
    </div>
    <partial name="_Pulsanti" model="5" />
</form>
