@model List<CL.Web.Controllers.ConsulenteRiga>
@{
    ViewData["Title"] = "Consulenti";
    var q = ViewBag.Ricerca as string;
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">Consulenti</h1>
</div>

<div class="collapse mb-3" id="nuovoConsulente">
    <section class="card radius-15 p-3 p-md-4">
        <partial name="~/Views/Utenti/_FormInvito.cshtml" model='("InvitaConsulente", (Guid?)null, "Invita")' />
    </section>
</div>

<form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
    <div class="invoice-filter-toolbar">
        <div class="invoice-filter-client">
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="ri-search-line" aria-hidden="true"></i></span>
                <input type="text" name="q" class="form-control" placeholder="Cerca per nome o email" aria-label="Cerca tra i consulenti" value="@q" />
            </div>
        </div>
        <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
    </div>
</form>
<partial name="_ChipRicerca" />

<div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th scope="col">Consulente</th>
                <th scope="col">Email</th>
                <th scope="col" class="text-end">Aziende</th>
                <th scope="col">Stato</th>
                <th scope="col" class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-user-star-line"></i></span><div>Nessun consulente</div></td></tr>
            }
            @foreach (var c in Model)
            {
                <tr class="customer-result-row">
                    <td data-label="Consulente">
                        <a asp-action="Dettaglio" asp-route-id="@c.Id" class="customer-name"><i class="ri-user-star-line" aria-hidden="true"></i><span>@(string.IsNullOrWhiteSpace(c.Nome) ? c.Email : c.Nome)</span></a>
                        @if (c.Amministratore) { <span class="badge bg-secondary ms-1">Super amministratore</span> }
                    </td>
                    <td data-label="Email">@c.Email</td>
                    <td data-label="Aziende" class="text-end">@(c.Amministratore ? "Tutte" : c.Aziende.ToString())</td>
                    <td data-label="Stato"><partial name="~/Views/Utenti/_StatoAccesso.cshtml" model="c.Stato" /></td>
                    <td data-label="Azioni">
                        <div class="customer-actions">
                            <a asp-action="Dettaglio" asp-route-id="@c.Id" title="Aziende assegnate" aria-label="Aziende assegnate a @c.Email"><i class="ri-building-line" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
