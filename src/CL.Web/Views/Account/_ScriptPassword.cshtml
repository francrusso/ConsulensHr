<script>
    document.querySelectorAll('.toggle-password').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const input = document.getElementById(btn.getAttribute('aria-controls'));
            const visibile = input.type === 'text';
            input.type = visibile ? 'password' : 'text';
            btn.setAttribute('aria-pressed', String(!visibile));
            btn.setAttribute('aria-label', visibile ? 'Mostra password' : 'Nascondi password');
            btn.querySelector('i').className = visibile ? 'ri-eye-line' : 'ri-eye-off-line';
        });
    });
</script>
