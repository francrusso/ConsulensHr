@{
    ViewData["Title"] = "Link non valido";
    ViewData["AuthPanel"] = true;
}
<div class="auth-panel">
    <section class="card radius-15 auth-panel-card" aria-labelledby="auth-title">
        <img src="~/assets/images/logo-img.png" class="auth-panel-logo" alt="Consulens" />
        <h1 class="titolo-pagina" id="auth-title">Link non valido</h1>
        <p class="text-body-secondary">Il link è scaduto, è già stato usato oppure l'accesso è stato disattivato. I link valgono 3 giorni.</p>
        <p class="text-body-secondary">Se avevi già scelto la password puoi chiederne una nuova; se stavi attivando l'accesso, chiedi allo studio di inviarti un nuovo invito.</p>
        <div class="d-grid gap-2">
            <a asp-action="PasswordDimenticata" class="btn btn-primary">Chiedi un nuovo link</a>
            <a asp-action="Login" class="btn btn-outline-secondary">Torna all'accesso</a>
        </div>
    </section>
</div>
