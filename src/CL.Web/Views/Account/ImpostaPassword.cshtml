@model CL.Web.Controllers.ImpostaPasswordViewModel
@{
    ViewData["Title"] = Model.PrimoAccesso ? "Attiva il tuo accesso" : "Nuova password";
    ViewData["AuthPanel"] = true;
}
<div class="auth-panel">
    <section class="card radius-15 auth-panel-card" aria-labelledby="auth-title">
        <img src="~/assets/images/logo-img.png" class="auth-panel-logo" alt="Consulens" />
        <h1 class="titolo-pagina" id="auth-title">@ViewData["Title"]</h1>
        <p class="text-body-secondary">
            @(Model.PrimoAccesso ? "Scegli la password per entrare in Consulens HR con" : "Scegli una nuova password per") <strong>@Model.Email</strong>.
            Almeno 10 caratteri, con maiuscole, minuscole e numeri.
        </p>
        <form class="d-grid gap-4" asp-action="ImpostaPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="Uid" />
            <input type="hidden" asp-for="Token" />
            <partial name="_CampoPassword" model='("Password", "Password", "Nuova password", "new-password")' />
            <partial name="_CampoPassword" model='("Conferma", "Conferma", "Ripeti la password", "new-password")' />
            <button type="submit" class="btn btn-primary mt-2">@(Model.PrimoAccesso ? "Attiva e accedi" : "Salva e accedi")</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ScriptPassword" /> }
