@model CL.Web.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Accedi";
    ViewData["AuthPanel"] = true;
}
<div class="auth-panel">
    <section class="card radius-15 auth-panel-card" aria-labelledby="auth-title">
        <img src="~/assets/images/logo-img.png" class="auth-panel-logo" alt="Consulens" />
        <h1 class="titolo-pagina" id="auth-title">Accedi a Consulens HR</h1>
        <form class="d-grid gap-4" asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="configuration-field">
                <label asp-for="Email" class="form-label"></label>
                <i class="ri-user-line configuration-field-icon" aria-hidden="true"></i>
                <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="mariorossi@email.it" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="configuration-field">
                <label asp-for="Password" class="form-label"></label>
                <i class="ri-lock-line configuration-field-icon" aria-hidden="true"></i>
                <div class="input-group" id="show_hide_password">
                    <input asp-for="Password" class="form-control border-end-0" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="input-group-text bg-transparent toggle-password" aria-controls="Password" aria-pressed="false" aria-label="Mostra password">
                        <i class="ri-eye-line" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="form-check form-switch auth-panel-remember">
                    <label asp-for="Ricordami" class="form-check-label">Ricorda accesso</label>
                    <input class="form-check-input" asp-for="Ricordami" />
                </div>
                <a asp-action="PasswordDimenticata" class="small">Password dimenticata?</a>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Accedi</button>
        </form>
    </section>
</div>

@section Scripts { <partial name="_ScriptPassword" /> }
