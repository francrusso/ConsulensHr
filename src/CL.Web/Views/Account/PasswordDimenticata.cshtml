@model CL.Web.Controllers.PasswordDimenticataViewModel
@{
    ViewData["Title"] = "Password dimenticata";
    ViewData["AuthPanel"] = true;
}
<div class="auth-panel">
    <section class="card radius-15 auth-panel-card" aria-labelledby="auth-title">
        <img src="~/assets/images/logo-img.png" class="auth-panel-logo" alt="Consulens" />
        <h1 class="titolo-pagina" id="auth-title">Password dimenticata</h1>
        @if (Model.Inviata)
        {
            <div class="alert alert-success radius-15" role="status">
                Se <strong>@Model.Email</strong> corrisponde a un accesso attivo, riceverai a breve un'email con il link per scegliere una nuova password (valido 3 giorni).
            </div>
            <a asp-action="Login" class="btn btn-outline-secondary">Torna all'accesso</a>
        }
        else
        {
            <p class="text-body-secondary">Inserisci l'email con cui accedi: ti invieremo un link per scegliere una nuova password.</p>
            <form class="d-grid gap-4" asp-action="PasswordDimenticata" method="post" novalidate>
                <div class="configuration-field">
                    <label asp-for="Email" class="form-label"></label>
                    <i class="ri-user-line configuration-field-icon" aria-hidden="true"></i>
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="mariorossi@email.it" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Invia il link</button>
                <a asp-action="Login" class="text-center small">Torna all'accesso</a>
            </form>
        }
    </section>
</div>
