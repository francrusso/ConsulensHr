@model (string Id, string Nome, string Etichetta, string Autocomplete)
@* Campo password con pulsante mostra/nascondi, come nel login. *@
<div class="configuration-field">
    <label for="@Model.Id" class="form-label">@Model.Etichetta</label>
    <i class="ri-lock-line configuration-field-icon" aria-hidden="true"></i>
    <div class="input-group">
        <input type="password" id="@Model.Id" name="@Model.Nome" class="form-control border-end-0" autocomplete="@Model.Autocomplete" aria-required="true" placeholder="••••••••" />
        <button type="button" class="input-group-text bg-transparent toggle-password" aria-controls="@Model.Id" aria-pressed="false" aria-label="Mostra password">
            <i class="ri-eye-line" aria-hidden="true"></i>
        </button>
    </div>
    @Html.ValidationMessage(Model.Nome, new { @class = "text-danger" })
</div>
