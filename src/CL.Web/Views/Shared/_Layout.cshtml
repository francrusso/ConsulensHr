@inject CL.Web.Infrastruttura.UtenteCorrente Utente
@*
    Struttura ripresa da ConsulensNew (sidebar + topbar + page-content) per avere la stessa estetica;
    i colori beige vengono da assets/css/tema-beige.css.
*@
@{
    var autenticato = User.Identity?.IsAuthenticated == true && ViewData["AuthPanel"] is not true;
    var ruolo = Utente.IsConsulente ? "Consulente" : Utente.IsAzienda ? "Referente azienda" : Utente.IsDipendente ? "Dipendente" : "";
    var inOnboarding = User.HasClaim(c => c.Type == CL.Infrastructure.Identity.ClaimsPersonalizzati.OnboardingDaCompletare);

    // Pulsante "aggiungi" nella barra in alto, in base alla sezione (come in ConsulensNew).
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var esterniAttivi = Context.Request.Query["esterni"] == "true";
    var aziendaQuery = Context.Request.Query["aziendaId"].FirstOrDefault();
    (string? Url, string Etichetta, string Icona) azione = inOnboarding ? (null, "", "") : controller switch
    {
        "dipendenti" when !Utente.IsDipendente => (Url.Action("Nuovo", "Dipendenti", new { aziendaId = aziendaQuery }),
            esterniAttivi ? "Aggiungi professionista" : Utente.IsAzienda ? "Aggiungi persona" : "Nuovo dipendente", "ri-user-add-line"),
        "aziende" when Utente.IsConsulente => (Url.Action("Nuova", "Aziende"), "Nuova azienda", "ri-add-line"),
        "team" when (ViewContext.RouteData.Values["action"] as string) == "Index" => ("#nuovoTeam", "Nuovo team", "ri-add-line"),
        "assenze" => (Url.Action("Nuova", "Assenze"), Utente.IsDipendente ? "Nuova richiesta" : "Registra assenza", "ri-calendar-event-line"),
        "bustepaga" when Utente.IsConsulente => (Url.Action("Carica", "BustePaga"), "Carica cedolini", "ri-upload-2-line"),
        "home" => Utente.IsConsulente ? (Url.Action("Nuova", "Aziende"), "Nuova azienda", "ri-add-line")
            : Utente.IsAzienda ? (Url.Action("Nuovo", "Dipendenti"), "Aggiungi persona", "ri-user-add-line")
            : (Url.Action("Nuova", "Assenze"), "Chiedi ferie o permessi", "ri-calendar-event-line"),
        _ => (null, "", ""),
    };
}
<!DOCTYPE html>
<html lang="it" class="@(ViewData["AuthPanel"] is true ? "auth-panel-page" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Consulens HR</title>
    <link rel="icon" href="~/assets/images/favicon-32x32.png" type="image/png" sizes="32x32" asp-append-version="true" />
    <link rel="icon" href="~/assets/images/favicon-192x192.png" type="image/png" sizes="192x192" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/assets/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/simplebar/css/simplebar.css" />
    <link rel="stylesheet" href="~/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/plugins/metismenu/css/metisMenu.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/assets/plugins/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/assets/css/icons.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/authentication.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/tema-beige.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>

<body>
    <div class="wrapper">
        @if (autenticato)
        {
            <div class="sidebar-wrapper">
                <div class="sidebar-header">
                    <div class="loghi">
                        <img src="~/assets/images/logo-img.png" class="logo-img" alt="Consulens" id="logo-img" />
                        <img src="~/assets/images/logo-icon.png" alt="Consulens" id="logo-icon" style="display:none" width="50" />
                    </div>
                    <button type="button" class="toggle-btn sidebar-collapse" aria-label="Riduci o espandi il menù" aria-expanded="true">
                        <i class="ri-side-bar-line" aria-hidden="true"></i>
                    </button>
                    <a href="javascript:;" class="close-menu-mobile" style="display: none">
                        <i class="ri-close-line ri-xs icon-color-1"></i>
                    </a>
                </div>
                <div class="sidebar-body" data-simplebar="true">
                    <ul class="metismenu" id="menu">
                        @if (inOnboarding)
                        {
                            <li>
                                <a asp-controller="@(Utente.IsDipendente ? "DatiPersonali" : "Onboarding")" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="@(Utente.IsDipendente ? "ri-user-settings-line" : "ri-building-2-line") ri-xs"></i></div>
                                    <div class="menu-title">@(Utente.IsDipendente ? "I miei dati" : "Profilo azienda")</div>
                                </a>
                            </li>
                        }
                        else
                        {
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <div class="parent-icon icon-color-1"><i class="ri-dashboard-line ri-xs"></i></div>
                                <div class="menu-title">Panoramica</div>
                            </a>
                        </li>
                        @if (Utente.IsConsulente)
                        {
                            <li>
                                <a asp-controller="Aziende" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-building-line ri-xs"></i></div>
                                    <div class="menu-title">Aziende</div>
                                </a>
                            </li>
                        }
                        @if (Utente.IsAzienda)
                        {
                            <li>
                                <a href="javascript:;" class="has-arrow">
                                    <div class="parent-icon icon-color-1"><i class="ri-team-line ri-xs"></i></div>
                                    <div class="menu-title">Personale</div>
                                </a>
                                <ul>
                                    <li><a asp-controller="Dipendenti" asp-action="Index">Elenco personale</a></li>
                                    <li><a asp-controller="Team" asp-action="Index">Team</a></li>
                                    <li><a asp-controller="Team" asp-action="Organigramma">Organigramma</a></li>
                                    <li><a asp-controller="Utenti" asp-action="Azienda">Referenti</a></li>
                                </ul>
                            </li>
                        }
                        else if (Utente.IsConsulente)
                        {
                            <li>
                                <a asp-controller="Dipendenti" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-team-line ri-xs"></i></div>
                                    <div class="menu-title">Dipendenti</div>
                                </a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Assenze" asp-action="Index">
                                <div class="parent-icon icon-color-1"><i class="ri-calendar-event-line ri-xs"></i></div>
                                <div class="menu-title">Ferie e permessi</div>
                            </a>
                        </li>
                        @if (Utente.IsConsulente || Utente.IsAzienda)
                        {
                            <li>
                                <a asp-controller="Presenze" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-time-line ri-xs"></i></div>
                                    <div class="menu-title">Presenze</div>
                                </a>
                            </li>
                        }
                        <li>
                            <a href="javascript:;" class="has-arrow">
                                <div class="parent-icon icon-color-1"><i class="ri-folder-3-line ri-xs"></i></div>
                                <div class="menu-title">Documenti</div>
                            </a>
                            <ul>
                                <li><a asp-controller="BustePaga" asp-action="Index">Buste paga</a></li>
                                <li><a asp-controller="Documenti" asp-action="Cu">CU</a></li>
                                <li><a asp-controller="Documenti" asp-action="Contratti">Contratti</a></li>
                            </ul>
                        </li>
                        @if (Utente.IsConsulente)
                        {
                            <li>
                                <a asp-controller="Utenti" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-shield-user-line ri-xs"></i></div>
                                    <div class="menu-title">Utenti</div>
                                </a>
                            </li>
                        }
                        @if (Utente.IsDipendente)
                        {
                            <li>
                                <a asp-controller="DatiPersonali" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-user-settings-line ri-xs"></i></div>
                                    <div class="menu-title">I miei dati</div>
                                </a>
                            </li>
                        }
                        @if (Utente.IsAzienda)
                        {
                            <li>
                                <a asp-controller="Onboarding" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="ri-building-2-line ri-xs"></i></div>
                                    <div class="menu-title">Profilo azienda</div>
                                </a>
                            </li>
                        }
                        }
                    </ul>
                </div>
                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="sidebar-logout" title="Esci">
                            <div class="parent-icon"><i class="ri-logout-circle-line ri-xs"></i></div>
                            <div class="menu-title-select">Esci</div>
                        </button>
                    </form>
                </div>
            </div>

            <header class="top-header" id="header">
                <nav class="navbar navbar-expand">
                    <div class="button right-topbar d-flex">
                        <a href="javascript:;" class="toggle-btn ms-auto"><i class="ri-menu-2-line ri-xs icon-color-1"></i></a>
                    </div>
                    <div class="left-topbar">
                        <a href="javascript:;" class="toggle-btn-mobile"><i class="ri-menu-2-line ri-xs icon-color-1"></i></a>
                    </div>

                    <div class="topbar-search" role="search" aria-label="Cerca nelle sezioni">
                        <i class="ri-search-line" aria-hidden="true"></i>
                        <input type="search" id="navigation-search" placeholder="Cerca" autocomplete="off" aria-expanded="false"
                               aria-haspopup="true" aria-label="Cerca nelle sezioni del menù" aria-controls="navigation-search-results" />
                        <div id="navigation-search-results" class="topbar-search-results" aria-label="Risultati ricerca" hidden></div>
                        <span class="visually-hidden" id="navigation-search-status" role="status"></span>
                    </div>

                    <div class="right-topbar ms-auto d-flex align-items-center">
                        @if (!Utente.IsConsulente && Utente.AziendaId is { } aziendaLogo)
                        {
                            @* Logo dell'azienda per referenti e dipendenti; se non c'è, l'immagine si toglie da sola. *@
                            <img src="@Url.Action("Logo", "Aziende", new { id = aziendaLogo })" alt="" class="topbar-logo-azienda d-none d-md-block" onerror="this.remove()" />
                        }
                        <ul class="navbar-nav">
                            @if (azione.Url is not null)
                            {
                                <li class="nav-item topbar-create">
                                    <a class="btn btn-primary" href="@azione.Url" title="@azione.Etichetta" data-bs-toggle="@(azione.Url!.StartsWith('#') ? "collapse" : null)">
                                        <i class="@azione.Icona" aria-hidden="true"></i><span>@azione.Etichetta</span>
                                    </a>
                                </li>
                            }
                            @* Notifiche: la sezione verrà sviluppata in seguito; per ora il menù è vuoto. *@
                            <li class="nav-item dropdown dropdown-lg topbar-notifications">
                                <a class="nav-link dropdown-toggle dropdown-toggle-nocaret position-relative" href="javascript:;" data-bs-toggle="dropdown"
                                   aria-label="Notifiche" aria-expanded="false">
                                    <i class="ri-notification-2-line vertical-align-middle" aria-hidden="true"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <div class="notifications-heading">
                                        <h6>Notifiche</h6>
                                        <span>0 da leggere</span>
                                    </div>
                                    <div class="header-notifications-list">
                                        <div class="notifications-empty">
                                            <i class="ri-notification-2-line" aria-hidden="true"></i>
                                            <p>Non ci sono notifiche</p>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item topbar-profile">
                                <a class="nav-link" asp-controller="Account" asp-action="Profilo" title="Il mio profilo">
                                    <div class="d-flex user-box align-items-center">
                                        <img src="~/assets/images/avatars/avatar-1.jpg" class="user-img" alt="" />
                                        <div class="user-info">
                                            <p class="user-name mb-0">@Utente.Nome</p>
                                            <p class="designattion mb-0">@ruolo</p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <div class="page-wrapper">
                <main role="main" id="body-pd" class="page-content-wrapper">
                    <div class="page-content">
                        <partial name="_PageBreadcrumbs" />
                        <partial name="_Messaggi" />
                        @RenderBody()
                    </div>
                    <footer class="page-footer">
                        <p>&copy; @DateTime.Now.Year Consulens</p>
                    </footer>
                </main>
            </div>
        }
        else
        {
            <div class="@(ViewData["AuthPanel"] is true ? "container-fluid p-0" : "container")">
                <main role="main" id="body-pd">
                    @RenderBody()
                </main>
            </div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/assets/plugins/metismenu/js/metisMenu.min.js"></script>
    <script src="~/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
    <script src="~/assets/plugins/select2/js/select2.min.js"></script>
    <script src="~/js/indirizzi.js" asp-append-version="true"></script>
    <script src="~/js/moduli.js" asp-append-version="true"></script>
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
