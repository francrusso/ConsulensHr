@inject UtenteCorrente Utente
@inject ServizioAvatar Avatar
@inject ServizioNotifiche Notifiche
@*
    Struttura ripresa da ConsulensNew (sidebar + topbar + page-content) per avere la stessa estetica;
    i colori beige vengono da assets/css/tema-beige.css.
    Le pagine di accesso (login, password) impostano ViewData["AuthPanel"]: niente menù né barra in alto.
*@
@{
    var autenticato = User.Identity?.IsAuthenticated == true && ViewData["AuthPanel"] is not true;
    var ruolo = Utente.IsAmministratore ? "Super amministratore" : Utente.IsConsulente ? "Consulente" : Utente.IsAzienda ? "Referente azienda" : Utente.IsDipendente ? await Avatar.MansioneAsync() : "";
    var inOnboarding = User.HasClaim(c => c.Type == CL.Infrastructure.Identity.ClaimsPersonalizzati.OnboardingDaCompletare);

    // Pulsante "aggiungi" nella barra in alto: dipende dalla sezione e dalla pagina (come in ConsulensNew) e da chi guarda.
    // Url null = nessun pulsante; "#id" apre il pannello a scomparsa della pagina invece di cambiare pagina.
    var sezione = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var pagina = ViewContext.RouteData.Values["action"] as string ?? "";
    var query = Context.Request.Query;
    var gestisce = !Utente.IsDipendente; // consulente o referente azienda
    (string? Url, string Etichetta, string Icona) azione = inOnboarding ? (null, "", "") : (sezione, pagina) switch
    {
        ("turni", "Salvati" or "Modello") when Utente.IsAzienda || Utente.IsConsulente => (Url.Action("Modello", "Turni"), "Crea turno salvato", "ri-add-line"),
        ("onboarding", _) when Utente.IsConsulente => (Url.Action("Nuovo", "Dipendenti", new { aziendaId = query["aziendaId"].FirstOrDefault() }), "Aggiungi persona", "ri-user-add-line"),
        ("dipendenti", "Dettaglio") when gestisce && query["sezione"] == "contratto" => (Url.Action("Assumi", "Dipendenti", new { id = ViewContext.RouteData.Values["id"] }), "Nuovo contratto", "ri-file-add-line"),
        ("dipendenti", _) when gestisce => (Url.Action("Nuovo", "Dipendenti", new { aziendaId = query["aziendaId"].FirstOrDefault() }),
            query["esterni"] == "true" ? "Aggiungi professionista" : "Aggiungi persona", "ri-user-add-line"),
        ("aziende", _) when Utente.IsConsulente => (Url.Action("Nuova", "Aziende"), "Nuova azienda", "ri-add-line"),
        ("turni", "Index") when Utente.IsAzienda || Utente.IsConsulente => (Url.Action("Modifica", "Turni"), "Nuovo turno", "ri-add-line"),
        ("team", "Index") => ("#nuovoTeam", "Nuovo team", "ri-add-line"),
        ("utenti", "Index" or "Nuovo") when Utente.IsConsulente => (Url.Action("Nuovo", "Utenti"), "Aggiungi altro utente", "ri-user-add-line"),
        ("consulenti", "Index") => ("#nuovoConsulente", "Nuovo consulente", "ri-user-add-line"),
        ("assenze" or "ufficio", _) => (Url.Action("Nuova", "Assenze"), "Nuova richiesta", "ri-calendar-event-line"),
        ("bustepaga", _) when gestisce => (Url.Action("Carica", "BustePaga"), "Carica busta paga", "ri-upload-2-line"),
        ("documenti", "Contratti" or "NuovoContratto") when gestisce => (Url.Action("NuovoContratto", "Documenti"), "Nuovo contratto", "ri-file-add-line"),
        ("documenti", "Cu" or "NuovaCu") when gestisce
            => (Url.Action("NuovaCu", "Documenti", new { anno = query["anno"].FirstOrDefault() }), "Carica CU", "ri-upload-2-line"),
        ("documenti", "Storico" or "NuovoStorico") when gestisce => (Url.Action("NuovoStorico", "Documenti"), "Carica documento", "ri-upload-2-line"),
        ("documenti", "Personali" or "NuovoPersonale") => (Url.Action("NuovoPersonale", "Documenti"), "Carica documento", "ri-upload-2-line"),
        ("home", _) when Utente.IsConsulente => (Url.Action("Nuova", "Aziende"), "Nuova azienda", "ri-add-line"),
        ("home", _) when Utente.IsAzienda => (Url.Action("Nuovo", "Dipendenti"), "Aggiungi persona", "ri-user-add-line"),
        ("home", _) => (Url.Action("Nuova", "Assenze"), "Nuova richiesta", "ri-calendar-event-line"),
        _ when Utente.IsDipendente => (Url.Action("Nuova", "Assenze"), "Nuova richiesta", "ri-calendar-event-line"),
        _ => (null, "", ""),
    };
}
<!DOCTYPE html>
<html lang="it" class="@(ViewData["AuthPanel"] is true ? "auth-panel-page" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Consulens HR</title>
    <link rel="icon" href="~/assets/images/favicon-32x32.png" type="image/png" sizes="32x32" asp-append-version="true" />
    <link rel="icon" href="~/assets/images/favicon-192x192.png" type="image/png" sizes="192x192" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/assets/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/simplebar/css/simplebar.css" />
    <link rel="stylesheet" href="~/assets/plugins/metismenu/css/metisMenu.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/assets/plugins/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/assets/css/icons.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/authentication.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/tema-beige.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>

<body>
    <div class="wrapper">
        @if (autenticato)
        {
            <div class="sidebar-wrapper">
                <div class="sidebar-header">
                    @{
                        // Il dipendente vede il marchio della sua azienda, come in un portale interno; senza logo, il nome.
                        var marchio = await Avatar.MarchioAsync();
                    }
                    @if (marchio is null)
                    {
                        <div class="loghi">
                            <img src="~/assets/images/logo-img.png" class="logo-img" alt="Consulens" id="logo-img" />
                            <img src="~/assets/images/logo-icon.png" alt="Consulens" id="logo-icon" style="display:none" width="50" />
                        </div>
                    }
                    else if (marchio.HaLogo)
                    {
                        var srcLogo = Url.Action("Logo", "Aziende", new { id = marchio.Id });
                        <div class="loghi loghi-azienda">
                            <img src="@srcLogo" class="logo-img" alt="@marchio.Nome" id="logo-img" />
                            <img src="@srcLogo" alt="@marchio.Nome" id="logo-icon" style="display:none" />
                        </div>
                    }
                    else
                    {
                        <div class="loghi loghi-azienda">
                            <span class="logo-img logo-nome" id="logo-img" title="@marchio.Nome">@marchio.Nome</span>
                            <span class="logo-iniziale" id="logo-icon" style="display:none" title="@marchio.Nome">@marchio.Nome.Trim()[..1].ToUpperInvariant()</span>
                        </div>
                    }
                    <button type="button" class="toggle-btn sidebar-collapse" aria-label="Riduci o espandi il menù" aria-expanded="true">
                        <i class="ri-side-bar-line" aria-hidden="true"></i>
                    </button>
                    <a href="javascript:;" class="close-menu-mobile" style="display: none">
                        <i class="ri-close-line ri-xs icon-color-1"></i>
                    </a>
                </div>
                <div class="sidebar-body" data-simplebar="true">
                    <ul class="metismenu" id="menu">
                        @if (inOnboarding)
                        {
                            <li>
                                <a asp-controller="@(Utente.IsDipendente ? "DatiPersonali" : "Onboarding")" asp-action="Index">
                                    <div class="parent-icon icon-color-1"><i class="@(Utente.IsDipendente ? "ri-user-settings-line" : "ri-building-2-line") ri-xs"></i></div>
                                    <div class="menu-title">@(Utente.IsDipendente ? "I miei dati" : "Profilo azienda")</div>
                                </a>
                            </li>
                        }
                        else
                        {
                            @*
                                Voci per ruolo:
                                dipendente: I miei dati, Il mio contratto, Calendario, Richieste, Documenti (buste paga e CU);
                                referente azienda: Panoramica, Profilo azienda, Personale (elenco, team, organigramma), Presenze e assenze, Documenti;
                                consulente: Panoramica, Aziende, Personale, Presenze e assenze, Documenti, Consulenti (solo super amministratore), Utenti.
                                Durante il percorso guidato (sopra) c'è solo la voce del profilo da completare.
                            *@
                            if (Utente.IsDipendente)
                            {
                                <li>
                                    <a asp-controller="DatiPersonali" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-user-settings-line ri-xs"></i></div>
                                        <div class="menu-title">I miei dati</div>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="MioContratto" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-file-text-line ri-xs"></i></div>
                                        <div class="menu-title">Il mio contratto</div>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-controller="Home" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-dashboard-line ri-xs"></i></div>
                                        <div class="menu-title">Panoramica</div>
                                    </a>
                                </li>
                            }
                            @* Per l'azienda: subito dopo la panoramica. *@
                            if (Utente.IsAzienda)
                            {
                                <li>
                                    <a asp-controller="Onboarding" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-building-2-line ri-xs"></i></div>
                                        <div class="menu-title">Profilo azienda</div>
                                    </a>
                                </li>
                            }
                            if (Utente.IsConsulente)
                            {
                                <li>
                                    <a asp-controller="Aziende" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-building-line ri-xs"></i></div>
                                        <div class="menu-title">Aziende</div>
                                    </a>
                                </li>
                            }
                            if (Utente.IsAzienda)
                            {
                                <li>
                                    <a href="javascript:;" class="has-arrow">
                                        <div class="parent-icon icon-color-1"><i class="ri-team-line ri-xs"></i></div>
                                        <div class="menu-title">Personale</div>
                                    </a>
                                    <ul>
                                        <li><a asp-controller="Dipendenti" asp-action="Index">Elenco personale</a></li>
                                        <li><a asp-controller="Team" asp-action="Index">Team</a></li>
                                        <li><a asp-controller="Team" asp-action="Organigramma">Organigramma</a></li>
                                    </ul>
                                </li>
                            }
                            else if (Utente.IsConsulente)
                            {
                                <li>
                                    <a asp-controller="Dipendenti" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-team-line ri-xs"></i></div>
                                        <div class="menu-title">Personale</div>
                                    </a>
                                </li>
                            }
                            if (Utente.IsDipendente)
                            {
                                @* Il dipendente: calendario (prima pagina) e richieste come voci singole. *@
                                <li>
                                    <a asp-controller="Ufficio" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-calendar-2-line ri-xs"></i></div>
                                        <div class="menu-title">Calendario</div>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Assenze" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-calendar-check-line ri-xs"></i></div>
                                        <div class="menu-title">Richieste</div>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a href="javascript:;" class="has-arrow">
                                        <div class="parent-icon icon-color-1"><i class="ri-calendar-event-line ri-xs"></i></div>
                                        <div class="menu-title">Presenze e assenze</div>
                                    </a>
                                    <ul>
                                        <li><a asp-controller="Assenze" asp-action="Calendario">Calendario</a></li>
                                        <li><a asp-controller="Assenze" asp-action="Index">Richieste</a></li>
                                        <li><a asp-controller="Presenze" asp-action="Index">Riepilogo presenze</a></li>
                                    </ul>
                                </li>
                            }
                            @if (Utente.IsDipendente)
                            {
                                <li><a asp-controller="Turni" asp-action="Index"><div class="parent-icon icon-color-1"><i class="ri-time-line ri-xs"></i></div><div class="menu-title">I miei turni</div></a></li>
                            }
                            else
                            {
                                <li><a href="javascript:;" class="has-arrow"><div class="parent-icon icon-color-1"><i class="ri-time-line ri-xs"></i></div><div class="menu-title">Turni di lavoro</div></a>
                                    <ul><li><a asp-controller="Turni" asp-action="Index">Calendario turni</a></li><li><a asp-controller="Turni" asp-action="Salvati">Turni salvati</a></li></ul>
                                </li>
                            }
                            <li>
                                <a href="javascript:;" class="has-arrow">
                                    <div class="parent-icon icon-color-1"><i class="ri-folder-3-line ri-xs"></i></div>
                                    <div class="menu-title">Documenti</div>
                                </a>
                                <ul>
                                    <li><a asp-controller="BustePaga" asp-action="Index">Buste paga</a></li>
                                    <li><a asp-controller="Documenti" asp-action="Cu">CU</a></li>
                                    @if (!Utente.IsDipendente) { <li><a asp-controller="Documenti" asp-action="Contratti">Contratti</a></li> }
                                    @if (!Utente.IsDipendente) { <li><a asp-controller="Documenti" asp-action="Storico">Archivio storico</a></li> }
                                    <li><a asp-controller="Documenti" asp-action="Personali">@(Utente.IsDipendente ? "I miei documenti" : "Documenti personali")</a></li>
                                </ul>
                            </li>
                            if (Utente.IsAmministratore)
                            {
                                <li>
                                    <a asp-controller="Consulenti" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-user-star-line ri-xs"></i></div>
                                        <div class="menu-title">Consulenti</div>
                                    </a>
                                </li>
                            }
                            if (Utente.IsConsulente)
                            {
                                <li>
                                    <a asp-controller="Utenti" asp-action="Index">
                                        <div class="parent-icon icon-color-1"><i class="ri-shield-user-line ri-xs"></i></div>
                                        <div class="menu-title">Utenti</div>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="sidebar-logout" title="Esci">
                            <div class="parent-icon"><i class="ri-logout-circle-line ri-xs"></i></div>
                            <div class="menu-title-select">Esci</div>
                        </button>
                    </form>
                </div>
            </div>

            <header class="top-header" id="header">
                <nav class="navbar navbar-expand">
                    <div class="button right-topbar d-flex">
                        <a href="javascript:;" class="toggle-btn ms-auto"><i class="ri-menu-2-line ri-xs icon-color-1"></i></a>
                    </div>
                    <div class="left-topbar">
                        <a href="javascript:;" class="toggle-btn-mobile"><i class="ri-menu-2-line ri-xs icon-color-1"></i></a>
                    </div>

                    <div class="topbar-search" role="search" aria-label="Cerca nelle sezioni">
                        <i class="ri-search-line" aria-hidden="true"></i>
                        <input type="search" id="navigation-search" placeholder="Cerca" autocomplete="off" aria-expanded="false"
                               aria-haspopup="true" aria-label="Cerca nelle sezioni del menù" aria-controls="navigation-search-results" />
                        <div id="navigation-search-results" class="topbar-search-results" aria-label="Risultati ricerca" hidden></div>
                        <span class="visually-hidden" id="navigation-search-status" role="status"></span>
                    </div>

                    <div class="right-topbar ms-auto d-flex align-items-center">
                        <ul class="navbar-nav">
                            @if (azione.Url is not null)
                            {
                                <li class="nav-item topbar-create">
                                    <a class="btn btn-primary" href="@azione.Url" title="@azione.Etichetta" data-bs-toggle="@(azione.Url!.StartsWith('#') ? "collapse" : null)">
                                        <i class="@azione.Icona" aria-hidden="true"></i><span>@azione.Etichetta</span>
                                    </a>
                                </li>
                            }
                            @{
                                // Campanella: le ultime notifiche e quante sono da leggere (la pagina Notifiche ha tutto).
                                var daLeggere = await Notifiche.DaLeggereAsync();
                                var ultime = await Notifiche.UltimeAsync();
                            }
                            <li class="nav-item dropdown dropdown-lg topbar-notifications">
                                <a class="nav-link dropdown-toggle dropdown-toggle-nocaret position-relative" href="javascript:;" data-bs-toggle="dropdown"
                                   aria-label="@(daLeggere > 0 ? $"Notifiche, {daLeggere} da leggere" : "Notifiche")" aria-expanded="false">
                                    <i class="ri-notification-2-line vertical-align-middle" aria-hidden="true"></i>
                                    @if (daLeggere > 0) { <span class="msg-count" aria-hidden="true">@(daLeggere > 99 ? "99+" : daLeggere)</span> }
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <div class="notifications-heading">
                                        <h6>Notifiche</h6>
                                        <span>@daLeggere da leggere</span>
                                        <a asp-controller="Notifiche" asp-action="Impostazioni" class="notifications-settings" title="Impostazioni notifiche" aria-label="Impostazioni notifiche"><i class="ri-settings-3-line" aria-hidden="true"></i></a>
                                    </div>
                                    <div class="header-notifications-list">
                                        @if (ultime.Count == 0)
                                        {
                                            <div class="notifications-empty">
                                                <i class="ri-notification-2-line" aria-hidden="true"></i>
                                                <p>Non ci sono notifiche</p>
                                            </div>
                                        }
                                        @foreach (var n in ultime)
                                        {
                                            <a class="dropdown-item notification-entry @(n.Letta ? "" : "notification-unread")" asp-controller="Notifiche" asp-action="Apri" asp-route-id="@n.Id">
                                                <h6 class="msg-name mb-1"><i class="@IconeNotifiche.Di(CL.Domain.Notifiche.CategoriaNotificaExtensions.Categoria(n.Tipo)) me-1" aria-hidden="true"></i>@n.Titolo</h6>
                                                <p class="msg-time mb-0">@n.CreataIl.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")@(n.Letta ? "" : " · da leggere")</p>
                                            </a>
                                        }
                                    </div>
                                    <a asp-controller="Notifiche" asp-action="Index"><div class="text-center msg-footer">Tutte le notifiche</div></a>
                                </div>
                            </li>
                            <li class="nav-item topbar-profile">
                                <a class="nav-link" asp-controller="Account" asp-action="Profilo" title="Il mio profilo">
                                    <div class="d-flex user-box align-items-center">
                                        @{
                                            // Foto della persona; per l'azienda il logo (se il referente non ha una foto); altrimenti il segnaposto.
                                            var (origine, idImmagine) = await Avatar.ImmagineAsync();
                                            var srcAvatar = origine switch
                                            {
                                                ServizioAvatar.Origine.Foto => Url.Action("Foto", "Dipendenti", new { id = idImmagine }),
                                                ServizioAvatar.Origine.Logo => Url.Action("Logo", "Aziende", new { id = idImmagine }),
                                                _ => Url.Content("~/assets/images/avatars/avatar-1.jpg"),
                                            };
                                        }
                                        <img src="@srcAvatar" class="user-img @(origine == ServizioAvatar.Origine.Logo ? "user-img-logo" : "")" alt="" />
                                        <div class="user-info">
                                            <p class="user-name mb-0">@Utente.Nome</p>
                                            <p class="designattion mb-0">@ruolo</p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <div class="page-wrapper">
                <main role="main" id="body-pd" class="page-content-wrapper">
                    <div class="page-content">
                        <partial name="_PageBreadcrumbs" />
                        <partial name="_Messaggi" />
                        @RenderBody()
                    </div>
                    <footer class="page-footer">
                        <p>&copy; @DateTime.Now.Year Consulens</p>
                    </footer>
                </main>
            </div>
        }
        else
        {
            <div class="@(ViewData["AuthPanel"] is true ? "container-fluid p-0" : "container")">
                <main role="main" id="body-pd">
                    @RenderBody()
                </main>
            </div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/assets/plugins/metismenu/js/metisMenu.min.js"></script>
    <script src="~/assets/plugins/select2/js/select2.min.js"></script>
    <script src="~/js/indirizzi.js" asp-append-version="true"></script>
    <script src="~/js/moduli.js" asp-append-version="true"></script>
    <script src="~/js/chip-filtri.js" asp-append-version="true"></script>
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
