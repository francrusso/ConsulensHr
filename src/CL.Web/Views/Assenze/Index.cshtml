@model CL.Web.Controllers.AssenzeViewModel
@inject CL.Web.Infrastruttura.UtenteCorrente Utente
@{
    ViewData["Title"] = Utente.IsDipendente ? "Le mie ferie e permessi" : "Ferie e permessi";
    var gestore = Utente.IsConsulente || Utente.IsAzienda;
    var ritorno = Context.Request.Path + Context.Request.QueryString;
}

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
    @if (gestore)
    {
        <a asp-action="Residui" class="btn btn-outline-secondary"><i class="ri-history-line" aria-hidden="true"></i> Inserisci residui anno precedente</a>
    }
</div>

@if (Model.Saldi is not null)
{
    <div class="mb-4"><partial name="_Saldi" model="Model.Saldi" /></div>
}

@if (Model.DaApprovareTeam is { } team)
{
    <section class="mb-4" aria-labelledby="titoloTeam">
        <h2 class="h5" id="titoloTeam">Da approvare per il tuo team <span class="badge bg-warning text-dark align-middle">@team.Count</span></h2>
        <partial name="_TabellaRichieste" model="(team, true, true, false, Model.Oggi, ritorno)" />
    </section>
    <h2 class="h5">Le mie richieste</h2>
}

<section class="customer-directory">
    <form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
        <div class="invoice-filter-toolbar">
            <div>
                <select name="stato" class="form-select" aria-label="Stato della richiesta">
                    @if (Utente.IsAzienda)
                    {
                        <option value="InAttesa" selected="@(Model.Stato == StatoRichiesta.InAttesa)">Da approvare</option>
                    }
                    else if (Utente.IsConsulente)
                    {
                        <option value="InAttesa" selected="@(Model.Stato == StatoRichiesta.InAttesa)">In attesa dell'azienda</option>
                    }
                    else
                    {
                        <option value="InAttesa" selected="@(Model.Stato == StatoRichiesta.InAttesa)">In attesa</option>
                    }
                    <option value="Approvata" selected="@(Model.Stato == StatoRichiesta.Approvata)">Approvate</option>
                    <option value="Rifiutata" selected="@(Model.Stato == StatoRichiesta.Rifiutata)">Rifiutate</option>
                    <option value="Annullata" selected="@(Model.Stato == StatoRichiesta.Annullata)">Annullate</option>
                    <option value="" selected="@(Model.Stato is null)">Tutte</option>
                </select>
            </div>
            <div>
                <select name="anno" class="form-select" aria-label="Anno">
                    @for (var a = Model.Oggi.Year + 1; a >= Model.Oggi.Year - 3; a--)
                    {
                        <option value="@a" selected="@(a == Model.Anno)">@a</option>
                    }
                </select>
            </div>
            @if (Model.Aziende is not null)
            {
                <div>
                    <select name="aziendaId" class="form-select" aria-label="Filtra per azienda" asp-items="Model.Aziende">
                        <option value="">Tutte le aziende</option>
                    </select>
                </div>
            }
            <input type="hidden" name="tutte" value="true" />
            <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Filtra <i class="ri-filter-3-line" aria-hidden="true"></i></button></div>
        </div>
    </form>

    <partial name="_TabellaRichieste" model="(Model.Richieste, Utente.IsAzienda, gestore, Utente.IsConsulente, Model.Oggi, ritorno)" />
</section>
