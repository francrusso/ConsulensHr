@model CL.Web.Controllers.AssenzeViewModel
@inject CL.Web.Infrastruttura.UtenteCorrente Utente
@{
    ViewData["Title"] = "Richieste";
    var gestore = Utente.IsConsulente || Utente.IsAzienda;
    var ritorno = Context.Request.Path + Context.Request.QueryString;
}

<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="titolo-pagina mb-0">@ViewData["Title"]</h1>
    @* Anno come pulsanti affiancati: un clic e la pagina mostra quell'anno. *@
    <nav class="scelta-anno" aria-label="Anno">
        @foreach (var a in Model.Anni)
        {
            <a class="@(a == Model.Anno ? "attivo" : "")" aria-current="@(a == Model.Anno ? "page" : null)"
               asp-action="Index" asp-route-anno="@a" asp-route-stato="@Model.Stato" asp-route-aziendaId="@Model.AziendaId" asp-route-q="@Model.Ricerca">@a</a>
        }
    </nav>
</div>

@if (Model.Saldi is not null)
{
    <div class="mb-4"><partial name="_Saldi" model="Model.Saldi" /></div>
}

@if (Model.DaApprovareTeam is { } team)
{
    <section class="mb-4" aria-labelledby="titoloTeam">
        <h2 class="h5" id="titoloTeam">Da approvare per il tuo team <span class="badge bg-warning text-dark align-middle">@team.Count</span></h2>
        <partial name="_TabellaRichieste" model="(team, true, true, false, Model.Oggi, ritorno)" />
    </section>
    <h2 class="h5">Le mie richieste</h2>
}

<section class="customer-directory">
    @if (gestore)
    {
        @* Ricerca a tutta larghezza, come nell'elenco del personale (con il filtro azienda per il consulente). *@
        <form asp-action="Index" method="get" class="invoice-filter-bar customer-filter-form">
            <div class="invoice-filter-toolbar">
                <div class="invoice-filter-client">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="ri-search-line" aria-hidden="true"></i></span>
                        <input type="text" name="q" class="form-control" placeholder="Cerca per nome o cognome" aria-label="Cerca nelle richieste" value="@Model.Ricerca" />
                    </div>
                </div>
                @if (Model.Aziende is not null)
                {
                    <div>
                        <select name="aziendaId" class="form-select" aria-label="Filtra per azienda" asp-items="Model.Aziende">
                            <option value="">Tutte le aziende</option>
                        </select>
                    </div>
                }
                <input type="hidden" name="anno" value="@Model.Anno" />
                @if (Model.Stato is { } statoScelto) { <input type="hidden" name="stato" value="@statoScelto" /> }
                <div class="invoice-filter-actions"><button class="btn invoice-filter-submit" type="submit">Cerca <i class="ri-search-line" aria-hidden="true"></i></button></div>
            </div>
        </form>
        <partial name="_ChipRicerca" />
    }

    @{
        var stati = new (StatoRichiesta Stato, string Nome, string Colore)[]
        {
            (StatoRichiesta.InAttesa, Utente.IsConsulente ? "In attesa dell'azienda" : Utente.IsDipendente ? "In attesa" : "Da approvare", "#F2B544"),
            (StatoRichiesta.Approvata, "Approvate", "#2FBA6C"), (StatoRichiesta.Rifiutata, "Rifiutate", "#D9534F"), (StatoRichiesta.Annullata, "Annullate", "#9AA3AE"),
        };
    }
    @* Stati come pillole, come nell'elenco del personale: di default tutte, con quelle da approvare in cima. *@
    <nav class="invoice-filter-categories filtro-stati mb-3" aria-label="Stato della richiesta">
        <a class="badge-filtro-categoria @(Model.Stato is null ? "active" : "")" aria-current="@(Model.Stato is null ? "page" : null)"
           asp-action="Index" asp-route-anno="@Model.Anno" asp-route-aziendaId="@Model.AziendaId" asp-route-q="@Model.Ricerca">Tutte <span>(@Model.Conteggi.Values.Sum())</span></a>
        @foreach (var (st, nome, colore) in stati)
        {
            <a class="badge-filtro-categoria @(Model.Stato == st ? "active" : "")" aria-current="@(Model.Stato == st ? "page" : null)"
               asp-action="Index" asp-route-stato="@st" asp-route-anno="@Model.Anno" asp-route-aziendaId="@Model.AziendaId" asp-route-q="@Model.Ricerca">
                <span class="pallino-stato" style="--colore-stato:@colore" aria-hidden="true"></span> @nome <span>(@Model.Conteggi.GetValueOrDefault(st))</span>
            </a>
        }
    </nav>

    <partial name="_TabellaRichieste" model="(Model.Richieste, Utente.IsAzienda, gestore, Utente.IsConsulente, Model.Oggi, ritorno)" />
</section>
