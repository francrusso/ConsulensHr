@model (List<CL.Web.Controllers.RichiestaRiga> Righe, bool PuoApprovare, bool MostraDipendente, bool MostraAzienda, DateOnly Oggi, string Ritorno)
@inject UtenteCorrente Utente
@{
    @* Approva/rifiuta: solo il referente dell'azienda. Il consulente annulla solo assenze che non richiedono approvazione. *@
    var (righe, gestore, mostraDipendente, mostraAzienda, oggi, ritorno) = Model;
    var colonne = 5 + (mostraDipendente ? 1 : 0) + (mostraAzienda ? 1 : 0);
}
<div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                @if (mostraDipendente) { <th scope="col">Dipendente</th> }
                @if (mostraAzienda) { <th scope="col">Azienda</th> }
                <th scope="col">Tipo</th>
                <th scope="col">Periodo</th>
                <th scope="col" class="text-end">Ore</th>
                <th scope="col">Stato</th>
                <th scope="col" class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @if (righe.Count == 0)
            {
                <tr><td colspan="@colonne" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-calendar-line"></i></span><div>Nessuna richiesta</div></td></tr>
            }
            @foreach (var r in righe)
            {
                var annullabile = !r.SmartWorking && !r.Straordinario && (r.Stato == StatoRichiesta.InAttesa || (r.Stato == StatoRichiesta.Approvata && r.Dal > oggi))
                                  && (!Utente.IsConsulente || !r.Tipo.RichiedeApprovazione());
                // Lo smart working lo ritira solo chi l'ha chiesto, finché il giorno non è passato; lo decide solo l'azienda.
                var ritirabile = r.SmartWorking && Utente.IsDipendente && r.DipendenteId == Utente.DipendenteId && r.Dal >= oggi && r.Stato != StatoRichiesta.Rifiutata;
                var ritiraOre = r.Straordinario && Utente.IsDipendente && r.DipendenteId == Utente.DipendenteId && r.Stato == StatoRichiesta.InAttesa;
                var decidibile = r.Stato == StatoRichiesta.InAttesa && gestore && (!(r.SmartWorking || r.Straordinario) || Utente.IsAzienda);
                var tipoNome = r.SmartWorking ? "Smart working" : r.Straordinario ? "Straordinario" : r.Tipo.Descrizione();
                var azioneDecidi = r.SmartWorking ? "DecidiSmartWorking" : r.Straordinario ? "DecidiStraordinario" : null;
                // Il referente revoca qualunque richiesta attiva, anche approvata e già passata (es. registrata per errore).
                var revocabile = Utente.IsAzienda && r.Stato is StatoRichiesta.InAttesa or StatoRichiesta.Approvata;
                if (revocabile) annullabile = false;
                // Il dipendente annulla da sé solo ciò che è in attesa; per una richiesta approvata chiede la cancellazione all'azienda.
                var mia = Utente.IsDipendente && r.DipendenteId == Utente.DipendenteId;
                if (mia && r.Stato == StatoRichiesta.Approvata) annullabile = false;
                var chiediCancellazione = mia && !r.SmartWorking && !r.Straordinario && r.Stato == StatoRichiesta.Approvata && !r.AnnullamentoInAttesa;
                var decidiCancellazione = r.AnnullamentoInAttesa && gestore;
                var genere = r.SmartWorking ? "smart" : r.Straordinario ? "straordinario" : "assenza";
                var periodo = r.Dal == r.Al ? r.Dal.ToString("dddd d MMMM yyyy") : $"dal {r.Dal:dddd d MMMM} al {r.Al:dddd d MMMM yyyy}";
                <tr class="customer-result-row">
                    @if (mostraDipendente)
                    {
                        @if (Utente.IsDipendente)
                        {
                            <td data-label="Dipendente"><span class="customer-name"><i class="ri-user-line" aria-hidden="true"></i><span>@r.Dipendente</span></span></td>
                        }
                        else
                        {
                            <td data-label="Dipendente"><a class="customer-name" asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@r.DipendenteId"><i class="ri-user-line" aria-hidden="true"></i><span>@r.Dipendente</span></a></td>
                        }
                    }
                    @if (mostraAzienda) { <td data-label="Azienda">@r.Azienda</td> }
                    <td data-label="Tipo">
                        @if (r.SmartWorking) { <i class="ri-home-wifi-line text-body-secondary" aria-hidden="true"></i> }
                        @if (r.Straordinario) { <i class="ri-timer-flash-line text-body-secondary" aria-hidden="true"></i> }
                        @tipoNome
                        @if (!string.IsNullOrWhiteSpace(r.Note)) { <i class="ri-chat-3-line text-body-secondary" title="@r.Note" aria-label="Note: @r.Note"></i> }
                    </td>
                    <td data-label="Periodo">
                        @if (r.Dal == r.Al) { @r.Dal.ToString("ddd dd/MM/yyyy") }
                        else { @($"{r.Dal:dd/MM} – {r.Al:dd/MM/yyyy}") }
                    </td>
                    <td data-label="Ore" class="text-end">@(r.SmartWorking ? "—" : r.Ore.ToString("0.##"))</td>
                    <td data-label="Stato">
                        <partial name="~/Views/Assenze/_StatoRichiesta.cshtml" model="r.Stato" />
                        @if (r.AnnullamentoInAttesa)
                        {
                            <span class="badge bg-warning text-dark ms-1" title="@r.MotivoAnnullamento">Cancellazione chiesta</span>
                            @if (r.MotivoAnnullamento is not null) { <div class="small text-body-secondary">@r.MotivoAnnullamento</div> }
                        }
                        @if (r.Stato == StatoRichiesta.Rifiutata && r.MotivoRifiuto is not null)
                        {
                            <div class="small text-body-secondary">@r.MotivoRifiuto</div>
                        }
                    </td>
                    <td data-label="Azioni">
                        <div class="customer-actions">
                            <button type="button" title="Dettaglio" aria-label="Dettaglio della richiesta" data-bs-toggle="modal" data-bs-target="#modaleDettaglioRichiesta"
                                    data-persona="@r.Dipendente" data-tipo="@tipoNome" data-periodo="@periodo"
                                    data-ore="@(r.SmartWorking ? "—" : r.Ore.ToString("0.##") + " h")" data-stato="@r.Stato.ToString()"
                                    data-richiesta="@r.RichiestaIl.ToLocalTime().ToString("dd/MM/yyyy 'alle' HH:mm")" data-decisa="@(r.DecisaDa ?? "—")"
                                    data-note="@(r.Note ?? "—")" data-motivo="@(r.MotivoRifiuto ?? "")"><i class="ri-eye-line" aria-hidden="true"></i></button>
                            @if (decidibile)
                            {
                                <form asp-controller="Assenze" asp-action="@(azioneDecidi ?? "Approva")" asp-route-id="@r.Id" asp-route-approva="@(azioneDecidi is null ? null : "true")" method="post" class="d-inline">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" class="btn btn-sm btn-primary" title="Approva">Approva</button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modaleRifiuto"
                                        data-azione="@(azioneDecidi is not null ? Url.Action(azioneDecidi, "Assenze", new { id = r.Id, approva = false }) : Url.Action("Rifiuta", "Assenze", new { id = r.Id }))" data-descrizione="@tipoNome di @r.Dipendente">Rifiuta</button>
                            }
                            @if (ritiraOre)
                            {
                                <form asp-controller="Assenze" asp-action="RitiraStraordinario" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Ritirare questa richiesta di straordinario?');">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" aria-label="Ritira richiesta" title="Ritira richiesta"><i class="ri-close-circle-line" aria-hidden="true"></i></button>
                                </form>
                            }
                            @if (ritirabile)
                            {
                                <form asp-controller="Ufficio" asp-action="Richiedi" method="post" class="d-inline" onsubmit="return confirm('Ritirare questa richiesta di smart working?');">
                                    <input type="hidden" name="giorno" value="@r.Dal.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" aria-label="Ritira richiesta" title="Ritira richiesta"><i class="ri-close-circle-line" aria-hidden="true"></i></button>
                                </form>
                            }
                            @if (decidiCancellazione)
                            {
                                <form asp-controller="Assenze" asp-action="DecidiAnnullamento" asp-route-id="@r.Id" asp-route-conferma="true" method="post" class="d-inline">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" class="btn btn-sm btn-primary">Conferma cancellazione</button>
                                </form>
                                <form asp-controller="Assenze" asp-action="DecidiAnnullamento" asp-route-id="@r.Id" asp-route-conferma="false" method="post" class="d-inline">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Respingi</button>
                                </form>
                            }
                            @if (chiediCancellazione)
                            {
                                <form asp-controller="Assenze" asp-action="ChiediAnnullamento" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="const m = prompt('Perché vuoi cancellarla? (facoltativo)'); if (m === null) return false; this.motivo.value = m; return true;">
                                    <input type="hidden" name="motivo" /><input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" aria-label="Chiedi la cancellazione" title="Chiedi la cancellazione"><i class="ri-close-circle-line" aria-hidden="true"></i></button>
                                </form>
                            }
                            @if (revocabile && !decidiCancellazione)
                            {
                                <form asp-controller="Assenze" asp-action="Revoca" asp-route-id="@r.Id" asp-route-genere="@genere" method="post" class="d-inline"
                                      onsubmit="return confirm('Revocare questa richiesta? Non conterà più (saldi, calendario, riepilogo presenze).');">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" aria-label="Revoca richiesta" title="Revoca richiesta"><i class="ri-arrow-go-back-line" aria-hidden="true"></i></button>
                                </form>
                            }
                            @if (annullabile)
                            {
                                <form asp-controller="Assenze" asp-action="Annulla" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Annullare questa richiesta?');">
                                    <input type="hidden" name="ritorno" value="@ritorno" />
                                    <button type="submit" aria-label="Annulla richiesta" title="Annulla richiesta"><i class="ri-close-circle-line" aria-hidden="true"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (gestore)
{
    <div class="modal fade" id="modaleRifiuto" tabindex="-1" aria-labelledby="modaleRifiutoTitolo" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" class="modal-content radius-15" id="formRifiuto">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ritorno" value="@ritorno" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="modaleRifiutoTitolo">Rifiuta richiesta</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2" id="descrizioneRifiuto"></p>
                    <label for="motivo" class="form-label">Motivo (visibile al dipendente)</label>
                    <textarea id="motivo" name="motivo" class="form-control" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-danger">Rifiuta</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('modaleRifiuto').addEventListener('show.bs.modal', function (e) {
            document.getElementById('formRifiuto').action = e.relatedTarget.dataset.azione;
            document.getElementById('descrizioneRifiuto').textContent = e.relatedTarget.dataset.descrizione;
            document.getElementById('motivo').value = '';
        });
    </script>
}

@if (ViewData["ModaleDettaglioRichiesta"] is not true)
{
    ViewData["ModaleDettaglioRichiesta"] = true;
    <div class="modal fade" id="modaleDettaglioRichiesta" tabindex="-1" aria-labelledby="titoloDettaglioRichiesta" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content radius-15">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="titoloDettaglioRichiesta">Dettaglio richiesta</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body">
                    <dl class="dettaglio-richiesta mb-0">
                        <dt>Persona</dt><dd data-campo="persona"></dd>
                        <dt>Tipo</dt><dd data-campo="tipo"></dd>
                        <dt>Periodo</dt><dd data-campo="periodo"></dd>
                        <dt>Ore</dt><dd data-campo="ore"></dd>
                        <dt>Stato</dt><dd data-campo="stato"></dd>
                        <dt>Richiesta il</dt><dd data-campo="richiesta"></dd>
                        <dt>Decisa da</dt><dd data-campo="decisa"></dd>
                        <dt>Note</dt><dd data-campo="note"></dd>
                        <dt data-se="motivo">Motivo del rifiuto</dt><dd data-campo="motivo" data-se="motivo"></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.getElementById('modaleDettaglioRichiesta').addEventListener('show.bs.modal', function (e) {
            const d = e.relatedTarget.dataset;
            const stati = { InAttesa: 'In attesa', Approvata: 'Approvata', Rifiutata: 'Rifiutata', Annullata: 'Annullata' };
            this.querySelectorAll('[data-campo]').forEach(el => el.textContent = el.dataset.campo === 'stato' ? (stati[d.stato] || d.stato) : (d[el.dataset.campo] || ''));
            this.querySelectorAll('[data-se="motivo"]').forEach(el => el.hidden = !d.motivo);
        });
    </script>
}
