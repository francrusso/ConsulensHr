@model IReadOnlyList<SaldoAssenza>
@* Card dei saldi ferie e ROL (ore). *@
<div class="row g-3">
    @foreach (var s in Model)
    {
        <div class="col-md-6">
            <section class="card radius-15 h-100 saldo-card">
                <div class="card-body">
                    @{
                        // Stessi colori del grafico delle assenze nella panoramica.
                        var (icona, colore) = s.Tipo switch
                        {
                            TipoAssenza.Ferie => ("ri-sun-line", "#6096FF"),
                            TipoAssenza.Rol => ("ri-time-line", "#2FBA6C"),
                            _ => ("ri-calendar-event-line", "#E8A33D"),
                        };
                    }
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="saldo-icona" style="--colore-saldo:@colore" aria-hidden="true"><i class="@icona"></i></span>
                            <h3 class="saldo-titolo mb-0">@s.Tipo.Descrizione()</h3>
                        </div>
                        <span class="saldo-anno">@s.Anno</span>
                    </div>
                    <div class="card-numero @(s.Disponibile < 0 ? "text-danger" : "")">@s.Disponibile.ToString("0.##") <small class="fs-6 fw-normal">ore disponibili</small></div>
                    <dl class="saldo-dettaglio mt-3 mb-0">
                        <div><dt>Residuo anno precedente</dt><dd>@s.ResiduoPrecedente.ToString("0.##")</dd></div>
                        <div><dt>Maturato</dt><dd>@(s.Maturato > 0 ? "+" : "")@s.Maturato.ToString("0.##")</dd></div>
                        <div><dt>Goduto</dt><dd>@(s.Goduto > 0 ? "−" : "")@s.Goduto.ToString("0.##")</dd></div>
                        @if (s.Prenotato > 0)
                        {
                            <div><dt>In attesa di approvazione</dt><dd>−@s.Prenotato.ToString("0.##")</dd></div>
                        }
                    </dl>
                </div>
            </section>
        </div>
    }
</div>
