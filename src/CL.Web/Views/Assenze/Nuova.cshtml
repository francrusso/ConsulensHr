@model CL.Web.Controllers.RichiestaForm
@{
    var gestore = (bool)ViewBag.Gestore;
    ViewData["Title"] = "Nuova richiesta"; // stesso modulo per dipendente, azienda e consulente
    var dipendenti = ViewBag.Dipendenti as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var saldi = ViewBag.Saldi as IReadOnlyList<SaldoAssenza>;
    // Per il dipendente, oltre alle assenze: smart working (se lavora in presenza) o giorni in ufficio (se lavora a distanza).
    var lavoro = ViewBag.Lavoro as string;
    var tipi = CL.Web.Controllers.RichiestaForm.Tipi.Select(t => { t.Selected = lavoro is null && t.Value == Model.Tipo.ToString(); return t; }).ToList();
    // Per tutti, oltre alle assenze: giorni di smart working (da approvare) e di presenza in ufficio.
    tipi.Insert(0, new SelectListItem("Presenza in ufficio", CL.Web.Controllers.AssenzeController.SceltaUfficio, lavoro == CL.Web.Controllers.AssenzeController.SceltaUfficio));
    tipi.Insert(0, new SelectListItem("Smart working", CL.Web.Controllers.AssenzeController.SceltaSmartWorking, lavoro == CL.Web.Controllers.AssenzeController.SceltaSmartWorking));
}

<h1 class="titolo-pagina mb-3">@ViewData["Title"]</h1>

@if (saldi is not null)
{
    <div class="alert alert-secondary radius-15 d-flex flex-wrap gap-4" role="note">
        @foreach (var s in saldi)
        {
            <span><strong>@s.Tipo.Descrizione()</strong>: @s.Disponibile.ToString("0.##") ore disponibili a fine anno</span>
        }
    </div>
}

<div class="card radius-15 p-4">
    <form asp-action="Nuova" method="post" class="row g-3" novalidate id="formRichiesta">
        @if (ViewBag.Ritorno is string ritorno) { <input type="hidden" name="ritorno" value="@ritorno" /> }
        <div asp-validation-summary="All" class="alert alert-danger radius-15" role="alert"></div>

        @if (dipendenti is not null)
        {
            <div class="col-md-6">
                <label asp-for="DipendenteId" class="form-label"></label>
                <select asp-for="DipendenteId" class="form-select" aria-required="true">
                    <option value="">Seleziona…</option>
                    @foreach (var d in dipendenti)
                    {
                        <option value="@d.Value" selected="@d.Selected">@d.Text</option>
                    }
                </select>
            </div>
        }
        <div class="col-md-6">
            <label asp-for="Tipo" class="form-label"></label>
            <select name="Tipo" id="Tipo" class="form-select">
                <optgroup label="Presenze">
                    @foreach (var t in tipi.Take(2)) { <option value="@t.Value" selected="@t.Selected">@t.Text</option> }
                </optgroup>
                <optgroup label="Assenze">
                    @foreach (var t in tipi.Skip(2)) { <option value="@t.Value" selected="@t.Selected">@t.Text</option> }
                </optgroup>
            </select>
        </div>

        <div class="col-12" id="campoAOre">
            <div class="form-check form-switch">
                <input asp-for="AOre" class="form-check-input" role="switch" />
                <label asp-for="AOre" class="form-check-label"></label>
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="Dal" class="form-label" id="etichettaDal">Dal</label>
            <input asp-for="Dal" type="date" class="form-control" aria-required="true" />
        </div>
        <div class="col-md-4" id="campoAl">
            <label asp-for="Al" class="form-label"></label>
            <input asp-for="Al" type="date" class="form-control" />
            <div class="form-text">Vuoto = un solo giorno. Sabati, domeniche e festivi non vengono conteggiati.</div>
        </div>
        <div class="col-md-4" id="campoOre">
            <label asp-for="Ore" class="form-label"></label>
            <input asp-for="Ore" type="text" inputmode="decimal" class="form-control" placeholder="es. 2 oppure 1,5" />
        </div>

        <div class="col-md-6" id="campoProtocollo">
            <label asp-for="ProtocolloCertificato" class="form-label"></label>
            <input asp-for="ProtocolloCertificato" class="form-control" maxlength="50" placeholder="es. 123456789" />
            <span asp-validation-for="ProtocolloCertificato" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
        </div>

        @if (ViewBag.PuoApprovare == true)
        {
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="ApprovaSubito" class="form-check-input" />
                    <label asp-for="ApprovaSubito" class="form-check-label"></label>
                    <div class="form-text">Togli la spunta per lasciarla in attesa di approvazione.</div>
                </div>
            </div>
        }
        else if (gestore)
        {
            <div class="col-12">
                <p class="form-text mb-0"><i class="ri-information-line" aria-hidden="true"></i> Ferie, ROL e permessi registrati dal consulente restano <strong>in attesa dell'approvazione dell'azienda</strong>; malattia e altre assenze documentate sono registrate subito.</p>
            </div>
        }

        <div class="col-12 d-flex justify-content-end gap-2 mt-3">
            <a href="@(ViewBag.Ritorno as string ?? Url.Action("Index"))" class="btn btn-outline-secondary">Annulla</a>
            <button type="submit" class="btn btn-primary">@(gestore ? "Salva richiesta" : "Invia richiesta")</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const aOre = document.getElementById('AOre');
            const tipo = document.getElementById('Tipo');
            const aggiorna = () => {
                document.getElementById('campoAl').hidden = aOre.checked;
                document.getElementById('campoOre').hidden = !aOre.checked;
                document.getElementById('etichettaDal').textContent = aOre.checked ? 'Giorno' : 'Dal';
                // Smart working e giorni in ufficio: solo le date, niente ore né protocollo.
                const giorni = tipo.value === 'SmartWorking' || tipo.value === 'InUfficio';
                document.getElementById('campoAOre').hidden = giorni;
                if (giorni && aOre.checked) { aOre.checked = false; }
                document.getElementById('campoAl').hidden = aOre.checked;
                document.getElementById('campoOre').hidden = !aOre.checked;
                const malattia = tipo.value === 'Malattia';
                document.getElementById('campoProtocollo').hidden = !malattia;
                document.getElementById('ProtocolloCertificato').required = malattia; // obbligatorio per la malattia
            };
            aOre.addEventListener('change', aggiorna);
            tipo.addEventListener('change', aggiorna);
            aggiorna();
        })();
    </script>
}
