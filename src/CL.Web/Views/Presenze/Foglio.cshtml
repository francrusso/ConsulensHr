@model FoglioPresenze
@inject UtenteCorrente Utente
@{
    ViewData["Title"] = "Riepilogo presenze";
    var c = Model.Comunicazione;
    var modificabile = Utente.IsAzienda && Model.Stato == StatoComunicazione.Bozza;
    string N(decimal v) => v == 0 ? "" : v.ToString("0.##");
    string O(decimal v) => v == 0 ? "—" : v.ToString("0.##");
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="titolo-pagina mb-0">Riepilogo presenze</h1>
        <p class="text-body-secondary mb-0">@Model.Azienda.RagioneSociale · @Model.Periodo · <partial name="_StatoComunicazione" model="(StatoComunicazione?)c?.Stato" /></p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <partial name="_Periodo" model='(Model.Anno, Model.Mese, Utente.IsConsulente ? Model.Azienda.Id : (Guid?)null, "Foglio")' />
        <a asp-action="Esporta" asp-route-aziendaId="@(Utente.IsConsulente ? Model.Azienda.Id : null)" asp-route-anno="@Model.Anno" asp-route-mese="@Model.Mese" class="btn btn-outline-primary text-nowrap"><i class="ri-file-excel-2-line" aria-hidden="true"></i> Esporta riepilogo</a>
    </div>
</div>

@if (c?.Stato == StatoComunicazione.Inviata || c?.Stato == StatoComunicazione.Elaborata)
{
    <div class="alert alert-info radius-15">
        Inviata al consulente il @c.InviataIl!.Value.ToLocalTime().ToString("dd/MM/yyyy 'alle' HH:mm") da @c.InviataDa.
        @if (c.Stato == StatoComunicazione.Elaborata) { <span>Paghe elaborate il @c.ElaborataIl!.Value.ToLocalTime().ToString("dd/MM/yyyy").</span> }
        @if (Utente.IsAzienda) { <span>Per correggere qualcosa chiedi al consulente di riaprirla.</span> }
    </div>
}

@if (Utente.IsConsulente)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (c is null || c.Stato == StatoComunicazione.Bozza)
        {
            <form asp-action="Sollecita" method="post" class="m-0">
                <input type="hidden" name="aziendaId" value="@Model.Azienda.Id" /><input type="hidden" name="anno" value="@Model.Anno" /><input type="hidden" name="mese" value="@Model.Mese" />
                <button type="submit" class="btn btn-outline-secondary"><i class="ri-notification-3-line" aria-hidden="true"></i> Invia promemoria all'azienda</button>
            </form>
        }
        else
        {
            @if (c.Stato == StatoComunicazione.Inviata)
            {
                <form asp-action="Elabora" method="post" class="m-0">
                    <input type="hidden" name="aziendaId" value="@Model.Azienda.Id" /><input type="hidden" name="anno" value="@Model.Anno" /><input type="hidden" name="mese" value="@Model.Mese" />
                    <button type="submit" class="btn btn-primary"><i class="ri-check-double-line" aria-hidden="true"></i> Segna come elaborata</button>
                </form>
            }
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#riapri" aria-expanded="false" aria-controls="riapri"><i class="ri-arrow-go-back-line" aria-hidden="true"></i> Riapri per correzioni</button>
        }
    </div>
    <div class="collapse mb-3" id="riapri">
        <form asp-action="Riapri" method="post" class="card radius-15 p-3">
            <input type="hidden" name="aziendaId" value="@Model.Azienda.Id" /><input type="hidden" name="anno" value="@Model.Anno" /><input type="hidden" name="mese" value="@Model.Mese" />
            <label for="motivo" class="form-label">Cosa deve correggere l'azienda (lo riceve per email)</label>
            <textarea id="motivo" name="motivo" class="form-control mb-2" rows="2" maxlength="1000"></textarea>
            <div><button type="submit" class="btn btn-danger">Riapri e avvisa l'azienda</button></div>
        </form>
    </div>
}

<form asp-action="Salva" method="post">
    <input type="hidden" name="anno" value="@Model.Anno" />
    <input type="hidden" name="mese" value="@Model.Mese" />
    @if (Model.Righe.Count == 0)
    {
        <div class="card radius-15 p-4 elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-calendar-check-line"></i></span><div>Nessun dipendente in forza nel mese</div></div>
    }
    @* Una card per persona: giorni del mese e assenze dal portale (già compilati), variazioni da indicare. *@
    <div class="card-presenze">
    @for (var i = 0; i < Model.Righe.Count; i++)
    {
        var r = Model.Righe[i];
        var (a, v) = (r.Assenze, r.Voci);
        // Buoni pasto proposti: i giorni in ufficio del mese, finché non se ne indica un numero diverso.
        var buoni = v.BuoniPasto == 0 && modificabile ? r.InUfficio : v.BuoniPasto;
        // Straordinari approvati nel portale: precompilano le ore finché non se ne indicano di diverse.
        var straord = v.OreStraordinario == 0 && modificabile ? r.StraordinarioApprovato : v.OreStraordinario;
        var straordFest = v.OreStraordinarioFestivo == 0 && modificabile ? r.StraordinarioFestivoApprovato : v.OreStraordinarioFestivo;
        <section class="card radius-15 p-3 p-md-4 card-presenza" aria-labelledby="persona-@i">
            <input type="hidden" name="righe[@i].DipendenteId" value="@r.DipendenteId" />
            <header class="intestazione-presenza">
                <img class="avatar-presenza" src="@(r.HaFoto ? Url.Action("Foto", "Dipendenti", new { id = r.DipendenteId }) : Url.Content($"~/assets/images/avatar/{r.Segnaposto}.png"))" alt="" loading="lazy" />
                <div class="flex-grow-1 min-w-0">
                    <h2 class="nome-presenza mb-0" id="persona-@i"><a asp-controller="Dipendenti" asp-action="Dettaglio" asp-route-id="@r.DipendenteId" asp-route-sezione="ferie">@r.Nome</a></h2>
                    <div class="dettaglio-presenza">@string.Join(" · ", new[] { r.Mansione, r.Matricola is null ? null : "matr. " + r.Matricola, r.CodiceFiscale }.Where(x => !string.IsNullOrEmpty(x)))</div>
                </div>
                <div class="giorni-presenza">
                    <span class="chip-giorni"><i class="ri-calendar-check-line" aria-hidden="true"></i> @r.GiorniLavorati lavorati</span>
                    <span class="chip-giorni ufficio"><i class="ri-building-line" aria-hidden="true"></i> @r.InUfficio in ufficio</span>
                    <span class="chip-giorni remoto"><i class="ri-home-wifi-line" aria-hidden="true"></i> @r.Remoto da remoto</span>
                </div>
            </header>

            <div class="sottotitolo-presenza">Assenze dal portale</div>
            <div class="assenze-presenza">
                @foreach (var (nome, ore, colore) in new[] { ("Ferie", a.Ferie, "#6096FF"), ("ROL e permessi", a.Rol, "#8E6BD8"), ("Malattia", a.Malattia, "#F08A4B"), ("Altre", a.Altre, "#9AA3AE") })
                {
                    <div class="tessera-assenza @(ore == 0 ? "vuota" : "")" style="--colore-cat:@colore"><span>@nome</span><strong>@O(ore)@(ore == 0 ? "" : " h")</strong></div>
                }
            </div>

            <div class="sottotitolo-presenza">Variazioni del mese</div>
            <div class="campi-presenza">
                @foreach (var (campo, etichetta, valore, tipo) in new (string, string, string, string)[]
                {
                    ("OreStraordinario", "Straordinario (h)", N(straord), "decimal"),
                    ("OreStraordinarioFestivo", "Straord. festivo (h)", N(straordFest), "decimal"),
                    ("OreNonRetribuite", "Non retribuite (h)", N(v.OreNonRetribuite), "decimal"),
                    ("BuoniPasto", "Buoni pasto", buoni == 0 ? "" : buoni.ToString(), "numero"),
                    ("Premi", "Premi (€)", N(v.Premi), "decimal"),
                    ("Rimborsi", "Rimborsi (€)", N(v.Rimborsi), "decimal"),
                    ("Anticipi", "Anticipi (€)", N(v.Anticipi), "decimal"),
                })
                {
                    <div>
                        <label class="form-label" for="r@(i)-@campo">@etichetta</label>
                        @if (modificabile)
                        {
                            if (tipo == "numero")
                            {
                                <input class="form-control" id="r@(i)-@campo" name="righe[@i].@campo" value="@valore" type="number" min="0" max="31" placeholder="0" />
                            }
                            else
                            {
                                <input class="form-control" id="r@(i)-@campo" name="righe[@i].@campo" value="@valore" inputmode="decimal" placeholder="0" />
                            }
                        }
                        else { <div class="valore-presenza" id="r@(i)-@campo">@(string.IsNullOrEmpty(valore) ? "—" : valore)</div> }
                        @if (campo == "OreStraordinario" && r.StraordinarioApprovato > 0) { <div class="nota-campo"><i class="ri-checkbox-circle-line" aria-hidden="true"></i> @N(r.StraordinarioApprovato) h approvate nel portale</div> }
                        @if (campo == "OreStraordinarioFestivo" && r.StraordinarioFestivoApprovato > 0) { <div class="nota-campo"><i class="ri-checkbox-circle-line" aria-hidden="true"></i> @N(r.StraordinarioFestivoApprovato) h approvate nel portale</div> }
                        @if (campo == "BuoniPasto" && modificabile) { <div class="nota-campo">proposti: giorni in ufficio</div> }
                    </div>
                }
                <div class="campo-note">
                    <label class="form-label" for="r@(i)-Note">Note</label>
                    @if (modificabile) { <input class="form-control" id="r@(i)-Note" name="righe[@i].Note" value="@v.Note" maxlength="500" placeholder="es. cambio d'orario dal 15" /> }
                    else { <div class="valore-presenza" id="r@(i)-Note">@(v.Note ?? "—")</div> }
                </div>
            </div>
        </section>
    }
    </div>

    <div class="card radius-15 p-3 p-md-4 mt-3">
        <label for="note" class="form-label sottotitolo-presenza">Note per il consulente</label>
        @if (modificabile)
        {
            <textarea id="note" name="note" class="form-control" rows="2" maxlength="2000" placeholder="Assunzioni o cessazioni in arrivo, variazioni d'orario, comunicazioni particolari…">@c?.Note</textarea>
        }
        else { <p id="note" class="mb-0">@(c?.Note ?? "—")</p> }
    </div>

    @if (modificabile)
    {
        <div class="barra-invio d-flex flex-wrap justify-content-end gap-2 mt-3">
            <button type="submit" name="invia" value="false" class="btn btn-outline-secondary"><i class="ri-save-line" aria-hidden="true"></i> Salva bozza</button>
            <button type="submit" name="invia" value="true" class="btn btn-primary" onclick="return confirm('Inviare al consulente le presenze di @Model.Periodo.ToLower()? Dopo l\'invio non potrai più modificarle.');"><i class="ri-send-plane-line" aria-hidden="true"></i> Invia al consulente</button>
        </div>
    }
</form>
