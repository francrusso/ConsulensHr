@model CL.Web.Controllers.CruscottoPresenzeViewModel
@{
    var periodo = $"{ServizioBustePaga.NomeMese(Model.Mese)} {Model.Anno}";
    ViewData["Title"] = "Presenze";
    var inviate = Model.Aziende.Count(a => a.Stato is StatoComunicazione.Inviata or StatoComunicazione.Elaborata);
}
<div class="breadcrumb-titolo d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="titolo-pagina mb-0">Presenze di @periodo.ToLower()</h1>
        <p class="text-body-secondary mb-0">Ricevute da @inviate aziende su @Model.Aziende.Count.</p>
    </div>
    <partial name="_Periodo" model='(Model.Anno, Model.Mese, (Guid?)null, "Index")' />
</div>

<div class="card radius-15 table-responsive table-actions-responsive p-1 customer-results">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th scope="col">Azienda</th>
                <th scope="col" class="text-end">Dipendenti in forza</th>
                <th scope="col">Stato</th>
                <th scope="col">Inviata il</th>
                <th scope="col" class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Aziende.Count == 0)
            {
                <tr><td colspan="5" class="elenco-vuoto"><span class="elenco-vuoto-icona" aria-hidden="true"><i class="ri-building-line"></i></span><div>Nessuna azienda attiva</div></td></tr>
            }
            @foreach (var a in Model.Aziende)
            {
                <tr class="customer-result-row">
                    <td data-label="Azienda"><a class="customer-name" asp-action="Foglio" asp-route-aziendaId="@a.AziendaId" asp-route-anno="@Model.Anno" asp-route-mese="@Model.Mese"><i class="ri-building-line" aria-hidden="true"></i><span>@a.RagioneSociale</span></a></td>
                    <td data-label="Dipendenti" class="text-end">@a.Dipendenti</td>
                    <td data-label="Stato"><partial name="_StatoComunicazione" model="a.Stato" /></td>
                    <td data-label="Inviata il">@(a.InviataIl?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                    <td data-label="Azioni">
                        <div class="customer-actions">
                            <a asp-action="Foglio" asp-route-aziendaId="@a.AziendaId" asp-route-anno="@Model.Anno" asp-route-mese="@Model.Mese" title="Apri il foglio" aria-label="Apri le presenze di @a.RagioneSociale"><i class="ri-eye-line" aria-hidden="true"></i></a>
                            @if (a.Stato is StatoComunicazione.Inviata or StatoComunicazione.Elaborata)
                            {
                                <a asp-action="Esporta" asp-route-aziendaId="@a.AziendaId" asp-route-anno="@Model.Anno" asp-route-mese="@Model.Mese" title="Scarica CSV" aria-label="Scarica il CSV di @a.RagioneSociale"><i class="ri-file-excel-2-line" aria-hidden="true"></i></a>
                            }
                            else
                            {
                                <form asp-action="Sollecita" method="post">
                                    <input type="hidden" name="aziendaId" value="@a.AziendaId" /><input type="hidden" name="anno" value="@Model.Anno" /><input type="hidden" name="mese" value="@Model.Mese" />
                                    <button type="submit" title="Invia promemoria" aria-label="Invia un promemoria a @a.RagioneSociale"><i class="ri-notification-3-line" aria-hidden="true"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
